# Configuración de proxy CORS para descarga de fuentes restringidas en cliente web
# Por defecto deshabilitado (false)
PUBLIC_CORS_PROXY_ENABLED=false

# Conexión a Servidor Backend y MCP (Model Context Protocol) para consultas remotas DuckDB/Parquet
PUBLIC_DATAMESH_MCP_URL=http://localhost:8000/mcp
PUBLIC_DATAMESH_BACKEND_URL=http://localhost:8000
