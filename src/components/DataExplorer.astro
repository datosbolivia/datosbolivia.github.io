---
import { type DataResource, toCanonicalTriad } from '../lib/catalog';
import SchemaTable from './SchemaTable.astro';

interface Props {
  datasetSlug: string;
  resource: DataResource;
  resourceIndex: number;
}

const { datasetSlug, resource, resourceIndex } = Astro.props;

const triadName = toCanonicalTriad({ dataset: datasetSlug, resource: resource.name });
const remoteUrl = resource.path || '';
const format = (resource.format || 'csv').toLowerCase();
const explorerId = `explorer-${datasetSlug}-${resourceIndex}`;

const defaultClientSql = `SELECT * FROM "${triadName}" LIMIT 25;`;
const pythonSnippet = `import datamesh as dm\n\n# Consulta unificada en 1 línea con DuckDB\nres = dm.sql("""\nSELECT *\nFROM '${triadName}'\nLIMIT 25\n""")\nprint(res)`;
const cliSnippet = `datamesh sql "SELECT * FROM '${triadName}' LIMIT 25"`;
const tsSnippet = `import { datamesh } from '@datosbolivia/datamesh-client';\n\n// Breve filtro\nconst res = await datamesh.query({\n  resource_uri: '${triadName}',\n  limit: 25\n});\nconsole.log(res);`;
---

<div class="data-explorer-wrapper" id={explorerId} data-explorer-container data-dataset={datasetSlug} data-remote-url={remoteUrl} data-format={format} data-triad={triadName}>
  <!-- Subnavegación de Vistas del Recurso -->
  <div class="resource-subnav" role="tablist">
    <button 
      type="button" 
      class="subnav-tab-btn active" 
      data-subtab-target="schema"
      role="tab"
      aria-selected="true"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2"></rect>
        <line x1="3" y1="9" x2="21" y2="9"></line>
        <line x1="9" y1="21" x2="9" y2="9"></line>
      </svg>
      <span data-i18n="explorer.tab_schema">Esquema</span>
    </button>

    <button 
      type="button" 
      class="subnav-tab-btn" 
      data-subtab-target="preview"
      role="tab"
      aria-selected="false"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
      <span data-i18n="explorer.tab_preview">Explorar Datos</span>
    </button>

    <button 
      type="button" 
      class="subnav-tab-btn" 
      data-subtab-target="sql"
      role="tab"
      aria-selected="false"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <polyline points="4 17 10 11 4 5"></polyline>
        <line x1="12" y1="19" x2="20" y2="19"></line>
      </svg>
      <span data-i18n="explorer.tab_sql">Consulta SQL / CLI</span>
    </button>
  </div>

  <!-- Vista 1: Esquema de Columnas (Por Defecto) -->
  <div class="subtab-pane active" data-subtab-pane="schema">
    <SchemaTable resource={resource} />
  </div>

  <!-- Vista 2: Explorador Interactivo en Cliente (TypeScript SDK) -->
  <div class="subtab-pane" data-subtab-pane="preview">
    <!-- Toolbar de Operaciones Client-Side -->
    <div class="explorer-toolbar">
      <div class="explorer-search-box">
        <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          type="text" 
          class="explorer-filter-input" 
          placeholder="Filtrar registros en tiempo real..." 
          data-i18n-placeholder="explorer.search_placeholder" 
        />
        <button type="button" class="explorer-clear-filter-btn" title="Limpiar filtro" style="display: none;">&times;</button>
      </div>

      <select class="explorer-filter-col" title="Filtrar por columna específica">
        <option value="">Todas las columnas</option>
      </select>

      <div class="explorer-toolbar-actions">
        <!-- Selector de modo de vista: Tabla, Mapa, Gráfico -->
        <div class="explorer-view-modes" role="group" aria-label="Modo de Visualización">
          <button type="button" class="view-mode-btn active" data-view-mode="table" title="Vista Tabla de Datos">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="21"></line></svg>
            <span>Tabla</span>
          </button>
          <button type="button" class="view-mode-btn" data-view-mode="map" title="Vista Mapa Geoespacial con Leaflet">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>
            <span>Mapa</span>
          </button>
          <button type="button" class="view-mode-btn" data-view-mode="chart" title="Vista Gráfico Analítico">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
            <span>Gráfico</span>
          </button>
        </div>

        <!-- Botón Toggle Consola SQL DuckDB -->
        <button type="button" class="btn btn-secondary btn-sm toggle-sql-btn" title="Mostrar u ocultar consola SQL DuckDB">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
          <span>SQL</span>
        </button>

        <!-- Botón Configuración Global SDK (Modal) -->
        <button type="button" class="btn btn-secondary btn-sm open-sdk-settings-btn" title="Configuración global del SDK (Proxy CORS, Backend MCP, DuckDB)">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
          <span data-i18n="footer.settings">Configuración</span>
        </button>

        <select class="explorer-page-size" title="Registros por página">
          <option value="10">10 / pág</option>
          <option value="25" selected>25 / pág</option>
          <option value="50">50 / pág</option>
          <option value="100">100 / pág</option>
        </select>

        <button type="button" class="btn btn-secondary btn-sm export-btn" title="Exportar filas visibles como CSV">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span data-i18n="explorer.export_csv">Exportar</span>
        </button>
      </div>
    </div>

    <!-- Consola Rápida SQL Client-Side / Backend MCP -->
    <div class="client-sql-bar" style="display: none;">
      <div style="display: flex; gap: 0.5rem; width: 100%;">
        <input 
          type="text" 
          class="client-sql-input" 
          value={defaultClientSql} 
          placeholder="Ej: SELECT * FROM resource WHERE columna = 'valor' LIMIT 20"
        />
        <button type="button" class="btn btn-primary btn-sm client-sql-run-btn">
          Ejecutar
        </button>
      </div>
    </div>

    <!-- Contenedor de la Tabla de Datos -->
    <div class="explorer-table-container table-wrapper">
      <div class="explorer-initial-state">
        <p style="margin-bottom: 0.35rem; font-weight: 600; color: var(--color-text);">
          Exploración Interactiva en Cliente
        </p>
        <p style="font-size: 0.8rem; margin-bottom: 1.15rem; color: var(--color-text-muted);">
          Recurso: {resource.name} ({format.toUpperCase()}) &bull; Motor DuckDB y proxy CORS automático
        </p>
        <button type="button" class="btn btn-primary btn-sm load-direct-btn">
          Cargar y Explorar Recurso
        </button>
      </div>
    </div>

    <!-- Contenedor de Mapa Geoespacial -->
    <div class="explorer-map-container" style="display: none; padding: 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background-color: var(--color-surface); margin-bottom: 0.5rem;">
      <div class="map-status-bar" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem; font-family: var(--font-mono); font-size: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
        <span class="map-title-label" style="font-weight: 600; color: var(--color-text);">Mapa Interactivo (Leaflet)</span>
        <span class="map-points-count" style="color: var(--color-primary); font-weight: 600;"></span>
      </div>

      <!-- Controles de Configuración de Coordenadas (Latitud / Longitud / Etiqueta) -->
      <div class="map-config-toolbar" style="display: flex; gap: 0.75rem; align-items: center; margin-bottom: 0.85rem; padding: 0.5rem 0.75rem; background-color: var(--color-surface-hover); border: 1px solid var(--color-border); border-radius: var(--radius-sm); flex-wrap: wrap; font-family: var(--font-mono); font-size: 0.775rem;">
        <div style="display: flex; align-items: center; gap: 0.35rem;">
          <label style="font-weight: 600; color: var(--color-text-muted);">Latitud (Y):</label>
          <select class="map-lat-select sdk-input" style="width: auto; padding: 0.25rem 0.5rem; font-size: 0.75rem;">
            <option value="">Auto-detectar</option>
          </select>
        </div>

        <div style="display: flex; align-items: center; gap: 0.35rem;">
          <label style="font-weight: 600; color: var(--color-text-muted);">Longitud (X):</label>
          <select class="map-lon-select sdk-input" style="width: auto; padding: 0.25rem 0.5rem; font-size: 0.75rem;">
            <option value="">Auto-detectar</option>
          </select>
        </div>

        <div style="display: flex; align-items: center; gap: 0.35rem;">
          <label style="font-weight: 600; color: var(--color-text-muted);">Etiqueta / Popup:</label>
          <select class="map-label-select sdk-input" style="width: auto; padding: 0.25rem 0.5rem; font-size: 0.75rem;">
            <option value="">Auto-detectar</option>
          </select>
        </div>

        <button type="button" class="btn btn-secondary btn-sm map-apply-coords-btn" style="padding: 0.25rem 0.55rem; font-size: 0.725rem;">
          Actualizar Mapa
        </button>
      </div>

      <div class="leaflet-map-element" id={`leaflet-map-${explorerId}`}></div>
      <div class="map-department-breakdown" style="margin-top: 1rem;"></div>
    </div>

    <!-- Contenedor de Gráfico Analítico -->
    <div class="explorer-chart-container" style="display: none; padding: 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background-color: var(--color-surface); margin-bottom: 0.5rem;">
    </div>

    <!-- Barra de Paginación -->
    <div class="explorer-pagination" style="display: none;">
      <button type="button" class="btn btn-secondary btn-sm pagination-prev" disabled>
        &larr; <span data-i18n="explorer.prev_page">Anterior</span>
      </button>
      <span class="pagination-page-label">Página 1 de 1</span>
      <button type="button" class="btn btn-secondary btn-sm pagination-next" disabled>
        <span data-i18n="explorer.next_page">Siguiente</span> &rarr;
      </button>
    </div>
  </div>

  <!-- Vista 3: Consola de Consultas SQL & SDK -->
  <div class="subtab-pane" data-subtab-pane="sql">
    <div class="triad-banner">
      <span class="triad-label" data-i18n="explorer.triad_label">Tríada Canónica:</span>
      <code class="triad-code">{triadName}</code>
    </div>

    <div class="sql-examples-grid">
      <!-- Ejemplo CLI -->
      <div class="sql-card card">
        <div class="sql-card-header">
          <span class="sql-lang-label">CLI (datamesh sql)</span>
          <button type="button" class="copy-snippet-btn btn btn-secondary btn-sm" data-copy={cliSnippet}>
            <span data-i18n="explorer.copy_cli">Copiar Comando CLI</span>
          </button>
        </div>
        <pre class="code-pre"><code class="language-bash">{cliSnippet}</code></pre>
      </div>

      <!-- Ejemplo Python SDK -->
      <div class="sql-card card">
        <div class="sql-card-header">
          <span class="sql-lang-label">Python SDK (DuckDB In-Memory)</span>
          <button type="button" class="copy-snippet-btn btn btn-secondary btn-sm" data-copy={pythonSnippet}>
            <span data-i18n="explorer.copy_python">Copiar Python SDK</span>
          </button>
        </div>
        <pre class="code-pre"><code class="language-python">{pythonSnippet}</code></pre>
      </div>

      <!-- Ejemplo TypeScript Client SDK -->
      <div class="sql-card card">
        <div class="sql-card-header">
          <span class="sql-lang-label">TypeScript SDK (Browser / Node)</span>
          <button type="button" class="copy-snippet-btn btn btn-secondary btn-sm" data-copy={tsSnippet}>
            <span>Copiar TypeScript</span>
          </button>
        </div>
        <pre class="code-pre"><code class="language-typescript">{tsSnippet}</code></pre>
      </div>
    </div>
  </div>
</div>

<style>
  .data-explorer-wrapper {
    margin-top: 1rem;
    margin-bottom: 2rem;
  }

  /* Subnavegación */
  .resource-subnav {
    display: flex;
    gap: 0.25rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.25rem;
    padding-bottom: 0;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
  }

  .resource-subnav::-webkit-scrollbar {
    display: none;
  }

  .subnav-tab-btn {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.95rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-muted);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    flex-shrink: 0;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .subnav-tab-btn:hover {
    color: var(--color-text);
  }

  .subnav-tab-btn.active {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
    font-weight: 600;
  }

  .subtab-pane {
    display: none;
  }

  .subtab-pane.active {
    display: block;
  }

  /* Toolbar de Exploración */
  .explorer-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
    flex-wrap: wrap;
  }

  .explorer-search-box {
    position: relative;
    flex: 1;
    min-width: 240px;
    display: flex;
    align-items: center;
  }

  .explorer-search-box .search-icon {
    position: absolute;
    left: 0.75rem;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .explorer-filter-input {
    width: 100%;
    padding: 0.45rem 2rem 0.45rem 2.25rem;
    font-size: 0.85rem;
    font-family: var(--font-sans);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    color: var(--color-text);
  }

  .explorer-filter-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 2px var(--color-primary-subtle);
  }

  .explorer-clear-filter-btn {
    all: unset;
    position: absolute;
    right: 0.65rem;
    font-size: 1.15rem;
    line-height: 1;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0 0.2rem;
  }

  .explorer-clear-filter-btn:hover {
    color: var(--color-text);
  }

  .explorer-filter-col {
    padding: 0.4rem 0.6rem;
    font-size: 0.775rem;
    font-family: var(--font-mono);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
    max-width: 160px;
  }

  .toggle-sql-btn.active {
    background-color: var(--color-surface-hover);
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .client-sql-bar {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    padding: 0.75rem;
    background-color: var(--color-surface-hover);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .client-sql-input {
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    color: var(--color-text);
  }

  .client-sql-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 2px var(--color-primary-subtle);
  }

  .explorer-toolbar-actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .explorer-view-modes {
    display: inline-flex;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--color-surface);
  }

  .view-mode-btn {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    cursor: pointer;
    background: transparent;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .view-mode-btn:not(:first-child) {
    border-left: 1px solid var(--color-border);
  }

  .view-mode-btn:hover {
    color: var(--color-text);
    background-color: var(--color-surface-hover);
  }

  .view-mode-btn.active {
    background-color: var(--color-primary);
    color: #ffffff;
  }

  .explorer-page-size {
    padding: 0.4rem 0.6rem;
    font-size: 0.8rem;
    font-family: var(--font-mono);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }

  .explorer-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    margin-bottom: 0.65rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Tabla de Datos */
  .explorer-table-container {
    max-height: 420px;
    overflow-y: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
  }

  .explorer-table-container table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.825rem;
  }

  .explorer-table-container th {
    position: sticky;
    top: 0;
    z-index: 2;
    background-color: var(--color-surface-hover);
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
  }

  .explorer-table-container th:hover {
    color: var(--color-primary);
  }

  .explorer-table-container td {
    white-space: nowrap;
    max-width: 280px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .explorer-initial-state {
    padding: 2.5rem 1rem;
    text-align: center;
  }

  /* Loading State */
  .explorer-loading-state {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .loading-spinner {
    width: 24px;
    height: 24px;
    border: 2px solid var(--color-border);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Paginación */
  .explorer-pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  /* Tríada y Ejemplos SQL */
  .triad-banner {
    padding: 0.75rem 1rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .triad-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .triad-code {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-primary);
    font-weight: 600;
    background: transparent;
    padding: 0;
  }

  .sql-examples-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sql-card {
    padding: 1rem;
  }

  .sql-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.65rem;
  }

  .sql-lang-label {
    font-family: var(--font-mono);
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--color-primary);
  }
</style>

<script>
  import { DataMeshClient, parseCsv, normalizeResourceUrl } from '@datosbolivia/datamesh-client';
  import { fetchWithCorsProxy, isCorsRestrictedDomain, setUserCustomProxy, getUserCustomProxy, getCorsProxyConfig } from '../lib/proxy';
  import { datameshMcp, isMcpEnabled } from '../lib/mcp';
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  // Usa DuckDB en cliente con catálogo por defecto de la misma página (origen actual /llms.txt)
  const client = new DataMeshClient({ engine: 'duckdb' });

  function setupExplorers() {
    const wrappers = document.querySelectorAll<HTMLElement>('[data-explorer-container]');

    wrappers.forEach((container) => {
      if (container.dataset.initialized) return;
      container.dataset.initialized = 'true';

      const remoteUrl = container.getAttribute('data-remote-url') || '';
      const triad = container.getAttribute('data-triad') || '';
      const format = container.getAttribute('data-format') || 'csv';
      const explorerId = container.id || 'explorer';

      const tabBtns = container.querySelectorAll<HTMLButtonElement>('.subnav-tab-btn');
      const tabPanes = container.querySelectorAll<HTMLElement>('.subtab-pane');
      const filterInput = container.querySelector<HTMLInputElement>('.explorer-filter-input');
      const clearFilterBtn = container.querySelector<HTMLButtonElement>('.explorer-clear-filter-btn');
      const filterColSelect = container.querySelector<HTMLSelectElement>('.explorer-filter-col');
      const toggleSqlBtn = container.querySelector<HTMLButtonElement>('.toggle-sql-btn');
      const clientSqlBar = container.querySelector<HTMLElement>('.client-sql-bar');
      const mcpModeCheckbox = container.querySelector<HTMLInputElement>('.mcp-mode-checkbox');
      const sqlBackendStatus = container.querySelector<HTMLElement>('.sql-backend-status');
      const pageSizeSelect = container.querySelector<HTMLSelectElement>('.explorer-page-size');
      const exportBtn = container.querySelector<HTMLButtonElement>('.export-btn');
      const prevBtn = container.querySelector<HTMLButtonElement>('.pagination-prev');
      const nextBtn = container.querySelector<HTMLButtonElement>('.pagination-next');
      const pageLabel = container.querySelector<HTMLElement>('.pagination-page-label');
      const recordInfo = container.querySelector<HTMLElement>('.explorer-record-info');
      const tableContainer = container.querySelector<HTMLElement>('.explorer-table-container');
      const mapContainer = container.querySelector<HTMLElement>('.explorer-map-container');
      const chartContainer = container.querySelector<HTMLElement>('.explorer-chart-container');
      const viewModeBtns = container.querySelectorAll<HTMLButtonElement>('.view-mode-btn');
      const paginationWrap = container.querySelector<HTMLElement>('.explorer-pagination');
      const loadDirectBtn = container.querySelector<HTMLButtonElement>('.load-direct-btn');
      const sqlInput = container.querySelector<HTMLInputElement>('.client-sql-input');
      const sqlRunBtn = container.querySelector<HTMLButtonElement>('.client-sql-run-btn');
      const mapLatSelect = container.querySelector<HTMLSelectElement>('.map-lat-select');
      const mapLonSelect = container.querySelector<HTMLSelectElement>('.map-lon-select');
      const mapLabelSelect = container.querySelector<HTMLSelectElement>('.map-label-select');
      const mapApplyBtn = container.querySelector<HTMLButtonElement>('.map-apply-coords-btn');

      let parsedTable: { columns: string[]; rows: string[][] } | null = null;
      let activeQueryResult: { columns: string[]; rows: string[][]; total_count: number } | null = null;
      let currentPage = 1;
      let pageSize = parseInt(pageSizeSelect?.value || '25', 10);
      let sortCol: string | undefined = undefined;
      let sortDir: 'asc' | 'desc' = 'asc';
      let isLoading = false;
      let currentViewMode: 'table' | 'map' | 'chart' = 'table';
      let leafletMap: L.Map | null = null;
      let leafletLayerGroup: L.LayerGroup | null = null;
      let selectedMapLat: string = '';
      let selectedMapLon: string = '';
      let selectedMapLabel: string = '';

      // Alternador de modos de vista (Tabla, Mapa, Gráfico)
      viewModeBtns.forEach((btn) => {
        btn.addEventListener('click', async () => {
          const mode = (btn.getAttribute('data-view-mode') || 'table') as 'table' | 'map' | 'chart';
          switchViewMode(mode);
        });
      });

      // Botón Toggle Consola SQL
      toggleSqlBtn?.addEventListener('click', () => {
        const isHidden = !clientSqlBar || clientSqlBar.style.display === 'none';
        if (clientSqlBar) {
          clientSqlBar.style.display = isHidden ? 'flex' : 'none';
        }
        toggleSqlBtn.classList.toggle('active', isHidden);
        if (isHidden) {
          sqlInput?.focus();
        }
      });

      // Controles de Configuración de Coordenadas del Mapa
      mapLatSelect?.addEventListener('change', () => {
        selectedMapLat = mapLatSelect.value;
      });
      mapLonSelect?.addEventListener('change', () => {
        selectedMapLon = mapLonSelect.value;
      });
      mapLabelSelect?.addEventListener('change', () => {
        selectedMapLabel = mapLabelSelect.value;
      });
      mapApplyBtn?.addEventListener('click', () => {
        selectedMapLat = mapLatSelect?.value || '';
        selectedMapLon = mapLonSelect?.value || '';
        selectedMapLabel = mapLabelSelect?.value || '';
        renderMap();
      });

      // Selector de modo MCP
      mcpModeCheckbox?.addEventListener('change', () => {
        if (sqlBackendStatus) {
          sqlBackendStatus.textContent = mcpModeCheckbox.checked
            ? 'Motor: Backend MCP (Remoto / JSON-RPC)'
            : 'Motor: DuckDB-WASM Local';
        }
      });

      async function switchViewMode(mode: 'table' | 'map' | 'chart') {
        currentViewMode = mode;
        viewModeBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-view-mode') === mode));

        if (!parsedTable && !isLoading) {
          await fetchViaTypeScriptClient();
        }

        renderCurrentView();

        if (mode === 'map') {
          setTimeout(() => {
            leafletMap?.invalidateSize();
          }, 80);
        }
      }

      function showLoadingState() {
        let title = 'Cargando recurso tabular...';
        let substatus = 'Descargando datos y montando motor analítico DuckDB en cliente';
        if (currentViewMode === 'map') {
          title = 'Cargando mapa interactivo Leaflet...';
          substatus = 'Procesando coordenadas territoriales y capas geoespaciales';
        } else if (currentViewMode === 'chart') {
          title = 'Cargando gráfico analítico...';
          substatus = 'Calculando agregaciones de métricas y dimensiones de datos';
        }

        const loadingHtml = `
          <div class="explorer-loading-state" style="padding: 2.25rem 1rem; text-align: center; max-width: 480px; margin: 0 auto;">
            <div class="loading-spinner"></div>
            <p style="font-size: 0.875rem; font-weight: 600; color: var(--color-text); margin-top: 0.75rem; margin-bottom: 0.25rem;">
              ${title}
            </p>
            <p class="explorer-loading-substatus" style="font-size: 0.75rem; color: var(--color-text-muted);">
              ${substatus}
            </p>
          </div>`;

        if (currentViewMode === 'table') {
          if (tableContainer) {
            tableContainer.style.display = 'block';
            tableContainer.innerHTML = loadingHtml;
          }
          if (mapContainer) mapContainer.style.display = 'none';
          if (chartContainer) chartContainer.style.display = 'none';
        } else if (currentViewMode === 'map') {
          if (mapContainer) {
            mapContainer.style.display = 'block';
            mapContainer.innerHTML = loadingHtml;
          }
          if (tableContainer) tableContainer.style.display = 'none';
          if (chartContainer) chartContainer.style.display = 'none';
        } else if (currentViewMode === 'chart') {
          if (chartContainer) {
            chartContainer.style.display = 'block';
            chartContainer.innerHTML = loadingHtml;
          }
          if (tableContainer) tableContainer.style.display = 'none';
          if (mapContainer) mapContainer.style.display = 'none';
        }
      }

      function renderCurrentView() {
        if (isLoading) {
          showLoadingState();
          return;
        }

        if (currentViewMode === 'table') {
          if (tableContainer) tableContainer.style.display = 'block';
          if (paginationWrap && parsedTable) paginationWrap.style.display = 'flex';
          if (mapContainer) mapContainer.style.display = 'none';
          if (chartContainer) chartContainer.style.display = 'none';
          renderTable();
        } else if (currentViewMode === 'map') {
          if (tableContainer) tableContainer.style.display = 'none';
          if (paginationWrap) paginationWrap.style.display = 'none';
          if (chartContainer) chartContainer.style.display = 'none';
          if (mapContainer) {
            mapContainer.style.display = 'block';
            renderMap();
          }
        } else if (currentViewMode === 'chart') {
          if (tableContainer) tableContainer.style.display = 'none';
          if (paginationWrap) paginationWrap.style.display = 'none';
          if (mapContainer) mapContainer.style.display = 'none';
          if (chartContainer) {
            chartContainer.style.display = 'block';
            renderChart();
          }
        }
      }

      // Sub-tabs switcher
      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-subtab-target');
          tabBtns.forEach((b) => {
            b.classList.toggle('active', b === btn);
            b.setAttribute('aria-selected', b === btn ? 'true' : 'false');
          });
          tabPanes.forEach((pane) => {
            pane.classList.toggle('active', pane.getAttribute('data-subtab-pane') === target);
          });

          if (target === 'preview' && !parsedTable && !isLoading) {
            fetchViaTypeScriptClient();
          }
        });
      });

      loadDirectBtn?.addEventListener('click', () => {
        fetchViaTypeScriptClient();
      });

      // Fetch tabular data using TypeScript DataMeshClient with CORS proxy fallback
      async function fetchViaTypeScriptClient() {
        isLoading = true;
        showLoadingState();

        if (format === 'parquet') {
          isLoading = false;
          renderUnsupportedFormatMessage('Parquet');
          return;
        }

        // Si la ruta del recurso apunta a un patrón wildcard / particionado (ej. *.csv)
        if (remoteUrl && remoteUrl.includes('*')) {
          isLoading = false;
          renderMultiFileWildcardMessage();
          return;
        }

        try {
          const directTarget = normalizeResourceUrl(remoteUrl);
          let resolvedTarget = directTarget;

          if (!resolvedTarget && triad) {
            try {
              resolvedTarget = await client.resolveResource(triad);
              resolvedTarget = normalizeResourceUrl(resolvedTarget);
            } catch {
              resolvedTarget = directTarget || remoteUrl;
            }
          }

          let parsed: { columns: string[]; rows: string[][] } | null = null;

          const updateStatus = (msg: string) => {
            container.querySelectorAll('.explorer-loading-substatus').forEach((el) => {
              el.textContent = msg;
            });
          };

          // 1. Si MCP está habilitado globalmente, el servidor MCP realiza la descarga y resolución
          if (isMcpEnabled()) {
            try {
              updateStatus('Descargando y resolviendo recurso a través del daemon MCP / Backend...');
              const targetRef = resolvedTarget || triad || remoteUrl;
              const mcpData = await datameshMcp.callTool<{ columns: string[]; rows: any[][]; row_count: number }>('read_resource', {
                uri: targetRef,
                limit: 5000,
              });

              if (mcpData && Array.isArray(mcpData.columns) && Array.isArray(mcpData.rows) && mcpData.columns.length > 0) {
                parsed = {
                  columns: mcpData.columns,
                  rows: mcpData.rows.map((r) => r.map((c) => String(c ?? ''))),
                };
              }
            } catch (mcpDownloadErr: any) {
              console.warn('[DataExplorer] Fallo de descarga vía MCP:', mcpDownloadErr);
              updateStatus('Fallo MCP. Intentando descarga cliente...');
            }
          }

          // 2. Si no se descargó vía MCP, usar fetch en cliente (directo o proxy)
          if (!parsed) {
            // Si el dominio tiene restricciones conocidas de CORS, descargar directamente vía proxy
            if (resolvedTarget && isCorsRestrictedDomain(resolvedTarget)) {
              updateStatus('Conectando mediante proxy CORS...');
              const resp = await fetchWithCorsProxy(resolvedTarget);
              const text = await resp.text();
              parsed = parseCsv(text);
            } else {
              // Intentar fetch directo con URL normalizada
              try {
                if (resolvedTarget) {
                  const resp = await fetch(resolvedTarget);
                  if (resp.ok) {
                    const text = await resp.text();
                    parsed = parseCsv(text);
                  } else {
                    throw new Error(`HTTP ${resp.status}: ${resp.statusText}`);
                  }
                } else {
                  const result = await client.query({
                    resource_uri: triad || remoteUrl,
                  });
                  parsed = {
                    columns: result.columns,
                    rows: result.rows,
                  };
                }
              } catch (queryErr: any) {
                // Si falla por CORS o red, reintentar con fetchWithCorsProxy
                if (resolvedTarget) {
                  updateStatus('Reintentando descarga mediante proxy CORS...');
                  const resp = await fetchWithCorsProxy(resolvedTarget);
                  const text = await resp.text();
                  parsed = parseCsv(text);
                } else {
                  throw queryErr;
                }
              }
            }
          }

          parsedTable = parsed;
          isLoading = false;

          // Poblar selector de columnas para filtro
          if (filterColSelect && filterColSelect.options.length <= 1) {
            filterColSelect.innerHTML = '<option value="">Todas las columnas</option>' +
              parsed.columns.map((c) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
          }

          executeClientQuery();
        } catch (err: any) {
          isLoading = false;
          renderErrorMessage(err?.message || 'Error de red o CORS');
        }
      }

      // Query table with in-memory TypeScript Client + Column Filter
      function executeClientQuery() {
        if (!parsedTable) return;

        const searchKeyword = (filterInput?.value || '').trim();
        const selectedCol = (filterColSelect?.value || '').trim();
        const offset = (currentPage - 1) * pageSize;

        if (clearFilterBtn) {
          clearFilterBtn.style.display = searchKeyword ? 'inline-block' : 'none';
        }

        let filteredRows = parsedTable.rows;
        if (searchKeyword) {
          const lowerKw = searchKeyword.toLowerCase();
          if (selectedCol) {
            const colIdx = parsedTable.columns.indexOf(selectedCol);
            if (colIdx !== -1) {
              filteredRows = filteredRows.filter((r) => (r[colIdx] || '').toLowerCase().includes(lowerKw));
            }
          } else {
            filteredRows = filteredRows.filter((r) => r.some((cell) => (cell || '').toLowerCase().includes(lowerKw)));
          }
        }

        // Sorting
        if (sortCol) {
          const sIdx = parsedTable.columns.indexOf(sortCol);
          if (sIdx !== -1) {
            filteredRows = [...filteredRows].sort((a, b) => {
              const va = a[sIdx] || '';
              const vb = b[sIdx] || '';
              const na = parseFloat(va);
              const nb = parseFloat(vb);
              if (!isNaN(na) && !isNaN(nb)) {
                return sortDir === 'asc' ? na - nb : nb - na;
              }
              return sortDir === 'asc' ? va.localeCompare(vb) : vb.localeCompare(va);
            });
          }
        }

        activeQueryResult = {
          columns: parsedTable.columns,
          rows: filteredRows.slice(offset, offset + pageSize),
          total_count: filteredRows.length,
        };

        renderCurrentView();
      }

      // Run SQL (DuckDB Local o Backend MCP)
      sqlRunBtn?.addEventListener('click', async () => {
        const sql = sqlInput?.value.trim() || '';
        if (!sql) return;

        const useMcp = isMcpEnabled() && (mcpModeCheckbox?.checked ?? false);

        if (useMcp) {
          try {
            sqlRunBtn.disabled = true;
            sqlRunBtn.textContent = 'Consultando MCP...';
            const mcpRes = await datameshMcp.querySql(sql, {
              catalog: 'catalogo-datamesh',
              dataset: container.getAttribute('data-dataset') || undefined,
              resource: triad || undefined,
            });
            activeQueryResult = {
              columns: mcpRes.columns,
              rows: mcpRes.rows.map((r) => r.map((c) => String(c ?? ''))),
              total_count: mcpRes.row_count,
            };
            currentPage = 1;
            renderCurrentView();
            if (recordInfo) {
              recordInfo.textContent = `Backend MCP: ${mcpRes.row_count} registros devueltos`;
            }
          } catch (mcpErr: any) {
            alert(`Backend MCP no disponible (${mcpErr?.message || mcpErr}). Evaluando en DuckDB local...`);
            runDuckDbLocal(sql);
          } finally {
            sqlRunBtn.disabled = false;
            sqlRunBtn.textContent = 'Ejecutar SQL';
          }
        } else {
          runDuckDbLocal(sql);
        }
      });

      async function runDuckDbLocal(sql: string) {
        if (!parsedTable) {
          await fetchViaTypeScriptClient();
          if (!parsedTable) return;
        }

        try {
          const sqlRes = await client.sql(sql, parsedTable, triad);
          activeQueryResult = {
            columns: sqlRes.columns,
            rows: sqlRes.rows,
            total_count: sqlRes.total_count,
          };
          currentPage = 1;
          renderCurrentView();
          if (recordInfo) {
            recordInfo.textContent = `DuckDB local: ${sqlRes.row_count} filas procesadas`;
          }
        } catch (e: any) {
          alert(`Error en consulta SQL DuckDB: ${e?.message}`);
        }
      }

      function renderTable() {
        if (!tableContainer || !activeQueryResult) return;

        const { columns, rows, total_count } = activeQueryResult;
        const totalPages = Math.max(1, Math.ceil(total_count / pageSize));
        if (currentPage > totalPages) currentPage = totalPages;

        const startIdx = (currentPage - 1) * pageSize;
        const endIdx = Math.min(startIdx + rows.length, total_count);

        if (recordInfo) {
          if (total_count === 0) {
            recordInfo.textContent = '0 registros encontrados';
          } else {
            recordInfo.textContent = `Mostrando ${startIdx + 1} - ${endIdx} de ${total_count} registros`;
          }
        }

        if (pageLabel) {
          pageLabel.textContent = `Página ${currentPage} de ${totalPages}`;
        }

        if (prevBtn) prevBtn.disabled = currentPage <= 1;
        if (nextBtn) nextBtn.disabled = currentPage >= totalPages;

        if (rows.length === 0) {
          tableContainer.innerHTML = `
            <div style="padding: 2.5rem; text-align: center; color: var(--color-text-muted); font-size: 0.85rem;">
              No se encontraron registros que coincidan con la búsqueda.
            </div>`;
          return;
        }

        let html = '<table><thead><tr>';
        columns.forEach((col) => {
          const isSorted = sortCol && sortCol.toLowerCase() === col.toLowerCase();
          const arrow = isSorted ? (sortDir === 'asc' ? ' &uarr;' : ' &darr;') : '';
          html += `<th data-col-name="${escapeHtml(col)}" title="Ordenar columna">${escapeHtml(col)}${arrow}</th>`;
        });
        html += '</tr></thead><tbody>';

        rows.forEach((row) => {
          html += '<tr>';
          columns.forEach((_, colIdx) => {
            const val = row[colIdx] !== undefined ? row[colIdx] : '';
            html += `<td title="${escapeHtml(val)}">${escapeHtml(val)}</td>`;
          });
          html += '</tr>';
        });

        html += '</tbody></table>';
        tableContainer.innerHTML = html;

        // Sorting on header click
        tableContainer.querySelectorAll('th').forEach((th) => {
          th.addEventListener('click', () => {
            const colName = th.getAttribute('data-col-name');
            if (!colName) return;
            if (sortCol?.toLowerCase() === colName.toLowerCase()) {
              sortDir = sortDir === 'asc' ? 'desc' : 'asc';
            } else {
              sortCol = colName;
              sortDir = 'asc';
            }
            executeClientQuery();
          });
        });
      }

      const BOLIVIA_DEPT_NAMES: Record<string, string> = {
        '1': 'Chuquisaca', '2': 'La Paz', '3': 'Cochabamba', '4': 'Oruro',
        '5': 'Potosí', '6': 'Tarija', '7': 'Santa Cruz', '8': 'Beni', '9': 'Pando'
      };

      const BOLIVIA_DEPT_CENTROIDS: Record<string, [number, number]> = {
        'la paz': [-16.5, -68.15],
        'santa cruz': [-17.8, -63.18],
        'cochabamba': [-17.38, -66.16],
        'oruro': [-17.98, -67.11],
        'potosi': [-19.58, -65.75],
        'potosí': [-19.58, -65.75],
        'chuquisaca': [-19.03, -65.26],
        'tarija': [-21.53, -64.73],
        'beni': [-14.83, -64.9],
        'pando': [-11.02, -68.76],
      };

      let selectedChartCat: string | null = null;
      let selectedChartMetric: string | null = null;

      function renderMap() {
        if (!mapContainer || !parsedTable) return;
        const { columns, rows } = parsedTable;

        // Poblar selects de coordenadas si no están poblados
        if (mapLatSelect && mapLatSelect.options.length <= 1) {
          mapLatSelect.innerHTML = '<option value="">Auto-detectar</option>' +
            columns.map((c) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
        }
        if (mapLonSelect && mapLonSelect.options.length <= 1) {
          mapLonSelect.innerHTML = '<option value="">Auto-detectar</option>' +
            columns.map((c) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
        }
        if (mapLabelSelect && mapLabelSelect.options.length <= 1) {
          mapLabelSelect.innerHTML = '<option value="">Auto-detectar</option>' +
            columns.map((c) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
        }

        // Detectar índices con fallback a selecciones explícitas del usuario
        let latIdx = selectedMapLat ? columns.indexOf(selectedMapLat) : -1;
        if (latIdx === -1) {
          latIdx = columns.findIndex((c) => /^(lat|latitude|latitud|lat_geo|y)$/i.test(c.trim()));
        }

        let lonIdx = selectedMapLon ? columns.indexOf(selectedMapLon) : -1;
        if (lonIdx === -1) {
          lonIdx = columns.findIndex((c) => /^(lon|lng|longitude|longitud|lon_geo|x)$/i.test(c.trim()));
        }

        let labelIdx = selectedMapLabel ? columns.indexOf(selectedMapLabel) : -1;
        if (labelIdx === -1) {
          labelIdx = columns.findIndex((c) => /(nombre|name|estacion|station|lugar|municipio|entidad|title|label|paf|entidad)/i.test(c.trim()));
        }

        const deptIdx = columns.findIndex((c) => /(departamento|depto|ciudad|region|id_departamento|nameDepartment)/i.test(c.trim()));

        // Sincronizar selectores con los valores detectados si estaban vacíos
        if (mapLatSelect && latIdx !== -1 && !mapLatSelect.value) {
          mapLatSelect.value = columns[latIdx];
        }
        if (mapLonSelect && lonIdx !== -1 && !mapLonSelect.value) {
          mapLonSelect.value = columns[lonIdx];
        }
        if (mapLabelSelect && labelIdx !== -1 && !mapLabelSelect.value) {
          mapLabelSelect.value = columns[labelIdx];
        }

        const mapEl = mapContainer.querySelector<HTMLElement>('.leaflet-map-element');
        const countEl = mapContainer.querySelector<HTMLElement>('.map-points-count');
        const deptEl = mapContainer.querySelector<HTMLElement>('.map-department-breakdown');
        if (!mapEl) return;

        // Inicializar Leaflet map sólo una vez
        if (!leafletMap) {
          leafletMap = L.map(mapEl, {
            center: [-16.5, -64.5],
            zoom: 6,
            scrollWheelZoom: false,
          });

          L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 18,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a>',
          }).addTo(leafletMap);

          leafletLayerGroup = L.layerGroup().addTo(leafletMap);
        }

        if (leafletLayerGroup) {
          leafletLayerGroup.clearLayers();
        }

        // 1. Mapeo de coordenadas puntuales (lat / lon)
        if (latIdx !== -1 && lonIdx !== -1) {
          const points = rows
            .map((r, i) => {
              const lat = parseFloat(r[latIdx]);
              const lon = parseFloat(r[lonIdx]);
              const label = labelIdx !== -1 ? (r[labelIdx] || `Punto ${i + 1}`) : `Punto ${i + 1}`;
              const dept = deptIdx !== -1 ? (r[deptIdx] || '') : '';
              return { lat, lon, label, dept };
            })
            .filter((p) => !isNaN(p.lat) && !isNaN(p.lon) && p.lat >= -25 && p.lat <= -9 && p.lon >= -72 && p.lon <= -55);

          if (points.length > 0) {
            if (countEl) countEl.textContent = `${points.length} ubicaciones georreferenciadas (${columns[latIdx]}, ${columns[lonIdx]})`;

            const bounds: L.LatLngExpression[] = [];
            points.slice(0, 1000).forEach((p) => {
              bounds.push([p.lat, p.lon]);
              const marker = L.circleMarker([p.lat, p.lon], {
                radius: 6,
                fillColor: '#0284c7',
                color: '#ffffff',
                weight: 1.5,
                opacity: 1,
                fillOpacity: 0.85,
              });

              const popupContent = `
                <div style="font-family: var(--font-sans); font-size: 0.8rem; line-height: 1.4;">
                  <div style="font-weight: 600; color: var(--color-text); margin-bottom: 0.25rem;">${escapeHtml(p.label)}</div>
                  ${p.dept ? `<div style="font-size: 0.72rem; color: var(--color-text-muted); font-family: var(--font-mono);">${escapeHtml(p.dept)}</div>` : ''}
                  <div style="font-size: 0.7rem; color: var(--color-text-muted); margin-top: 0.25rem; font-family: var(--font-mono);">
                    ${p.lat.toFixed(4)}&deg; S, ${p.lon.toFixed(4)}&deg; O
                  </div>
                </div>
              `;
              marker.bindPopup(popupContent);
              leafletLayerGroup?.addLayer(marker);
            });

            if (bounds.length > 0) {
              leafletMap.fitBounds(L.latLngBounds(bounds), { padding: [25, 25], maxZoom: 14 });
            }

            if (deptEl) {
              deptEl.innerHTML = '';
            }

            setTimeout(() => leafletMap?.invalidateSize(), 80);
            return;
          }
        }

        // 2. Mapeo por departamentos bolivianos
        if (deptIdx !== -1) {
          const counts: Record<string, number> = {};
          rows.forEach((r) => {
            const raw = (r[deptIdx] || '').trim();
            const norm = BOLIVIA_DEPT_NAMES[raw] || raw || 'Sin clasificar';
            counts[norm] = (counts[norm] || 0) + 1;
          });

          const sorted = Object.entries(counts).sort((a, b) => b[1] - a[1]);
          const maxCount = Math.max(...sorted.map((s) => s[1]), 1);

          if (countEl) countEl.textContent = `Distribución departamental (${sorted.length} regiones)`;

          sorted.forEach(([dept, count]) => {
            const cleanKey = dept.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
            const centroid = BOLIVIA_DEPT_CENTROIDS[cleanKey] || BOLIVIA_DEPT_CENTROIDS[dept.toLowerCase()];
            if (centroid) {
              const radius = Math.max(7, Math.min(28, (count / maxCount) * 24 + 7));
              const marker = L.circleMarker(centroid, {
                radius,
                fillColor: '#0284c7',
                color: '#ffffff',
                weight: 2,
                opacity: 1,
                fillOpacity: 0.8,
              });

              const popupContent = `
                <div style="font-family: var(--font-sans); font-size: 0.825rem;">
                  <strong style="color: var(--color-text);">${escapeHtml(dept)}</strong>
                  <div style="font-family: var(--font-mono); font-size: 0.75rem; color: #0284c7; margin-top: 0.2rem; font-weight: 600;">
                    ${count.toLocaleString()} registros (${((count / rows.length) * 100).toFixed(1)}%)
                  </div>
                </div>
              `;
              marker.bindPopup(popupContent);
              leafletLayerGroup?.addLayer(marker);
            }
          });

          leafletMap.setView([-16.5, -64.5], 6);

          if (deptEl) {
            const itemsHtml = sorted.map(([dept, count]) => {
              const pct = ((count / maxCount) * 100).toFixed(0);
              return `
                <div style="display: grid; grid-template-columns: 110px 1fr 60px; align-items: center; gap: 0.5rem; font-size: 0.78rem; font-family: var(--font-mono);">
                  <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--color-text);">${escapeHtml(dept)}</span>
                  <div style="background: var(--color-surface-hover); height: 8px; border-radius: 2px; overflow: hidden; border: 1px solid var(--color-border);">
                    <div style="width: ${pct}%; height: 100%; background: var(--color-primary);"></div>
                  </div>
                  <span style="text-align: right; font-weight: 600; color: var(--color-text);">${count.toLocaleString()}</span>
                </div>
              `;
            }).join('');

            deptEl.innerHTML = `
              <div style="padding-top: 0.75rem; border-top: 1px dashed var(--color-border);">
                <div style="font-size: 0.75rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.5rem; font-family: var(--font-mono);">
                  Desglose Territorial (${escapeHtml(columns[deptIdx])}):
                </div>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0.45rem;">
                  ${itemsHtml}
                </div>
              </div>
            `;
          }

          setTimeout(() => leafletMap?.invalidateSize(), 80);
          return;
        }

        // 3. Ni coordenadas ni departamento
        if (countEl) countEl.textContent = 'Sin atributos espaciales';
        if (deptEl) {
          deptEl.innerHTML = `
            <div style="padding: 1.5rem; text-align: center; color: var(--color-text-muted); font-size: 0.8rem;">
              Selecciona manualmente en los controles superiores las columnas que contienen la <strong>Latitud</strong> y <strong>Longitud</strong>.
            </div>
          `;
        }
      }

      function renderChart() {
        if (!chartContainer || !parsedTable) return;
        const { columns, rows } = parsedTable;

        if (rows.length === 0) {
          chartContainer.innerHTML = `
            <div style="padding: 2.5rem; text-align: center; color: var(--color-text-muted); font-size: 0.85rem;">
              No hay datos para graficar.
            </div>`;
          return;
        }

        // Identificar columnas cuantitativas (excluyendo IDs y coordenadas)
        const isNumericCol = (cIdx: number) => {
          let numCount = 0;
          for (let r = 0; r < Math.min(rows.length, 15); r++) {
            const v = parseFloat(rows[r][cIdx]);
            if (!isNaN(v)) numCount++;
          }
          return numCount >= 5;
        };

        const isIdOrCoordCol = (colName: string) => {
          return /^(id|_id|id_|codigo|code|lat|latitude|latitud|lon|longitude|longitud|x|y)$/i.test(colName.trim());
        };

        const numericCols = columns.filter((col, idx) => isNumericCol(idx) && !isIdOrCoordCol(col));

        // Selección predeterminada inteligente de categoría
        if (!selectedChartCat || !columns.includes(selectedChartCat)) {
          // Prioridad: departamento > tipo/categoria > entidad/estacion > primera columna de texto
          const bestCat = columns.find(c => /(departamento|depto|ciudad|municipio|id_departamento)/i.test(c))
            || columns.find(c => /(tipo|categoria|grupo|desgrupo|entidad|banco|station|estacion|nombre|name)/i.test(c))
            || columns.find(c => !isNumericCol(columns.indexOf(c)))
            || columns[0];
          selectedChartCat = bestCat;
        }

        // Selección predeterminada de métrica
        if (!selectedChartMetric) {
          selectedChartMetric = numericCols.length > 0 ? numericCols[0] : '__count__';
        }

        const catCol = selectedChartCat;
        const metricCol = selectedChartMetric;
        const catIdx = columns.indexOf(catCol);
        const metricIdx = metricCol === '__count__' ? -1 : columns.indexOf(metricCol);

        // Agregación de datos
        const isIdDept = /^id_departamento$/i.test(catCol);
        const groups: Record<string, { sum: number; count: number }> = {};

        rows.forEach((r) => {
          let key = (r[catIdx] || '').trim();
          if (isIdDept && BOLIVIA_DEPT_NAMES[key]) {
            key = BOLIVIA_DEPT_NAMES[key];
          } else if (!key) {
            key = 'Sin dato';
          }

          if (!groups[key]) {
            groups[key] = { sum: 0, count: 0 };
          }
          groups[key].count += 1;

          if (metricIdx !== -1) {
            const v = parseFloat(r[metricIdx]);
            if (!isNaN(v)) {
              groups[key].sum += v;
            }
          }
        });

        const isCountMetric = metricCol === '__count__';
        const chartData = Object.entries(groups)
          .map(([label, g]) => ({
            label,
            val: isCountMetric ? g.count : (g.count > 0 ? Math.round((g.sum / g.count) * 10) / 10 : 0),
          }))
          .sort((a, b) => b.val - a.val)
          .slice(0, 10);

        const maxVal = Math.max(...chartData.map((d) => d.val), 1);
        const w = 580;
        const labelW = 150;
        const padT = 32, padB = 30;
        const trackW = w - labelW - 95;
        const rowH = 26;
        const contentH = chartData.length * rowH;
        const totalH = padT + contentH + padB;

        const metricLabel = isCountMetric ? 'Frecuencia (Registros)' : `${escapeHtml(metricCol)} (Promedio)`;

        const barsSvg = chartData.map((d, i) => {
          const y = padT + i * rowH;
          const bw = Math.max(2, (d.val / maxVal) * trackW);
          const lbl = d.label.length > 20 ? d.label.slice(0, 19) + '…' : d.label;
          return `
            <text x="${labelW - 10}" y="${y + 14}" text-anchor="end" font-size="9.5" font-family="var(--font-mono)" fill="var(--color-text)">${escapeHtml(lbl)}</text>
            <rect x="${labelW}" y="${y + 3}" width="${trackW}" height="15" rx="3" fill="var(--color-surface-hover)" stroke="var(--color-border)" stroke-width="0.5"/>
            <rect x="${labelW}" y="${y + 3}" width="${bw.toFixed(1)}" height="15" rx="3" fill="var(--color-primary)"/>
            <text x="${(labelW + bw + 6).toFixed(1)}" y="${y + 14}" font-size="9" font-family="var(--font-mono)" fill="var(--color-text)" font-weight="600">${d.val.toLocaleString()}</text>
          `;
        }).join('');

        const gridSvg = [0, 0.5, 1].map((t) => {
          const gx = (labelW + t * trackW).toFixed(1);
          const v = Math.round(t * maxVal);
          return `
            <line x1="${gx}" y1="${padT}" x2="${gx}" y2="${padT + contentH}" stroke="var(--color-border)" stroke-width="0.5" stroke-dasharray="3,3"/>
            <text x="${gx}" y="${padT - 8}" font-size="8" font-family="var(--font-mono)" fill="var(--color-text-muted)" text-anchor="middle">${v.toLocaleString()}</text>
          `;
        }).join('');

        // Selectores de categoría y métrica interactivos
        const catOptions = columns.map(c => `<option value="${escapeHtml(c)}"${c === selectedChartCat ? ' selected' : ''}>${escapeHtml(c)}</option>`).join('');
        const metricOptions = [
          `<option value="__count__"${selectedChartMetric === '__count__' ? ' selected' : ''}>Recuento de Registros (Frecuencia)</option>`,
          ...numericCols.map(c => `<option value="${escapeHtml(c)}"${c === selectedChartMetric ? ' selected' : ''}>Promedio de ${escapeHtml(c)}</option>`)
        ].join('');

        chartContainer.innerHTML = `
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.85rem; flex-wrap: wrap; gap: 0.6rem; padding-bottom: 0.65rem; border-bottom: 1px solid var(--color-border);">
            <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
              <label style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--color-text-muted);">
                Categoría:
                <select class="chart-selector-cat" style="font-size: 0.75rem; padding: 0.2rem 0.45rem; font-family: var(--font-mono); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-text);">
                  ${catOptions}
                </select>
              </label>
              <label style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--color-text-muted);">
                Métrica:
                <select class="chart-selector-metric" style="font-size: 0.75rem; padding: 0.2rem 0.45rem; font-family: var(--font-mono); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-text);">
                  ${metricOptions}
                </select>
              </label>
            </div>
            <span style="font-size: 0.72rem; font-family: var(--font-mono); color: var(--color-primary); font-weight: 600;">
              Top 10 &bull; ${escapeHtml(metricLabel)}
            </span>
          </div>
          <div style="max-width: 620px; margin: 0 auto; overflow: hidden;">
            <svg viewBox="0 0 ${w} ${totalH}" class="chart-bar-svg" style="width: 100%; display: block;">
              ${gridSvg}
              <line x1="${labelW}" y1="${padT}" x2="${labelW}" y2="${padT + contentH}" stroke="var(--color-text-muted)" stroke-width="1.5"/>
              ${barsSvg}
            </svg>
          </div>
        `;

        chartContainer.querySelector('.chart-selector-cat')?.addEventListener('change', (e: any) => {
          selectedChartCat = e.target.value;
          renderChart();
        });
        chartContainer.querySelector('.chart-selector-metric')?.addEventListener('change', (e: any) => {
          selectedChartMetric = e.target.value;
          renderChart();
        });
      }

      function renderErrorMessage(msg: string) {
        if (!tableContainer) return;
        if (mapContainer) mapContainer.style.display = 'none';
        if (chartContainer) chartContainer.style.display = 'none';
        if (paginationWrap) paginationWrap.style.display = 'none';
        tableContainer.style.display = 'block';
        tableContainer.innerHTML = `
          <div style="padding: 2rem 1.5rem; text-align: center; color: var(--color-text-muted);">
            <p style="margin-bottom: 0.5rem; font-weight: 600; color: var(--color-text);">
              El cliente web no pudo descargar este recurso directamente.
            </p>
            <p style="font-size: 0.8rem; margin-bottom: 1rem; line-height: 1.5;">
              Causa: ${escapeHtml(msg)}. El servidor remoto restringe solicitudes directas de navegador (CORS) o requiere autorización de sesión.
            </p>
            <p style="font-size: 0.825rem; margin-bottom: 0.75rem;">
              Puedes consultarlo sin restricciones de navegador utilizando el SDK y CLI de DataMesh:
            </p>
            <pre class="code-pre" style="margin: 0 auto; max-width: 550px; text-align: left; padding: 0.6rem 0.9rem;"><code class="language-bash">datamesh sql "SELECT * FROM '${triad}' LIMIT 10"</code></pre>
          </div>`;
      }

      function renderUnsupportedFormatMessage(formatName: string) {
        if (!tableContainer) return;
        if (mapContainer) mapContainer.style.display = 'none';
        if (chartContainer) chartContainer.style.display = 'none';
        if (paginationWrap) paginationWrap.style.display = 'none';
        tableContainer.style.display = 'block';
        tableContainer.innerHTML = `
          <div style="padding: 2rem 1.5rem; text-align: center; color: var(--color-text-muted);">
            <p style="margin-bottom: 0.5rem; font-weight: 600; color: var(--color-text);">
              Formato ${formatName} (Formato Columnar Binario)
            </p>
            <p style="font-size: 0.8rem; margin-bottom: 1rem; line-height: 1.5;">
              Los archivos Parquet son procesados en streaming con motor columnar local DuckDB a través del SDK / CLI de DataMesh.
            </p>
            <pre class="code-pre" style="margin: 0 auto; max-width: 550px; text-align: left; padding: 0.6rem 0.9rem;"><code class="language-bash">datamesh sql "SELECT * FROM '${triad}' LIMIT 10"</code></pre>
          </div>`;
      }

      function renderMultiFileWildcardMessage() {
        if (!tableContainer) return;
        if (mapContainer) mapContainer.style.display = 'none';
        if (chartContainer) chartContainer.style.display = 'none';
        if (paginationWrap) paginationWrap.style.display = 'none';
        tableContainer.style.display = 'block';
        tableContainer.innerHTML = `
          <div style="padding: 2.25rem 1.5rem; text-align: center; color: var(--color-text-muted);">
            <p style="margin-bottom: 0.5rem; font-weight: 600; font-size: 1rem; color: var(--color-text);">
              Conjunto de Datos Particionado Multi-Archivo
            </p>
            <p style="font-size: 0.825rem; margin-bottom: 1.15rem; line-height: 1.5; max-width: 600px; margin-left: auto; margin-right: auto;">
              Este recurso representa una colección particionada por periodos temporales (<code>${escapeHtml(remoteUrl)}</code>). Los navegadores web no resuelven patrones comodín (glob <code>*</code>) directamente por HTTP. DuckDB y el CLI de DataMesh unen las particiones en tiempo real:
            </p>
            <div style="margin: 0 auto; max-width: 580px; text-align: left; display: flex; flex-direction: column; gap: 0.65rem;">
              <pre class="code-pre" style="margin: 0; padding: 0.65rem 0.9rem;"><code class="language-bash">datamesh sql "SELECT * FROM '${triad}' LIMIT 25"</code></pre>
              <pre class="code-pre" style="margin: 0; padding: 0.65rem 0.9rem;"><code class="language-python">import datamesh as dm
df = dm.sql("SELECT * FROM '${triad}' LIMIT 25")</code></pre>
            </div>
          </div>`;
      }

      function escapeHtml(str: string): string {
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      filterInput?.addEventListener('input', () => {
        currentPage = 1;
        executeClientQuery();
      });

      pageSizeSelect?.addEventListener('change', () => {
        pageSize = parseInt(pageSizeSelect.value, 10);
        currentPage = 1;
        executeClientQuery();
      });

      prevBtn?.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          executeClientQuery();
          tableContainer.scrollTop = 0;
        }
      });

      nextBtn?.addEventListener('click', () => {
        if (!parsedTable) return;
        const totalPages = Math.ceil(parsedTable.rows.length / pageSize);
        if (currentPage < totalPages) {
          currentPage++;
          executeClientQuery();
          tableContainer.scrollTop = 0;
        }
      });

      exportBtn?.addEventListener('click', () => {
        if (!parsedTable) return;
        let csv = parsedTable.columns.map((c) => `"${c.replace(/"/g, '""')}"`).join(',') + '\n';
        parsedTable.rows.forEach((row) => {
          csv += row.map((cell) => `"${(cell || '').replace(/"/g, '""')}"`).join(',') + '\n';
        });
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${triad.replace(/[^a-zA-Z0-9_-]/g, '_')}_export.csv`;
        a.click();
        URL.revokeObjectURL(url);
      });

      // Snippet copy buttons
      container.querySelectorAll('.copy-snippet-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const text = btn.getAttribute('data-copy') || '';
          try {
            await navigator.clipboard.writeText(text);
            const original = btn.innerHTML;
            btn.innerHTML = '<span>¡Copiado!</span>';
            setTimeout(() => {
              btn.innerHTML = original;
            }, 2000);
          } catch {
            // fallback
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupExplorers);
  } else {
    setupExplorers();
  }
</script>
