          setTimeout(() => {
            leafletMap?.invalidateSize();
          }, 80);
        }
      }

      function showLoadingState() {
        let title = 'Cargando recurso tabular...';
        let substatus = 'Descargando datos y montando motor analítico DuckDB en cliente';
        if (currentViewMode === 'map') {
          title = 'Cargando mapa interactivo Leaflet...';
          substatus = 'Procesando coordenadas territoriales y capas geoespaciales';
        } else if (currentViewMode === 'chart') {
          title = 'Cargando gráfico analítico...';
          substatus = 'Calculando agregaciones de métricas y dimensiones de datos';
