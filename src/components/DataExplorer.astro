      }

      function renderCurrentView() {
        if (isLoading) {
          showLoadingState();
          return;
        }

        if (currentViewMode === 'table') {
          if (tableContainer) tableContainer.style.display = 'block';
          if (paginationWrap && parsedTable) paginationWrap.style.display = 'flex';
