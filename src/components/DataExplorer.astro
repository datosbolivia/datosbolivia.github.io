      // Fetch tabular data using TypeScript DataMeshClient with CORS proxy fallback
      async function fetchViaTypeScriptClient() {
        isLoading = true;
        showLoadingState();

        if (format === 'parquet') {
          isLoading = false;
          renderUnsupportedFormatMessage('Parquet');
          return;
        }

        // Si la ruta del recurso apunta a un patrón wildcard / particionado (ej. *.csv) y no hay MCP conectado
        const isMultiFileWildcard = Boolean(remoteUrl && remoteUrl.includes('*'));
        if (isMultiFileWildcard && !isMcpEnabled()) {
          isLoading = false;
          renderMultiFileWildcardMessage();
          return;
        }

        try {
          const directTarget = normalizeResourceUrl(remoteUrl);
          let resolvedTarget = directTarget;

          if (!resolvedTarget && triad) {
            try {
              resolvedTarget = await client.resolveResource(triad);
              resolvedTarget = normalizeResourceUrl(resolvedTarget);
            } catch {
              resolvedTarget = directTarget || remoteUrl;
            }
          }

          let parsed: { columns: string[]; rows: string[][] } | null = null;

          const updateStatus = (msg: string) => {
            container.querySelectorAll('.explorer-loading-substatus').forEach((el) => {
              el.textContent = msg;
            });
          };

          // 1. Si MCP está habilitado globalmente, el servidor MCP realiza la descarga y resolución
          if (isMcpEnabled()) {
            try {
              updateStatus('Descargando y resolviendo recurso a través del daemon MCP / Backend...');
              const targetRef = triad || resolvedTarget || remoteUrl;
              const mcpData = await datameshMcp.callTool<{ columns: string[]; rows: any[][]; row_count: number }>('read_resource', {
                uri: targetRef,
                limit: 5000,
              });

              if (mcpData && Array.isArray(mcpData.columns) && Array.isArray(mcpData.rows) && mcpData.columns.length > 0) {
                parsed = {
                  columns: mcpData.columns,
                  rows: mcpData.rows.map((r) => r.map((c) => String(c ?? ''))),
                };
              }
            } catch (mcpDownloadErr: any) {
              console.warn('[DataExplorer] Fallo de descarga vía MCP:', mcpDownloadErr);
              updateStatus('Fallo MCP. Intentando descarga cliente...');
            }
          }

          const isZipOrArchive = Boolean(containerUrl) || format === 'zip' || (Boolean(resolvedTarget) && !resolvedTarget.startsWith('http://') && !resolvedTarget.startsWith('https://')) || (Boolean(remoteUrl) && remoteUrl.toLowerCase().endsWith('.zip'));

          // 2. Si no se descargó vía MCP, usar fetch en cliente (directo o proxy)
          if (!parsed) {
            // Si el recurso proviene de un contenedor ZIP o no es una URL pública HTTP, requiere el backend sovereign
            if (isZipOrArchive) {
              isLoading = false;
              renderZipServerRequiredMessage(containerUrl || remoteUrl);
              return;
            }

            // Si el dominio tiene restricciones conocidas de CORS, descargar directamente vía proxy
            if (resolvedTarget && isCorsRestrictedDomain(resolvedTarget)) {
              updateStatus('Conectando mediante proxy CORS...');
              const resp = await fetchWithCorsProxy(resolvedTarget);
              const text = await resp.text();
              parsed = parseCsv(text);
            } else {
              // Intentar fetch directo con URL normalizada sólo si es HTTP(S)
              try {
                if (resolvedTarget && (resolvedTarget.startsWith('http://') || resolvedTarget.startsWith('https://'))) {
                  const resp = await fetch(resolvedTarget);
                  if (resp.ok) {
                    const text = await resp.text();
                    parsed = parseCsv(text);
                  } else {
                    throw new Error(`HTTP ${resp.status}: ${resp.statusText}`);
                  }
                } else if (!isZipOrArchive) {
                  const result = await client.query({
                    resource_uri: triad || remoteUrl,
                  });
                  parsed = {
                    columns: result.columns,
                    rows: result.rows,
                  };
                } else {
                  isLoading = false;
                  renderZipServerRequiredMessage(containerUrl || remoteUrl);
                  return;
                }
              } catch (queryErr: any) {
                // Si falla por CORS o red, reintentar con fetchWithCorsProxy
                if (resolvedTarget && (resolvedTarget.startsWith('http://') || resolvedTarget.startsWith('https://'))) {
                  updateStatus('Reintentando descarga mediante proxy CORS...');
                  const resp = await fetchWithCorsProxy(resolvedTarget);
                  const text = await resp.text();
                  parsed = parseCsv(text);
                } else {
                  throw queryErr;
                }
              }
            }
          }

          parsedTable = parsed;
          isLoading = false;

          // Poblar selector de columnas para el constructor de filtros
          if (builderColSelect && builderColSelect.options.length <= 1) {
            builderColSelect.innerHTML = '<option value="">(Cualquier columna)</option>' +
              parsed.columns.map((c) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
          }
          if (builderGroupColSelect && builderGroupColSelect.options.length <= 1) {
            builderGroupColSelect.innerHTML = '<option value="">(Sin agrupar / Detalle fila por fila)</option>' +
              parsed.columns.map((c) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
          }
          if (builderAggColSelect && builderAggColSelect.options.length <= 1) {
            builderAggColSelect.innerHTML = '<option value="">(Seleccionar columna métrica)</option>' +
              parsed.columns.map((c) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
          }
          updateBuilderPreview();

          executeClientQuery();
        } catch (err: any) {
          isLoading = false;
          renderErrorMessage(err?.message || 'Error de red o CORS');
        }
      }

      // Query table with in-memory TypeScript Client + Visual Query Builder Filter & Grouping
      function executeClientQuery() {
        if (!parsedTable) return;

        const selectedCol = (builderColSelect?.value || '').trim();
        const op = (builderOpSelect?.value || 'contains').trim();
        const searchKeyword = (builderValInput?.value || '').trim();
        const lowerKw = searchKeyword.toLowerCase();

        const groupCol = (builderGroupColSelect?.value || '').trim();
        const aggFunc = (builderAggFuncSelect?.value || 'COUNT').trim();
        const aggCol = (builderAggColSelect?.value || '').trim();
        const orderDir = (builderOrderDirSelect?.value || 'DESC').trim();

        const offset = (currentPage - 1) * pageSize;

        let filteredRows = parsedTable.rows;

        // 1. Filtrado WHERE
        if (op === 'is_null') {
          if (selectedCol) {
            const colIdx = parsedTable.columns.indexOf(selectedCol);
            if (colIdx !== -1) {
              filteredRows = filteredRows.filter((r) => {
                const v = r[colIdx];
                return v === undefined || v === null || String(v).trim() === '';
              });
            }
          } else {
            filteredRows = filteredRows.filter((r) =>
              r.some((cell) => cell === undefined || cell === null || String(cell).trim() === '')
            );
          }
        } else if (op === 'is_not_null') {
          if (selectedCol) {
            const colIdx = parsedTable.columns.indexOf(selectedCol);
            if (colIdx !== -1) {
              filteredRows = filteredRows.filter((r) => {
                const v = r[colIdx];
                return v !== undefined && v !== null && String(v).trim() !== '';
              });
            }
          } else {
            filteredRows = filteredRows.filter((r) =>
              r.every((cell) => cell !== undefined && cell !== null && String(cell).trim() !== '')
            );
          }
        } else if (searchKeyword) {
          if (selectedCol) {
            const colIdx = parsedTable.columns.indexOf(selectedCol);
            if (colIdx !== -1) {
              filteredRows = filteredRows.filter((r) => {
                const cell = (r[colIdx] || '').trim();
                const lowerCell = cell.toLowerCase();
                switch (op) {
                  case 'contains':
                    return lowerCell.includes(lowerKw);
                  case 'equals':
                    return lowerCell === lowerKw;
                  case 'not_equals':
                    return lowerCell !== lowerKw;
                  case 'starts_with':
                    return lowerCell.startsWith(lowerKw);
                  case 'greater_than': {
                    const numCell = parseFloat(cell);
                    const numKw = parseFloat(searchKeyword);
                    return !isNaN(numCell) && !isNaN(numKw) ? numCell > numKw : cell > searchKeyword;
                  }
                  case 'less_than': {
                    const numCell = parseFloat(cell);
                    const numKw = parseFloat(searchKeyword);
                    return !isNaN(numCell) && !isNaN(numKw) ? numCell < numKw : cell < searchKeyword;
                  }
                  default:
                    return lowerCell.includes(lowerKw);
                }
              });
            }
          } else {
            // Cualquier columna
            filteredRows = filteredRows.filter((r) =>
              r.some((cell) => (cell || '').toLowerCase().includes(lowerKw))
            );
          }
        }

        // 2. Si hay GROUP BY activo:
        if (groupCol && parsedTable.columns.includes(groupCol)) {
          const gIdx = parsedTable.columns.indexOf(groupCol);
          const mIdx = aggCol && parsedTable.columns.includes(aggCol) ? parsedTable.columns.indexOf(aggCol) : -1;
          const groupMap: Record<string, { count: number; sum: number; min: number; max: number }> = {};

          filteredRows.forEach((r) => {
            const rawG = (r[gIdx] || '').trim();
            const gVal = rawG || '(Sin valor)';
            if (!groupMap[gVal]) {
              groupMap[gVal] = { count: 0, sum: 0, min: Infinity, max: -Infinity };
            }
            groupMap[gVal].count++;
            if (mIdx !== -1) {
              const val = parseFloat(r[mIdx]);
              if (!isNaN(val)) {
                groupMap[gVal].sum += val;
                if (val < groupMap[gVal].min) groupMap[gVal].min = val;
                if (val > groupMap[gVal].max) groupMap[gVal].max = val;
              }
            }
          });

          let metricName = 'total_registros';
          if (aggFunc !== 'COUNT' && aggCol) {
            metricName = `${aggFunc.toLowerCase()}_${aggCol.toLowerCase().replace(/[^a-z0-9]+/g, '_')}`;
          }

          const groupedEntries = Object.entries(groupMap).map(([k, stats]) => {
            let metricVal = 0;
            switch (aggFunc) {
              case 'COUNT':
                metricVal = stats.count;
                break;
              case 'SUM':
                metricVal = Math.round(stats.sum * 100) / 100;
                break;
              case 'AVG':
                metricVal = stats.count > 0 ? Math.round((stats.sum / stats.count) * 100) / 100 : 0;
                break;
              case 'MIN':
                metricVal = stats.min === Infinity ? 0 : stats.min;
                break;
              case 'MAX':
                metricVal = stats.max === -Infinity ? 0 : stats.max;
                break;
              default:
                metricVal = stats.count;
            }
            return [k, String(metricVal)];
          });

          // Ordenar entradas agrupadas
          groupedEntries.sort((a, b) => {
            const numA = parseFloat(a[1]);
            const numB = parseFloat(b[1]);
            if (!isNaN(numA) && !isNaN(numB)) {
              return orderDir === 'asc' ? numA - numB : numB - numA;
            }
            return orderDir === 'asc' ? a[0].localeCompare(b[0]) : b[0].localeCompare(a[0]);
          });

          activeQueryResult = {
            columns: [groupCol, metricName],
            rows: groupedEntries.slice(offset, offset + pageSize),
            total_count: groupedEntries.length,
          };

          if (recordInfo) {
            recordInfo.textContent = `Agrupado por ${groupCol}: ${groupedEntries.length} grupos (${aggFunc})`;
          }

          // Auto-vincular categoría y métrica para el gráfico
          selectedChartCat = groupCol;
          selectedChartMetric = metricName;

          renderCurrentView();
          return;
        }

        // 3. Sin agrupación: ordenación estándar y paginación
        if (sortCol) {
          const sIdx = parsedTable.columns.indexOf(sortCol);
          if (sIdx !== -1) {
            filteredRows = [...filteredRows].sort((a, b) => {
              const va = a[sIdx] || '';
              const vb = b[sIdx] || '';
              const na = parseFloat(va);
              const nb = parseFloat(vb);
              if (!isNaN(na) && !isNaN(nb)) {
                return sortDir === 'asc' ? na - nb : nb - na;
              }
              return sortDir === 'asc' ? va.localeCompare(vb) : vb.localeCompare(va);
            });
          }
        }

        activeQueryResult = {
          columns: parsedTable.columns,
          rows: filteredRows.slice(offset, offset + pageSize),
          total_count: filteredRows.length,
        };

        if (recordInfo) {
          if (searchKeyword || selectedCol) {
            recordInfo.textContent = `Filtro aplicado: ${filteredRows.length} de ${parsedTable.rows.length} registros`;
          } else {
            recordInfo.textContent = `Mostrando ${Math.min(offset + 1, filteredRows.length)} - ${Math.min(offset + pageSize, filteredRows.length)} de ${filteredRows.length} registros`;
          }
        }

        renderCurrentView();
      }

      // Run SQL (DuckDB Local o Backend MCP)
      sqlRunBtn?.addEventListener('click', async () => {
        const sql = sqlInput?.value.trim() || '';
        if (!sql) return;

        const useMcp = isMcpEnabled() && (mcpModeCheckbox?.checked ?? false);

        if (useMcp) {
          try {
            sqlRunBtn.disabled = true;
            sqlRunBtn.textContent = 'Consultando MCP...';
            const mcpRes = await datameshMcp.querySql(sql, {
              catalog: 'catalogo-datamesh',
              dataset: container.getAttribute('data-dataset') || undefined,
              resource: triad || undefined,
            });
            activeQueryResult = {
              columns: mcpRes.columns,
              rows: mcpRes.rows.map((r) => r.map((c) => String(c ?? ''))),
              total_count: mcpRes.row_count,
            };
            currentPage = 1;
            renderCurrentView();
            if (recordInfo) {
              recordInfo.textContent = `Backend MCP: ${mcpRes.row_count} registros devueltos`;
            }
          } catch (mcpErr: any) {
            alert(`Backend MCP no disponible (${mcpErr?.message || mcpErr}). Evaluando en DuckDB local...`);
            runDuckDbLocal(sql);
          } finally {
            sqlRunBtn.disabled = false;
            sqlRunBtn.textContent = 'Ejecutar SQL';
          }
        } else {
          runDuckDbLocal(sql);
        }
      });

      async function runDuckDbLocal(sql: string) {
        if (!parsedTable) {
          await fetchViaTypeScriptClient();
          if (!parsedTable) return;
        }

        try {
          const sqlRes = await client.sql(sql, parsedTable, triad);
          activeQueryResult = {
            columns: sqlRes.columns,
            rows: sqlRes.rows,
            total_count: sqlRes.total_count,
          };
          currentPage = 1;
          renderCurrentView();
          if (recordInfo) {
            recordInfo.textContent = `DuckDB local: ${sqlRes.row_count} filas procesadas`;
          }
        } catch (e: any) {
          alert(`Error en consulta SQL DuckDB: ${e?.message}`);
        }
      }

      function renderTable() {
        if (!tableContainer || !activeQueryResult) return;

        const { columns, rows, total_count } = activeQueryResult;
        const totalPages = Math.max(1, Math.ceil(total_count / pageSize));
        if (currentPage > totalPages) currentPage = totalPages;

        const startIdx = (currentPage - 1) * pageSize;
        const endIdx = Math.min(startIdx + rows.length, total_count);

        if (recordInfo) {
          if (total_count === 0) {
            recordInfo.textContent = '0 registros encontrados';
          } else {
            recordInfo.textContent = `Mostrando ${startIdx + 1} - ${endIdx} de ${total_count} registros`;
          }
        }

        if (pageLabel) {
          pageLabel.textContent = `Página ${currentPage} de ${totalPages}`;
        }

        if (prevBtn) prevBtn.disabled = currentPage <= 1;
        if (nextBtn) nextBtn.disabled = currentPage >= totalPages;

        if (rows.length === 0) {
          tableContainer.innerHTML = `
            <div style="padding: 2.5rem; text-align: center; color: var(--color-text-muted); font-size: 0.85rem;">
              No se encontraron registros que coincidan con la búsqueda.
            </div>`;
          return;
        }

        let html = '<table><thead><tr>';
        columns.forEach((col) => {
          const isSorted = sortCol && sortCol.toLowerCase() === col.toLowerCase();
          const arrow = isSorted ? (sortDir === 'asc' ? ' &uarr;' : ' &darr;') : '';
          html += `<th data-col-name="${escapeHtml(col)}" title="Ordenar columna">${escapeHtml(col)}${arrow}</th>`;
        });
        html += '</tr></thead><tbody>';

        rows.forEach((row) => {
          html += '<tr>';
          columns.forEach((col, colIdx) => {
            const rawVal = row[colIdx] !== undefined ? String(row[colIdx]) : '';
            const labelsMap = columnValueLabels[col];
            let displayVal = rawVal;
            let titleAttr = rawVal;

            if (labelsMap && rawVal in labelsMap) {
              const labelText = labelsMap[rawVal];
              if (showSemanticLabels) {
                // Modo Etiquetas: muestra etiqueta y en tooltip el valor original
                displayVal = `<span class="cell-label">${escapeHtml(labelText)}</span> <span class="cell-raw-badge" style="font-size: 0.65rem; color: var(--color-text-muted); opacity: 0.7;">(${escapeHtml(rawVal)})</span>`;
                titleAttr = `Valor original: ${rawVal} | Etiqueta: ${labelText}`;
              } else {
                // Modo Bruto: muestra código en bruto y en tooltip la etiqueta
                displayVal = `<span class="cell-raw-code" style="font-family: var(--font-mono); font-weight: 600;">${escapeHtml(rawVal)}</span>`;
                titleAttr = `Código: ${rawVal} (Significado: ${labelText})`;
              }
            } else {
              displayVal = escapeHtml(rawVal);
            }

            html += `<td title="${escapeHtml(titleAttr)}">${displayVal}</td>`;
          });
          html += '</tr>';
        });

        html += '</tbody></table>';
        tableContainer.innerHTML = html;

        // Sorting on header click
        tableContainer.querySelectorAll('th').forEach((th) => {
          th.addEventListener('click', () => {
            const colName = th.getAttribute('data-col-name');
            if (!colName) return;
            if (sortCol?.toLowerCase() === colName.toLowerCase()) {
              sortDir = sortDir === 'asc' ? 'desc' : 'asc';
            } else {
              sortCol = colName;
              sortDir = 'asc';
            }
            executeClientQuery();
          });
        });
      }

      const BOLIVIA_DEPT_NAMES: Record<string, string> = {
        '1': 'Chuquisaca', '2': 'La Paz', '3': 'Cochabamba', '4': 'Oruro',
        '5': 'Potosí', '6': 'Tarija', '7': 'Santa Cruz', '8': 'Beni', '9': 'Pando'
      };

      const BOLIVIA_DEPT_CENTROIDS: Record<string, [number, number]> = {
        'la paz': [-16.5, -68.15],
        'santa cruz': [-17.8, -63.18],
        'cochabamba': [-17.38, -66.16],
        'oruro': [-17.98, -67.11],
        'potosi': [-19.58, -65.75],
        'potosí': [-19.58, -65.75],
        'chuquisaca': [-19.03, -65.26],
        'tarija': [-21.53, -64.73],
        'beni': [-14.83, -64.9],
        'pando': [-11.02, -68.76],
      };

      let selectedChartCat: string | null = null;
      let selectedChartMetric: string | null = null;

      function renderMap() {
        if (!mapContainer || !parsedTable) return;
        const { columns, rows } = parsedTable;

        // Poblar selects de coordenadas si no están poblados
        if (mapLatSelect && mapLatSelect.options.length <= 1) {
          mapLatSelect.innerHTML = '<option value="">Auto-detectar</option>' +
            columns.map((c) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
        }
        if (mapLonSelect && mapLonSelect.options.length <= 1) {
          mapLonSelect.innerHTML = '<option value="">Auto-detectar</option>' +
            columns.map((c) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
        }
        if (mapLabelSelect && mapLabelSelect.options.length <= 1) {
          mapLabelSelect.innerHTML = '<option value="">Auto-detectar</option>' +
            columns.map((c) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
        }

        // Detectar índices con fallback a selecciones explícitas del usuario
        let latIdx = selectedMapLat ? columns.indexOf(selectedMapLat) : -1;
        if (latIdx === -1) {
          latIdx = columns.findIndex((c) => /^(lat|latitude|latitud|lat_geo|y)$/i.test(c.trim()));
        }

        let lonIdx = selectedMapLon ? columns.indexOf(selectedMapLon) : -1;
        if (lonIdx === -1) {
          lonIdx = columns.findIndex((c) => /^(lon|lng|longitude|longitud|lon_geo|x)$/i.test(c.trim()));
        }

        let labelIdx = selectedMapLabel ? columns.indexOf(selectedMapLabel) : -1;
        if (labelIdx === -1) {
          labelIdx = columns.findIndex((c) => /(nombre|name|estacion|station|lugar|municipio|entidad|title|label|paf|entidad)/i.test(c.trim()));
        }

        const deptIdx = columns.findIndex((c) => /(departamento|depto|ciudad|region|id_departamento|nameDepartment)/i.test(c.trim()));

        // Sincronizar selectores con los valores detectados si estaban vacíos
        if (mapLatSelect && latIdx !== -1 && !mapLatSelect.value) {
          mapLatSelect.value = columns[latIdx];
        }
        if (mapLonSelect && lonIdx !== -1 && !mapLonSelect.value) {
          mapLonSelect.value = columns[lonIdx];
        }
        if (mapLabelSelect && labelIdx !== -1 && !mapLabelSelect.value) {
          mapLabelSelect.value = columns[labelIdx];
        }

        const mapEl = mapContainer.querySelector<HTMLElement>('.leaflet-map-element');
        const countEl = mapContainer.querySelector<HTMLElement>('.map-points-count');
        const deptEl = mapContainer.querySelector<HTMLElement>('.map-department-breakdown');
        if (!mapEl) return;

        // Inicializar Leaflet map sólo una vez
        if (!leafletMap) {
          leafletMap = L.map(mapEl, {
            center: [-16.5, -64.5],
            zoom: 6,
            scrollWheelZoom: false,
          });

          L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 18,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a>',
          }).addTo(leafletMap);

          leafletLayerGroup = L.layerGroup().addTo(leafletMap);
        }

        if (leafletLayerGroup) {
          leafletLayerGroup.clearLayers();
        }

        // 1. Mapeo de coordenadas puntuales (lat / lon)
        if (latIdx !== -1 && lonIdx !== -1) {
          const points = rows
            .map((r, i) => {
              const lat = parseFloat(r[latIdx]);
              const lon = parseFloat(r[lonIdx]);
              const label = labelIdx !== -1 ? (r[labelIdx] || `Punto ${i + 1}`) : `Punto ${i + 1}`;
              const dept = deptIdx !== -1 ? (r[deptIdx] || '') : '';
              return { lat, lon, label, dept };
            })
            .filter((p) => !isNaN(p.lat) && !isNaN(p.lon) && p.lat >= -25 && p.lat <= -9 && p.lon >= -72 && p.lon <= -55);

          if (points.length > 0) {
            if (countEl) countEl.textContent = `${points.length} ubicaciones georreferenciadas (${columns[latIdx]}, ${columns[lonIdx]})`;

            const bounds: L.LatLngExpression[] = [];
            points.slice(0, 1000).forEach((p) => {
              bounds.push([p.lat, p.lon]);
              const marker = L.circleMarker([p.lat, p.lon], {
                radius: 6,
                fillColor: '#0284c7',
                color: '#ffffff',
                weight: 1.5,
                opacity: 1,
                fillOpacity: 0.85,
              });

              const popupContent = `
                <div style="font-family: var(--font-sans); font-size: 0.8rem; line-height: 1.4;">
                  <div style="font-weight: 600; color: var(--color-text); margin-bottom: 0.25rem;">${escapeHtml(p.label)}</div>
                  ${p.dept ? `<div style="font-size: 0.72rem; color: var(--color-text-muted); font-family: var(--font-mono);">${escapeHtml(p.dept)}</div>` : ''}
                  <div style="font-size: 0.7rem; color: var(--color-text-muted); margin-top: 0.25rem; font-family: var(--font-mono);">
                    ${p.lat.toFixed(4)}&deg; S, ${p.lon.toFixed(4)}&deg; O
                  </div>
                </div>
              `;
              marker.bindPopup(popupContent);
              leafletLayerGroup?.addLayer(marker);
            });

            if (bounds.length > 0) {
              leafletMap.fitBounds(L.latLngBounds(bounds), { padding: [25, 25], maxZoom: 14 });
            }

            if (deptEl) {
              deptEl.innerHTML = '';
            }

            setTimeout(() => leafletMap?.invalidateSize(), 80);
            return;
          }
        }

        // 2. Mapeo por departamentos bolivianos
        if (deptIdx !== -1) {
          const counts: Record<string, number> = {};
          rows.forEach((r) => {
            const raw = (r[deptIdx] || '').trim();
            const norm = BOLIVIA_DEPT_NAMES[raw] || raw || 'Sin clasificar';
            counts[norm] = (counts[norm] || 0) + 1;
          });

          const sorted = Object.entries(counts).sort((a, b) => b[1] - a[1]);
          const maxCount = Math.max(...sorted.map((s) => s[1]), 1);

          if (countEl) countEl.textContent = `Distribución departamental (${sorted.length} regiones)`;

          sorted.forEach(([dept, count]) => {
            const cleanKey = dept.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
            const centroid = BOLIVIA_DEPT_CENTROIDS[cleanKey] || BOLIVIA_DEPT_CENTROIDS[dept.toLowerCase()];
            if (centroid) {
              const radius = Math.max(7, Math.min(28, (count / maxCount) * 24 + 7));
              const marker = L.circleMarker(centroid, {
                radius,
                fillColor: '#0284c7',
                color: '#ffffff',
                weight: 2,
                opacity: 1,
                fillOpacity: 0.8,
              });

              const popupContent = `
                <div style="font-family: var(--font-sans); font-size: 0.825rem;">
                  <strong style="color: var(--color-text);">${escapeHtml(dept)}</strong>
                  <div style="font-family: var(--font-mono); font-size: 0.75rem; color: #0284c7; margin-top: 0.2rem; font-weight: 600;">
                    ${count.toLocaleString()} registros (${((count / rows.length) * 100).toFixed(1)}%)
                  </div>
                </div>
              `;
              marker.bindPopup(popupContent);
              leafletLayerGroup?.addLayer(marker);
            }
          });

          leafletMap.setView([-16.5, -64.5], 6);

          if (deptEl) {
            const itemsHtml = sorted.map(([dept, count]) => {
              const pct = ((count / maxCount) * 100).toFixed(0);
              return `
                <div style="display: grid; grid-template-columns: 110px 1fr 60px; align-items: center; gap: 0.5rem; font-size: 0.78rem; font-family: var(--font-mono);">
                  <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--color-text);">${escapeHtml(dept)}</span>
                  <div style="background: var(--color-surface-hover); height: 8px; border-radius: 2px; overflow: hidden; border: 1px solid var(--color-border);">
                    <div style="width: ${pct}%; height: 100%; background: var(--color-primary);"></div>
                  </div>
                  <span style="text-align: right; font-weight: 600; color: var(--color-text);">${count.toLocaleString()}</span>
                </div>
              `;
            }).join('');

            deptEl.innerHTML = `
              <div style="padding-top: 0.75rem; border-top: 1px dashed var(--color-border);">
                <div style="font-size: 0.75rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.5rem; font-family: var(--font-mono);">
                  Desglose Territorial (${escapeHtml(columns[deptIdx])}):
                </div>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0.45rem;">
                  ${itemsHtml}
                </div>
              </div>
            `;
          }

          setTimeout(() => leafletMap?.invalidateSize(), 80);
          return;
        }

        // 3. Ni coordenadas ni departamento
        if (countEl) countEl.textContent = 'Sin atributos espaciales';
        if (deptEl) {
          deptEl.innerHTML = `
            <div style="padding: 1.5rem; text-align: center; color: var(--color-text-muted); font-size: 0.8rem;">
              Selecciona manualmente en los controles superiores las columnas que contienen la <strong>Latitud</strong> y <strong>Longitud</strong>.
            </div>
          `;
        }
      }

      function renderChart() {
        if (!chartContainer) return;
        const currentData = activeQueryResult || (parsedTable ? { columns: parsedTable.columns, rows: parsedTable.rows, total_count: parsedTable.rows.length } : null);
        if (!currentData || !currentData.columns || currentData.columns.length === 0) {
          chartContainer.innerHTML = `
            <div style="padding: 2.5rem; text-align: center; color: var(--color-text-muted); font-size: 0.85rem;">
              No hay datos para graficar. Carga un recurso o ejecuta una consulta primero.
            </div>`;
          return;
        }

        const { columns, rows, total_count } = currentData;
        if (rows.length === 0) {
          chartContainer.innerHTML = `
            <div style="padding: 2.5rem; text-align: center; color: var(--color-text-muted); font-size: 0.85rem;">
              La consulta actual no devolvió registros para graficar.
            </div>`;
          return;
        }

        // Identificar columnas cuantitativas
        const isNumericCol = (cIdx: number) => {
          let numCount = 0;
          for (let r = 0; r < Math.min(rows.length, 15); r++) {
            const v = parseFloat(rows[r][cIdx]);
            if (!isNaN(v)) numCount++;
          }
          return numCount >= Math.min(rows.length, 2);
        };

        const isIdOrCoordCol = (colName: string) => {
          return /^(id|_id|id_|codigo|code|lat|latitude|latitud|lon|longitude|longitud)$/i.test(colName.trim());
        };

        const numericCols = columns.filter((col, idx) => isNumericCol(idx) && !isIdOrCoordCol(col));

        // Auto-selección inteligente de dimensión (categoría) y métrica
        if (!selectedChartCat || !columns.includes(selectedChartCat)) {
          selectedChartCat = columns[0];
        }

        if (!selectedChartMetric || (!columns.includes(selectedChartMetric) && selectedChartMetric !== '__count__')) {
          if (columns.length >= 2 && (numericCols.includes(columns[1]) || !isNaN(parseFloat(rows[0]?.[1])))) {
            selectedChartMetric = columns[1];
          } else {
            selectedChartMetric = numericCols.length > 0 ? numericCols[0] : '__count__';
          }
        }

        const catCol = selectedChartCat;
        const metricCol = selectedChartMetric;
        const catIdx = columns.indexOf(catCol);
        const metricIdx = metricCol === '__count__' ? -1 : columns.indexOf(metricCol);

        // Agregación de datos a partir de rows
        const groups: Record<string, { sum: number; count: number }> = {};
        const isIdDept = /^id_departamento$/i.test(catCol);

        rows.forEach((r) => {
          let key = (r[catIdx] || '').trim();
          if (isIdDept && BOLIVIA_DEPT_NAMES[key]) {
            key = BOLIVIA_DEPT_NAMES[key];
          } else if (!key) {
            key = '(Sin dato)';
          }

          if (!groups[key]) {
            groups[key] = { sum: 0, count: 0 };
          }
          groups[key].count += 1;

          if (metricIdx !== -1) {
            const v = parseFloat(r[metricIdx]);
            if (!isNaN(v)) {
              groups[key].sum += v;
            }
          }
        });

        const isCountMetric = metricCol === '__count__';
        const isAlreadyAggregated = rows.length <= 100 && metricIdx !== -1;

        let processedData = Object.entries(groups).map(([label, g]) => {
          let val = 0;
          if (isCountMetric) {
            val = g.count;
          } else if (isAlreadyAggregated && g.count === 1) {
            val = g.sum;
          } else {
            val = g.count > 0 ? Math.round((g.sum / g.count) * 100) / 100 : 0;
          }
          return { label, val };
        });

        // Ordenamiento
        processedData.sort((a, b) => b.val - a.val);

        const totalItemsCount = processedData.length;
        const sliceLimit = chartTopN === 'all' ? totalItemsCount : chartTopN;
        const chartData = processedData.slice(0, sliceLimit);

        // Métricas estadísticas para KPI Cards
        const totalSum = processedData.reduce((acc, d) => acc + d.val, 0);
        const maxVal = chartData.length > 0 ? Math.max(...chartData.map((d) => d.val)) : 0;
        const minVal = chartData.length > 0 ? Math.min(...chartData.map((d) => d.val)) : 0;
        const avgVal = chartData.length > 0 ? Math.round((totalSum / chartData.length) * 10) / 10 : 0;
        const topItem = chartData[0];
        const bottomItem = chartData[chartData.length - 1];

        const metricLabel = isCountMetric ? 'Conteo de registros' : `${escapeHtml(metricCol)}`;

        // Generar SVG según el tipo de gráfico
        let svgContent = '';
        const w = 620;
        const DONUT_COLORS = ['#0284c7', '#06b6d4', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899', '#f97316', '#6366f1', '#14b8a6', '#64748b', '#84cc16', '#e11d48'];

        if (currentChartType === 'bar-h') {
          // 1. BARRAS HORIZONTALES
          const labelW = 160;
          const padT = 24, padB = 24;
          const trackW = w - labelW - 100;
          const rowH = 26;
          const contentH = chartData.length * rowH;
          const totalH = padT + contentH + padB;
          const safeMax = Math.max(maxVal, 0.0001);

          const gridSvg = [0, 0.5, 1].map((t) => {
            const gx = (labelW + t * trackW).toFixed(1);
            const v = Math.round(t * safeMax);
            return `
              <line x1="${gx}" y1="${padT}" x2="${gx}" y2="${padT + contentH}" stroke="var(--color-border)" stroke-width="0.5" stroke-dasharray="3,3"/>
              <text x="${gx}" y="${padT - 7}" font-size="8" font-family="var(--font-mono)" fill="var(--color-text-muted)" text-anchor="middle">${v.toLocaleString()}</text>
            `;
          }).join('');

          const barsSvg = chartData.map((d, i) => {
            const y = padT + i * rowH;
            const bw = Math.max(2, (d.val / safeMax) * trackW);
            const lbl = d.label.length > 20 ? d.label.slice(0, 19) + '…' : d.label;
            return `
              <text x="${labelW - 10}" y="${y + 14}" text-anchor="end" font-size="9" font-family="var(--font-mono)" fill="var(--color-text)">${escapeHtml(lbl)}</text>
              <rect x="${labelW}" y="${y + 3}" width="${trackW}" height="15" rx="3" fill="var(--color-surface-hover)" stroke="var(--color-border)" stroke-width="0.5"/>
              <rect x="${labelW}" y="${y + 3}" width="${bw.toFixed(1)}" height="15" rx="3" fill="var(--color-primary)">
                <title>${escapeHtml(d.label)}: ${d.val.toLocaleString()}</title>
              </rect>
              <text x="${(labelW + bw + 6).toFixed(1)}" y="${y + 14}" font-size="9" font-family="var(--font-mono)" fill="var(--color-text)" font-weight="600">${d.val.toLocaleString()}</text>
            `;
          }).join('');

          svgContent = `
            <svg viewBox="0 0 ${w} ${totalH}" class="chart-svg-element" style="width: 100%; display: block;" xmlns="http://www.w3.org/2000/svg">
              ${gridSvg}
              <line x1="${labelW}" y1="${padT}" x2="${labelW}" y2="${padT + contentH}" stroke="var(--color-text-muted)" stroke-width="1.5"/>
              ${barsSvg}
            </svg>
          `;
        } else if (currentChartType === 'bar-v') {
          // 2. COLUMNAS VERTICALES
          const padL = 45, padR = 25, padT = 30, padB = 65;
          const totalH = 270;
          const chartH = totalH - padT - padB;
          const availW = w - padL - padR;
          const colCount = chartData.length;
          const colStep = availW / Math.max(colCount, 1);
          const barW = Math.max(10, Math.min(36, colStep - 6));
          const safeMax = Math.max(maxVal, 0.0001);

          const gridSvg = [0, 0.5, 1].map((t) => {
            const gy = (padT + (1 - t) * chartH).toFixed(1);
            const v = Math.round(t * safeMax);
            return `
              <line x1="${padL}" y1="${gy}" x2="${padL + availW}" y2="${gy}" stroke="var(--color-border)" stroke-width="0.5" stroke-dasharray="3,3"/>
              <text x="${padL - 8}" y="${parseFloat(gy) + 3}" font-size="8" font-family="var(--font-mono)" fill="var(--color-text-muted)" text-anchor="end">${v.toLocaleString()}</text>
            `;
          }).join('');

          const colsSvg = chartData.map((d, i) => {
            const cx = padL + i * colStep + (colStep - barW) / 2;
            const bh = Math.max(2, (d.val / safeMax) * chartH);
            const by = padT + chartH - bh;
            const lbl = d.label.length > 12 ? d.label.slice(0, 11) + '…' : d.label;
            const textX = cx + barW / 2;
            const textY = padT + chartH + 14;
            return `
              <rect x="${cx.toFixed(1)}" y="${by.toFixed(1)}" width="${barW.toFixed(1)}" height="${bh.toFixed(1)}" rx="3" fill="var(--color-primary)">
                <title>${escapeHtml(d.label)}: ${d.val.toLocaleString()}</title>
              </rect>
              <text x="${textX.toFixed(1)}" y="${(by - 5).toFixed(1)}" font-size="8" font-family="var(--font-mono)" fill="var(--color-text)" font-weight="600" text-anchor="middle">${d.val.toLocaleString()}</text>
              <text x="${textX.toFixed(1)}" y="${textY}" font-size="8" font-family="var(--font-mono)" fill="var(--color-text-muted)" text-anchor="end" transform="rotate(-35, ${textX.toFixed(1)}, ${textY})">${escapeHtml(lbl)}</text>
            `;
          }).join('');

          svgContent = `
            <svg viewBox="0 0 ${w} ${totalH}" class="chart-svg-element" style="width: 100%; display: block;" xmlns="http://www.w3.org/2000/svg">
              ${gridSvg}
              <line x1="${padL}" y1="${padT + chartH}" x2="${padL + availW}" y2="${padT + chartH}" stroke="var(--color-text-muted)" stroke-width="1.5"/>
              ${colsSvg}
            </svg>
          `;
        } else if (currentChartType === 'line') {
          // 3. LÍNEAS / TENDENCIA
          const padL = 45, padR = 25, padT = 30, padB = 65;
          const totalH = 260;
          const chartH = totalH - padT - padB;
          const availW = w - padL - padR;
          const count = chartData.length;
          const safeMax = Math.max(maxVal, 0.0001);

          const step = count > 1 ? availW / (count - 1) : availW;
          const pts = chartData.map((d, i) => {
            const x = padL + (count > 1 ? i * step : availW / 2);
            const y = padT + (1 - d.val / safeMax) * chartH;
            return { x, y, label: d.label, val: d.val };
          });

          const polyPoints = pts.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
          const baselineY = padT + chartH;
          const areaPoints = `${pts[0].x.toFixed(1)},${baselineY} ${polyPoints} ${pts[pts.length - 1].x.toFixed(1)},${baselineY}`;

          const gridSvg = [0, 0.5, 1].map((t) => {
            const gy = (padT + (1 - t) * chartH).toFixed(1);
            const v = Math.round(t * safeMax);
            return `
              <line x1="${padL}" y1="${gy}" x2="${padL + availW}" y2="${gy}" stroke="var(--color-border)" stroke-width="0.5" stroke-dasharray="3,3"/>
              <text x="${padL - 8}" y="${parseFloat(gy) + 3}" font-size="8" font-family="var(--font-mono)" fill="var(--color-text-muted)" text-anchor="end">${v.toLocaleString()}</text>
            `;
          }).join('');

          const nodesSvg = pts.map((p) => {
            const lbl = p.label.length > 12 ? p.label.slice(0, 11) + '…' : p.label;
            const textY = baselineY + 14;
            return `
              <circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="4" fill="#ffffff" stroke="var(--color-primary)" stroke-width="2">
                <title>${escapeHtml(p.label)}: ${p.val.toLocaleString()}</title>
              </circle>
              <text x="${p.x.toFixed(1)}" y="${(p.y - 8).toFixed(1)}" font-size="8" font-family="var(--font-mono)" fill="var(--color-text)" font-weight="600" text-anchor="middle">${p.val.toLocaleString()}</text>
              <text x="${p.x.toFixed(1)}" y="${textY}" font-size="8" font-family="var(--font-mono)" fill="var(--color-text-muted)" text-anchor="end" transform="rotate(-35, ${textX || p.x.toFixed(1)}, ${textY})">${escapeHtml(lbl)}</text>
            `;
          }).join('');

          svgContent = `
            <svg viewBox="0 0 ${w} ${totalH}" class="chart-svg-element" style="width: 100%; display: block;" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="chartLineGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" stop-color="var(--color-primary)" stop-opacity="0.35"/>
                  <stop offset="100%" stop-color="var(--color-primary)" stop-opacity="0.0"/>
                </linearGradient>
              </defs>
              ${gridSvg}
              <polygon points="${areaPoints}" fill="url(#chartLineGrad)"/>
              <polyline points="${polyPoints}" fill="none" stroke="var(--color-primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <line x1="${padL}" y1="${baselineY}" x2="${padL + availW}" y2="${baselineY}" stroke="var(--color-text-muted)" stroke-width="1.5"/>
              ${nodesSvg}
            </svg>
          `;
        } else if (currentChartType === 'donut') {
          // 4. DONUT / PASTEL
          const totalH = 260;
          const cx = 135, cy = 130;
          const R = 90, r = 50;
          const safeSum = Math.max(totalSum, 0.0001);

          let currentAngle = -Math.PI / 2;
          const slicesSvg: string[] = [];
          const legendSvg: string[] = [];

          chartData.forEach((d, i) => {
            const sliceAngle = (d.val / safeSum) * (2 * Math.PI);
            const startA = currentAngle;
            const endA = currentAngle + sliceAngle;
            currentAngle = endA;

            const x1 = cx + R * Math.cos(startA);
            const y1 = cy + R * Math.sin(startA);
            const x2 = cx + R * Math.cos(endA);
            const y2 = cy + R * Math.sin(endA);

            const x3 = cx + r * Math.cos(endA);
            const y3 = cy + r * Math.sin(endA);
            const x4 = cx + r * Math.cos(startA);
            const y4 = cy + r * Math.sin(startA);

            const largeArc = sliceAngle > Math.PI ? 1 : 0;
            const color = DONUT_COLORS[i % DONUT_COLORS.length];
            const pct = ((d.val / safeSum) * 100).toFixed(1);

            slicesSvg.push(`
              <path d="M ${x1.toFixed(2)} ${y1.toFixed(2)} A ${R} ${R} 0 ${largeArc} 1 ${x2.toFixed(2)} ${y2.toFixed(2)} L ${x3.toFixed(2)} ${y3.toFixed(2)} A ${r} ${r} 0 ${largeArc} 0 ${x4.toFixed(2)} ${y4.toFixed(2)} Z" fill="${color}" stroke="var(--color-surface)" stroke-width="1.5">
                <title>${escapeHtml(d.label)}: ${d.val.toLocaleString()} (${pct}%)</title>
              </path>
            `);

            // Leyenda a la derecha
            const legY = 25 + i * 22;
            if (legY < totalH - 15) {
              const lbl = d.label.length > 18 ? d.label.slice(0, 17) + '…' : d.label;
              legendSvg.push(`
                <rect x="285" y="${legY - 9}" width="10" height="10" rx="2" fill="${color}"/>
                <text x="303" y="${legY}" font-size="8.5" font-family="var(--font-mono)" fill="var(--color-text)">${escapeHtml(lbl)}</text>
                <text x="${w - 20}" y="${legY}" font-size="8.5" font-family="var(--font-mono)" font-weight="600" fill="var(--color-primary)" text-anchor="end">${d.val.toLocaleString()} (${pct}%)</text>
              `);
            }
          });

          svgContent = `
            <svg viewBox="0 0 ${w} ${totalH}" class="chart-svg-element" style="width: 100%; display: block;" xmlns="http://www.w3.org/2000/svg">
              ${slicesSvg.join('')}
              <circle cx="${cx}" cy="${cy}" r="${r - 1}" fill="var(--color-surface)"/>
              <text x="${cx}" y="${cy - 4}" font-size="10" font-family="var(--font-mono)" font-weight="700" fill="var(--color-primary)" text-anchor="middle">TOTAL</text>
              <text x="${cx}" y="${cy + 12}" font-size="9" font-family="var(--font-mono)" fill="var(--color-text)" font-weight="600" text-anchor="middle">${totalSum.toLocaleString()}</text>
              ${legendSvg.join('')}
            </svg>
          `;
        }

        // Renderizado del panel de controles y contenedor
        const catOptions = columns.map(c => `<option value="${escapeHtml(c)}"${c === selectedChartCat ? ' selected' : ''}>${escapeHtml(c)}</option>`).join('');
        const metricOptions = [
          `<option value="__count__"${selectedChartMetric === '__count__' ? ' selected' : ''}>Conteo de registros (Frecuencia)</option>`,
          ...numericCols.map(c => `<option value="${escapeHtml(c)}"${c === selectedChartMetric ? ' selected' : ''}>${escapeHtml(c)}</option>`)
        ].join('');

        const topNOptions = [5, 10, 15, 25].map(n => `<option value="${n}"${chartTopN === n ? ' selected' : ''}>Top ${n}</option>`).join('') +
          `<option value="all"${chartTopN === 'all' ? ' selected' : ''}>Todos (${totalItemsCount})</option>`;

        chartContainer.innerHTML = `
          <!-- Toolbar Superior de Gráfico -->
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.85rem; flex-wrap: wrap; gap: 0.6rem; padding-bottom: 0.65rem; border-bottom: 1px solid var(--color-border);">
            <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
              <!-- Selector de tipo de gráfico -->
              <div class="chart-type-toolbar" role="group" aria-label="Tipo de Gráfico">
                <button type="button" class="chart-type-btn ${currentChartType === 'bar-h' ? 'active' : ''}" data-chart-type="bar-h" title="Barras Horizontales">
                  <span>📊 Barras H</span>
                </button>
                <button type="button" class="chart-type-btn ${currentChartType === 'bar-v' ? 'active' : ''}" data-chart-type="bar-v" title="Columnas Verticales">
                  <span>📶 Columnas V</span>
                </button>
                <button type="button" class="chart-type-btn ${currentChartType === 'line' ? 'active' : ''}" data-chart-type="line" title="Línea / Tendencia">
                  <span>📈 Línea</span>
                </button>
                <button type="button" class="chart-type-btn ${currentChartType === 'donut' ? 'active' : ''}" data-chart-type="donut" title="Gráfico de Dona">
                  <span>🍩 Dona</span>
                </button>
              </div>

              <!-- Selectores de Dimensión y Métrica -->
              <label style="font-size: 0.725rem; font-family: var(--font-mono); color: var(--color-text-muted); display: inline-flex; align-items: center; gap: 0.25rem;">
                Eje X:
                <select class="chart-selector-cat" style="font-size: 0.725rem; padding: 0.2rem 0.45rem; font-family: var(--font-mono); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-text);">
                  ${catOptions}
                </select>
              </label>

              <label style="font-size: 0.725rem; font-family: var(--font-mono); color: var(--color-text-muted); display: inline-flex; align-items: center; gap: 0.25rem;">
                Métrica:
                <select class="chart-selector-metric" style="font-size: 0.725rem; padding: 0.2rem 0.45rem; font-family: var(--font-mono); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-text);">
                  ${metricOptions}
                </select>
              </label>

              <select class="chart-selector-topn" style="font-size: 0.725rem; padding: 0.2rem 0.45rem; font-family: var(--font-mono); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-text);">
                ${topNOptions}
              </select>
            </div>

            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <button type="button" class="btn btn-secondary btn-sm chart-export-svg-btn" style="font-size: 0.725rem; padding: 0.2rem 0.55rem;" title="Descargar imagen SVG vectorial del gráfico">
                ⬇ Exportar SVG
              </button>
            </div>
          </div>

          <!-- Resumen Estadístico Rápido (KPI Cards) -->
          <div class="chart-kpi-grid">
            <div class="chart-kpi-card">
              <span class="chart-kpi-title">Categorías / Grupos</span>
              <span class="chart-kpi-value">${chartData.length.toLocaleString()}</span>
              <span class="chart-kpi-subtitle">de ${totalItemsCount} total</span>
            </div>
            <div class="chart-kpi-card">
              <span class="chart-kpi-title">Valor Máximo</span>
              <span class="chart-kpi-value">${maxVal.toLocaleString()}</span>
              <span class="chart-kpi-subtitle">${topItem ? escapeHtml(topItem.label) : '-'}</span>
            </div>
            <div class="chart-kpi-card">
              <span class="chart-kpi-title">Valor Mínimo</span>
              <span class="chart-kpi-value">${minVal.toLocaleString()}</span>
              <span class="chart-kpi-subtitle">${bottomItem ? escapeHtml(bottomItem.label) : '-'}</span>
            </div>
            <div class="chart-kpi-card">
              <span class="chart-kpi-title">Promedio de Ítems</span>
              <span class="chart-kpi-value">${avgVal.toLocaleString()}</span>
              <span class="chart-kpi-subtitle">${escapeHtml(metricLabel)}</span>
            </div>
          </div>

          <!-- Lienzo Gráfico SVG Vectorial -->
          <div style="max-width: 640px; margin: 0 auto; overflow: hidden; background: var(--color-surface); border-radius: var(--radius-sm); padding: 0.5rem;">
            ${svgContent}
          </div>
        `;

        // Event listeners para los controles del gráfico
        chartContainer.querySelectorAll<HTMLButtonElement>('.chart-type-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            currentChartType = (btn.getAttribute('data-chart-type') || 'bar-h') as any;
            renderChart();
          });
        });

        chartContainer.querySelector('.chart-selector-cat')?.addEventListener('change', (e: any) => {
          selectedChartCat = e.target.value;
          renderChart();
        });

        chartContainer.querySelector('.chart-selector-metric')?.addEventListener('change', (e: any) => {
          selectedChartMetric = e.target.value;
          renderChart();
        });

        chartContainer.querySelector('.chart-selector-topn')?.addEventListener('change', (e: any) => {
          const val = e.target.value;
          chartTopN = val === 'all' ? 'all' : parseInt(val, 10);
          renderChart();
        });

        chartContainer.querySelector('.chart-export-svg-btn')?.addEventListener('click', () => {
          const svgEl = chartContainer.querySelector('.chart-svg-element');
          if (svgEl) {
            const svgData = new XMLSerializer().serializeToString(svgEl);
            const blob = new Blob([svgData], { type: 'image/svg+xml;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `grafico_${escapeHtml(catCol)}_${Date.now()}.svg`;
            a.click();
            URL.revokeObjectURL(url);
          }
        });
      }

      function renderErrorMessage(msg: string) {
        if (!tableContainer) return;
        if (mapContainer) mapContainer.style.display = 'none';
        if (chartContainer) chartContainer.style.display = 'none';
        if (paginationWrap) paginationWrap.style.display = 'none';
        tableContainer.style.display = 'block';
        tableContainer.innerHTML = `
          <div style="padding: 2rem 1.5rem; text-align: center; color: var(--color-text-muted);">
            <p style="margin-bottom: 0.5rem; font-weight: 600; color: var(--color-text);">
              El cliente web no pudo descargar este recurso directamente.
            </p>
            <p style="font-size: 0.8rem; margin-bottom: 1rem; line-height: 1.5;">
              Causa: ${escapeHtml(msg)}. El servidor remoto restringe solicitudes directas de navegador (CORS) o requiere autorización de sesión.
            </p>
            <p style="font-size: 0.825rem; margin-bottom: 0.75rem;">
              Puedes consultarlo sin restricciones de navegador utilizando el SDK y CLI de DataMesh:
            </p>
            <pre class="code-pre" style="margin: 0 auto; max-width: 550px; text-align: left; padding: 0.6rem 0.9rem;"><code class="language-bash">datamesh sql "SELECT * FROM '${triad}' LIMIT 10"</code></pre>
          </div>`;
      }

      function renderUnsupportedFormatMessage(formatName: string) {
        if (!tableContainer) return;
        if (mapContainer) mapContainer.style.display = 'none';
        if (chartContainer) chartContainer.style.display = 'none';
        if (paginationWrap) paginationWrap.style.display = 'none';
        tableContainer.style.display = 'block';
        tableContainer.innerHTML = `
          <div style="padding: 2rem 1.5rem; text-align: center; color: var(--color-text-muted);">
            <p style="margin-bottom: 0.5rem; font-weight: 600; color: var(--color-text);">
              Formato ${formatName} (Formato Columnar Binario)
            </p>
            <p style="font-size: 0.8rem; margin-bottom: 1rem; line-height: 1.5;">
              Los archivos Parquet son procesados en streaming con motor columnar local DuckDB a través del SDK / CLI de DataMesh.
            </p>
            <pre class="code-pre" style="margin: 0 auto; max-width: 550px; text-align: left; padding: 0.6rem 0.9rem;"><code class="language-bash">datamesh sql "SELECT * FROM '${triad}' LIMIT 10"</code></pre>
          </div>`;
      }

      function renderMultiFileWildcardMessage() {
        if (!tableContainer) return;
        if (mapContainer) mapContainer.style.display = 'none';
        if (chartContainer) chartContainer.style.display = 'none';
        if (paginationWrap) paginationWrap.style.display = 'none';
        tableContainer.style.display = 'block';
        tableContainer.innerHTML = `
          <div style="padding: 2.25rem 1.5rem; text-align: center; color: var(--color-text-muted); max-width: 620px; margin: 0 auto;">
            <div style="display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: var(--color-surface-hover); border: 1px solid var(--color-border); margin-bottom: 0.85rem; color: var(--color-primary);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
              </svg>
            </div>
            <p style="margin-bottom: 0.5rem; font-weight: 600; font-size: 1rem; color: var(--color-text);">
              Conjunto Particionado Multi-Archivo
            </p>
            <p style="font-size: 0.825rem; margin-bottom: 1.15rem; line-height: 1.5;">
              Este recurso abarca múltiples archivos particionados (<code>${escapeHtml(remoteUrl)}</code>). Conecta el servidor sovereign MCP local (<code>datamesh serve</code>) para unificarlos y explorarlos interactivamente:
            </p>
            <div style="background: var(--color-surface-hover); border: 1px solid var(--color-border); border-radius: 6px; padding: 0.65rem 0.9rem; margin-bottom: 1.25rem; font-family: var(--font-mono); font-size: 0.8rem; text-align: left; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;">
              <code>datamesh serve</code>
              <span style="font-size: 0.7rem; color: var(--color-text-muted);">Servidor Sovereign MCP (:8000)</span>
            </div>
            <div style="display: flex; gap: 0.65rem; justify-content: center; flex-wrap: wrap; margin-bottom: 1.25rem;">
              <button type="button" class="btn btn-primary btn-sm retry-mcp-multifile-btn">
                Explorar mediante Servidor MCP (:8000)
              </button>
            </div>
            <div style="margin: 0 auto; max-width: 580px; text-align: left; display: flex; flex-direction: column; gap: 0.65rem;">
              <pre class="code-pre" style="margin: 0; padding: 0.65rem 0.9rem;"><code class="language-bash">datamesh sql "SELECT * FROM '${triad}' LIMIT 25"</code></pre>
              <pre class="code-pre" style="margin: 0; padding: 0.65rem 0.9rem;"><code class="language-python">import datamesh as dm
df = dm.sql("SELECT * FROM '${triad}' LIMIT 25")</code></pre>
            </div>
          </div>`;

        tableContainer.querySelector('.retry-mcp-multifile-btn')?.addEventListener('click', async () => {
          // Si MCP no estaba habilitado en la UI, activarlo
          if (!isMcpEnabled()) {
            localStorage.setItem('datamesh_mcp_enabled', 'true');
            if (typeof window !== 'undefined') {
              window.dispatchEvent(new CustomEvent('datamesh:settings-changed', {
                detail: { mcpEnabled: true }
              }));
            }
          }
          fetchViaTypeScriptClient();
        });
      }

      function renderZipServerRequiredMessage(zipPath: string) {
        if (!tableContainer) return;
        if (mapContainer) mapContainer.style.display = 'none';
        if (chartContainer) chartContainer.style.display = 'none';
        if (paginationWrap) paginationWrap.style.display = 'none';
        tableContainer.style.display = 'block';
        const zipName = zipPath ? zipPath.split('/').pop()?.split('\\').pop() : 'archivo ZIP';
        tableContainer.innerHTML = `
          <div style="padding: 2.25rem 1.5rem; text-align: center; max-width: 620px; margin: 0 auto; color: var(--color-text);">
            <div style="display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: var(--color-surface-hover); border: 1px solid var(--color-border); margin-bottom: 0.85rem; color: var(--color-primary);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
            </div>
            <p style="font-size: 1.05rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--color-text);">
              Recurso en Contenedor ZIP (Backend Soberano Requerido)
            </p>
            <p style="font-size: 0.825rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 1.25rem;">
              Este recurso tabular está empaquetado dentro de <code>${escapeHtml(zipName || 'personas_municipios_csv.zip')}</code>. DuckDB ejecuta la extracción selectiva en memoria mediante el servidor sovereign local:
            </p>
            <div style="background: var(--color-surface-hover); border: 1px solid var(--color-border); border-radius: 6px; padding: 0.65rem 0.9rem; margin-bottom: 1.25rem; font-family: var(--font-mono); font-size: 0.8rem; text-align: left; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;">
              <code>datamesh serve</code>
              <span style="font-size: 0.7rem; color: var(--color-text-muted);">Inicia MCP en :8000</span>
            </div>
            <div style="display: flex; gap: 0.65rem; justify-content: center; flex-wrap: wrap;">
              <button type="button" class="btn btn-primary btn-sm retry-zip-mcp-btn">
                Reintentar con Servidor MCP (:8000)
              </button>
            </div>
          </div>
        `;

        tableContainer.querySelector('.retry-zip-mcp-btn')?.addEventListener('click', () => {
          fetchViaTypeScriptClient();
        });
      }

      function escapeHtml(str: string): string {
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      pageSizeSelect?.addEventListener('change', () => {
        pageSize = parseInt(pageSizeSelect.value, 10);
        updateBuilderPreview();
        currentPage = 1;
        executeClientQuery();
      });

      prevBtn?.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          executeClientQuery();
          tableContainer.scrollTop = 0;
        }
      });

      nextBtn?.addEventListener('click', () => {
        if (!parsedTable) return;
        const totalCount = activeQueryResult ? activeQueryResult.total_count : parsedTable.rows.length;
        const totalPages = Math.ceil(totalCount / pageSize);
        if (currentPage < totalPages) {
          currentPage++;
          executeClientQuery();
          tableContainer.scrollTop = 0;
        }
      });

      exportBtn?.addEventListener('click', () => {
        if (!parsedTable) return;
        let csv = parsedTable.columns.map((c) => `"${c.replace(/"/g, '""')}"`).join(',') + '\n';
        parsedTable.rows.forEach((row) => {
          csv += row.map((cell) => `"${(cell || '').replace(/"/g, '""')}"`).join(',') + '\n';
        });
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${triad.replace(/[^a-zA-Z0-9_-]/g, '_')}_export.csv`;
        a.click();
        URL.revokeObjectURL(url);
      });

      // Snippet copy buttons
      container.querySelectorAll('.copy-snippet-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const text = btn.getAttribute('data-copy') || '';
          try {
            await navigator.clipboard.writeText(text);
            const original = btn.innerHTML;
            btn.innerHTML = '<span>¡Copiado!</span>';
            setTimeout(() => {
              btn.innerHTML = original;
            }, 2000);
          } catch {
            // fallback
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupExplorers);
  } else {
    setupExplorers();
  }
</script>
