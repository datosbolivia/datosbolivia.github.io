<script>
  import { DataMeshClient, parseCsv, normalizeResourceUrl } from '@datosbolivia/datamesh-client';
  import { fetchWithCorsProxy, isCorsRestrictedDomain, setUserCustomProxy, getUserCustomProxy, getCorsProxyConfig, getActiveProxyTemplate } from '../lib/proxy';
  import { datameshMcp, isMcpEnabled } from '../lib/mcp';
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  // Usa DuckDB en cliente con catálogo por defecto de la misma página (origen actual /llms.txt)
  const client = new DataMeshClient({ engine: 'duckdb', proxyUrl: getActiveProxyTemplate() });

  // Escuchar cambios de configuración global
  if (typeof window !== 'undefined') {
    window.addEventListener('datamesh:settings-changed', (e: any) => {
      const { proxyTemplate, proxyEnabled } = e.detail || {};
      client.setProxy(proxyEnabled ? proxyTemplate : undefined);
    });
  }

  function setupExplorers() {
    const wrappers = document.querySelectorAll<HTMLElement>('[data-explorer-container]');

    wrappers.forEach((container) => {
      if (container.dataset.initialized) return;
      container.dataset.initialized = 'true';

      const remoteUrl = container.getAttribute('data-remote-url') || '';
      const containerUrl = container.getAttribute('data-container-url') || '';
      const innerPath = container.getAttribute('data-inner-path') || '';
      const triad = container.getAttribute('data-triad') || '';
      const format = container.getAttribute('data-format') || 'csv';
      const explorerId = container.id || 'explorer';

      const tabBtns = container.querySelectorAll<HTMLButtonElement>('.subnav-tab-btn');
      const tabPanes = container.querySelectorAll<HTMLElement>('.subtab-pane');
      const modeSwitchBtns = container.querySelectorAll<HTMLButtonElement>('.mode-switch-btn');
      const queryBuilderPanel = container.querySelector<HTMLElement>('.query-builder-panel');
      const builderColSelect = container.querySelector<HTMLSelectElement>('.builder-col');
      const builderOpSelect = container.querySelector<HTMLSelectElement>('.builder-op');
      const builderValInput = container.querySelector<HTMLInputElement>('.builder-val');
      const builderGroupColSelect = container.querySelector<HTMLSelectElement>('.builder-group-col');
      const builderAggFuncSelect = container.querySelector<HTMLSelectElement>('.builder-agg-func');
      const builderAggColSelect = container.querySelector<HTMLSelectElement>('.builder-agg-col');
      const builderOrderDirSelect = container.querySelector<HTMLSelectElement>('.builder-order-dir');
      const builderApplyBtn = container.querySelector<HTMLButtonElement>('.builder-apply-btn');
      const builderResetBtn = container.querySelector<HTMLButtonElement>('.builder-reset-btn');
      const builderToChartBtn = container.querySelector<HTMLButtonElement>('.builder-to-chart-btn');
      const builderSqlPreview = container.querySelector<HTMLElement>('.builder-sql-preview');
      const builderToSqlBtn = container.querySelector<HTMLButtonElement>('.builder-to-sql-btn');
      const toggleLabelsBtn = container.querySelector<HTMLButtonElement>('.toggle-labels-btn');
      const clientSqlBar = container.querySelector<HTMLElement>('.client-sql-bar');
      const mcpModeCheckbox = container.querySelector<HTMLInputElement>('.mcp-mode-checkbox');
      const sqlBackendStatus = container.querySelector<HTMLElement>('.sql-backend-status');
      const pageSizeSelect = container.querySelector<HTMLSelectElement>('.explorer-page-size');
      const exportBtn = container.querySelector<HTMLButtonElement>('.export-btn');
      const prevBtn = container.querySelector<HTMLButtonElement>('.pagination-prev');
      const nextBtn = container.querySelector<HTMLButtonElement>('.pagination-next');
      const pageLabel = container.querySelector<HTMLElement>('.pagination-page-label');
      const recordInfo = container.querySelector<HTMLElement>('.explorer-record-info');
      const tableContainer = container.querySelector<HTMLElement>('.explorer-table-container');
      const mapContainer = container.querySelector<HTMLElement>('.explorer-map-container');
      const chartContainer = container.querySelector<HTMLElement>('.explorer-chart-container');
      const viewModeBtns = container.querySelectorAll<HTMLButtonElement>('.view-mode-btn');
      const paginationWrap = container.querySelector<HTMLElement>('.explorer-pagination');
      const loadDirectBtn = container.querySelector<HTMLButtonElement>('.load-direct-btn');
      const sqlInput = container.querySelector<HTMLInputElement>('.client-sql-input');
      const sqlRunBtn = container.querySelector<HTMLButtonElement>('.client-sql-run-btn');
      const mapLatSelect = container.querySelector<HTMLSelectElement>('.map-lat-select');
      const mapLonSelect = container.querySelector<HTMLSelectElement>('.map-lon-select');
      const mapLabelSelect = container.querySelector<HTMLSelectElement>('.map-label-select');
      const mapApplyBtn = container.querySelector<HTMLButtonElement>('.map-apply-coords-btn');

      // Diccionario de etiquetas por columna desde schema
      let columnValueLabels: Record<string, Record<string, string>> = {};
      try {
        const rawLabelsAttr = container.getAttribute('data-labels') || '{}';
        columnValueLabels = JSON.parse(rawLabelsAttr);
      } catch {
        columnValueLabels = {};
      }
      let showSemanticLabels = true;

      let parsedTable: { columns: string[]; rows: string[][] } | null = null;
      let activeQueryResult: { columns: string[]; rows: string[][]; total_count: number } | null = null;
      let currentPage = 1;
      let pageSize = parseInt(pageSizeSelect?.value || '25', 10);
      let sortCol: string | undefined = undefined;
      let sortDir: 'asc' | 'desc' = 'asc';
      let isLoading = false;
      let currentViewMode: 'table' | 'map' | 'chart' = 'table';
      let leafletMap: L.Map | null = null;
      let leafletLayerGroup: L.LayerGroup | null = null;
      let selectedMapLat: string = '';
      let selectedMapLon: string = '';
      let selectedMapLabel: string = '';

      // Alternador de Etiquetas vs Datos en Bruto
      toggleLabelsBtn?.addEventListener('click', () => {
        showSemanticLabels = !showSemanticLabels;
        toggleLabelsBtn.classList.toggle('active', showSemanticLabels);
        const textSpan = toggleLabelsBtn.querySelector('.labels-btn-text');
        if (textSpan) {
          textSpan.textContent = showSemanticLabels ? 'Etiquetas' : 'Bruto';
        }
        toggleLabelsBtn.setAttribute('title', showSemanticLabels ? 'Mostrando etiquetas semánticas (clic para ver datos en bruto)' : 'Mostrando códigos y datos en bruto (clic para ver etiquetas)');
        renderCurrentView();
      });

      // Alternador de modos de vista (Tabla, Mapa, Gráfico)
      viewModeBtns.forEach((btn) => {
        btn.addEventListener('click', async () => {
          const mode = (btn.getAttribute('data-view-mode') || 'table') as 'table' | 'map' | 'chart';
          switchViewMode(mode);
        });
      });

      // Selector de modo de consulta: Filtro GUI vs SQL Query
      modeSwitchBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const mode = btn.getAttribute('data-filter-mode');
          modeSwitchBtns.forEach((b) => b.classList.toggle('active', b === btn));

          if (mode === 'gui') {
            if (queryBuilderPanel) queryBuilderPanel.style.display = 'flex';
            if (clientSqlBar) clientSqlBar.style.display = 'none';
          } else if (mode === 'sql') {
            if (queryBuilderPanel) queryBuilderPanel.style.display = 'none';
            if (clientSqlBar) clientSqlBar.style.display = 'flex';
            if (sqlInput) {
              const currentSql = generateBuilderSql();
              if (!sqlInput.value.trim() || sqlInput.value.includes('SELECT * FROM')) {
                sqlInput.value = currentSql;
              }
              sqlInput.focus();
            }
          }
        });
      });

      // Transferir consulta del visual query builder a editor SQL
      builderToSqlBtn?.addEventListener('click', () => {
        const generatedSql = generateBuilderSql();
        if (sqlInput) {
          sqlInput.value = generatedSql;
        }
        const sqlTabBtn = container.querySelector<HTMLButtonElement>('.mode-switch-btn[data-filter-mode="sql"]');
        if (sqlTabBtn) {
          sqlTabBtn.click();
        } else {
          if (queryBuilderPanel) queryBuilderPanel.style.display = 'none';
          if (clientSqlBar) clientSqlBar.style.display = 'flex';
        }
        sqlInput?.focus();
      });

      // Generador de SQL analítico a partir de parámetros del GUI Builder
      function generateBuilderSql(): string {
        const tableRef = triad ? `"${triad}"` : 'resource';
        const col = (builderColSelect?.value || '').trim();
        const op = (builderOpSelect?.value || 'contains').trim();
        const rawVal = (builderValInput?.value || '').trim();
        const escapedVal = rawVal.replace(/'/g, "''");
        const isNum = !isNaN(Number(rawVal)) && rawVal !== '';

        const groupCol = (builderGroupColSelect?.value || '').trim();
        const aggFunc = (builderAggFuncSelect?.value || 'COUNT').trim();
        const aggCol = (builderAggColSelect?.value || '').trim();
        const orderDir = (builderOrderDirSelect?.value || 'DESC').trim();

        let whereClause = '';

        if (op === 'is_null') {
          if (col) {
            whereClause = `WHERE ("${col}" IS NULL OR "${col}" = '')`;
          }
        } else if (op === 'is_not_null') {
          if (col) {
            whereClause = `WHERE ("${col}" IS NOT NULL AND "${col}" != '')`;
          }
        } else if (rawVal) {
          if (col) {
            switch (op) {
              case 'contains':
                whereClause = `WHERE "${col}" LIKE '%${escapedVal}%'`;
                break;
              case 'equals':
                whereClause = isNum ? `WHERE "${col}" = ${rawVal}` : `WHERE "${col}" = '${escapedVal}'`;
                break;
              case 'not_equals':
                whereClause = isNum ? `WHERE "${col}" != ${rawVal}` : `WHERE "${col}" != '${escapedVal}'`;
                break;
              case 'starts_with':
                whereClause = `WHERE "${col}" LIKE '${escapedVal}%'`;
                break;
              case 'greater_than':
                whereClause = isNum ? `WHERE "${col}" > ${rawVal}` : `WHERE "${col}" > '${escapedVal}'`;
                break;
              case 'less_than':
                whereClause = isNum ? `WHERE "${col}" < ${rawVal}` : `WHERE "${col}" < '${escapedVal}'`;
                break;
              default:
                whereClause = `WHERE "${col}" LIKE '%${escapedVal}%'`;
            }
          } else {
            if (parsedTable && parsedTable.columns.length > 0) {
              const conds = parsedTable.columns.slice(0, 5).map((c) => `"${c}" LIKE '%${escapedVal}%'`);
              whereClause = `WHERE (${conds.join(' OR ')})`;
            } else {
              whereClause = `WHERE resource LIKE '%${escapedVal}%'`;
            }
          }
        }

        const limitClause = `LIMIT ${pageSize}`;

        if (groupCol) {
          let metricExpr = 'COUNT(*)';
          let metricAlias = 'total_registros';
          if (aggFunc !== 'COUNT' && aggCol) {
            const cleanAggCol = aggCol.toLowerCase().replace(/[^a-z0-9]+/g, '_');
            metricAlias = `${aggFunc.toLowerCase()}_${cleanAggCol}`;
            if (aggFunc === 'AVG') {
              metricExpr = `ROUND(AVG("${aggCol}"), 2)`;
            } else {
              metricExpr = `${aggFunc}("${aggCol}")`;
            }
          }
          const selectClause = `SELECT "${groupCol}", ${metricExpr} AS "${metricAlias}"`;
          const groupByClause = `GROUP BY "${groupCol}"`;
          const orderByClause = `ORDER BY "${metricAlias}" ${orderDir}`;

          return whereClause
            ? `${selectClause} FROM ${tableRef} ${whereClause} ${groupByClause} ${orderByClause} ${limitClause};`
            : `${selectClause} FROM ${tableRef} ${groupByClause} ${orderByClause} ${limitClause};`;
        }

        return whereClause
          ? `SELECT * FROM ${tableRef} ${whereClause} ${limitClause};`
          : `SELECT * FROM ${tableRef} ${limitClause};`;
      }

      function updateBuilderPreview() {
        const sql = generateBuilderSql();
        if (builderSqlPreview) {
          builderSqlPreview.textContent = sql;
        }
      }

      // Eventos del Constructor de Filtros Visual
      builderOpSelect?.addEventListener('change', () => {
        const op = builderOpSelect.value;
        if (builderValInput) {
          if (op === 'is_null' || op === 'is_not_null') {
            builderValInput.disabled = true;
            builderValInput.placeholder = '(No requiere valor)';
          } else {
            builderValInput.disabled = false;
            builderValInput.placeholder = 'Valor o texto...';
          }
        }
        updateBuilderPreview();
      });

      builderColSelect?.addEventListener('change', updateBuilderPreview);
      builderValInput?.addEventListener('input', updateBuilderPreview);

      builderGroupColSelect?.addEventListener('change', updateBuilderPreview);
      builderAggFuncSelect?.addEventListener('change', () => {
        const isCount = builderAggFuncSelect.value === 'COUNT';
        if (builderAggColSelect) {
          builderAggColSelect.style.display = isCount ? 'none' : 'inline-block';
        }
        updateBuilderPreview();
      });
      builderAggColSelect?.addEventListener('change', updateBuilderPreview);
      builderOrderDirSelect?.addEventListener('change', updateBuilderPreview);

      builderValInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          currentPage = 1;
          executeClientQuery();
        }
      });

      builderApplyBtn?.addEventListener('click', async () => {
        if (!parsedTable && !isLoading) {
          await fetchViaTypeScriptClient();
        }
        currentPage = 1;
        executeClientQuery();
      });

      builderToChartBtn?.addEventListener('click', async () => {
        if (!parsedTable && !isLoading) {
          await fetchViaTypeScriptClient();
        }
        currentPage = 1;
        executeClientQuery();
        switchViewMode('chart');
      });

      builderResetBtn?.addEventListener('click', () => {
        if (builderColSelect) builderColSelect.value = '';
        if (builderOpSelect) builderOpSelect.value = 'contains';
        if (builderValInput) {
          builderValInput.value = '';
          builderValInput.disabled = false;
          builderValInput.placeholder = 'Valor o texto...';
        }
        if (builderGroupColSelect) builderGroupColSelect.value = '';
        if (builderAggFuncSelect) builderAggFuncSelect.value = 'COUNT';
        if (builderAggColSelect) {
          builderAggColSelect.value = '';
          builderAggColSelect.style.display = 'none';
        }
        if (builderOrderDirSelect) builderOrderDirSelect.value = 'DESC';
        updateBuilderPreview();
        currentPage = 1;
        executeClientQuery();
      });

      // Controles de Configuración de Coordenadas del Mapa
      mapLatSelect?.addEventListener('change', () => {
        selectedMapLat = mapLatSelect.value;
      });
      mapLonSelect?.addEventListener('change', () => {
        selectedMapLon = mapLonSelect.value;
      });
      mapLabelSelect?.addEventListener('change', () => {
        selectedMapLabel = mapLabelSelect.value;
      });
      mapApplyBtn?.addEventListener('click', () => {
        selectedMapLat = mapLatSelect?.value || '';
        selectedMapLon = mapLonSelect?.value || '';
        selectedMapLabel = mapLabelSelect?.value || '';
        renderMap();
      });

      // Selector de modo MCP
      mcpModeCheckbox?.addEventListener('change', () => {
