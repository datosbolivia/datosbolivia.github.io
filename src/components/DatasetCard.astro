---
import type { DatasetNode } from '../lib/catalog';

interface Props {
  dataset: DatasetNode;
}

const { dataset } = Astro.props;
const resCount = dataset.datapackage?.resources ? dataset.datapackage.resources.length : 1;
---

<article class="card">
  <div style="margin-bottom: 0.35rem;">
    <span style="font-size: 0.725rem; color: var(--color-primary); font-family: var(--font-mono); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">
      {dataset.category}
    </span>
  </div>

  <h3 style="font-size: 1.15rem; margin-bottom: 0.4rem;">
    <a href={`/datasets/${dataset.slug}`} style="text-decoration: none; color: inherit;">
      {dataset.title}
    </a>
  </h3>

  <p style="font-size: 0.875rem; color: var(--color-text-muted); flex: 1; margin-bottom: 0.85rem; line-height: 1.45;">
    {dataset.description.length > 130 ? `${dataset.description.substring(0, 130)}...` : dataset.description}
  </p>

  <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border); padding-top: 0.65rem; font-size: 0.8rem; color: var(--color-text-muted);">
    <span style="font-family: var(--font-mono); font-size: 0.75rem;">
      {resCount} <span data-i18n="card.resources">recurso(s)</span>
    </span>
    <a href={`/datasets/${dataset.slug}`} class="btn btn-secondary btn-sm" data-i18n="card.explore">
      Explorar &rarr;
    </a>
  </div>
</article>
