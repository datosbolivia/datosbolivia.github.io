---
import { config } from '../../portal.config';
---

<footer class="site-footer">
  <div class="container footer-content">
    <div>
      <p style="margin-bottom: 0.35rem; font-weight: 600; color: var(--color-text);">
        {config.organization.name} — {config.site.title}
      </p>
      <p style="font-size: 0.8rem; margin-bottom: 0;">
        {config.site.tagline}
      </p>
    </div>

    <div style="display: flex; gap: 1rem; align-items: center; font-size: 0.825rem;">
      <a href="/docs" data-i18n="nav.docs">
        Documentación
      </a>
      <span>•</span>
      <a href="/download" data-i18n="footer.install">
        Instalar
      </a>
      <span>•</span>
      <button type="button" class="open-sdk-settings-btn" style="background: none; border: none; padding: 0; color: inherit; font: inherit; cursor: pointer; text-decoration: underline; text-underline-offset: 3px;" data-i18n="footer.settings">
        Configuración
      </button>
      <span>•</span>
      <a href="/llms.txt">
        llms.txt
      </a>
    </div>
  </div>
</footer>
