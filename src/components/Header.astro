---
import { config } from '../../portal.config';

const currentPath = Astro.url.pathname;
function isActive(path: string) {
  if (path === '/' && currentPath === '/') return true;
  if (path !== '/' && currentPath.startsWith(path)) return true;
  return false;
}
---

<header class="site-header">
  <div class="container nav-container">
    <a href="/" class="logo-area" aria-label={config.organization.name}>
      <img
        src="/assets/logo.jpg"
        alt={config.organization.name}
        class="logo-image"
        width="32"
        height="32"
        loading="eager"
      />
      <span class="logo-title">{config.organization.name}</span>
    </a>

    <nav aria-label="Navegación principal">
      <ul class="nav-links" id="nav-links">
        {config.nav.map((item) => (
          <li>
            <a 
              href={item.path} 
              class={`nav-link ${isActive(item.path) ? 'active' : ''}`}
              data-i18n={item.key || `nav.${item.label.toLowerCase()}`}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav-actions">
      <!-- Selector de Idioma ES / EN -->
      <button 
        id="lang-toggle" 
        class="lang-btn" 
        aria-label="Cambiar idioma" 
        title="Cambiar idioma (ES / EN)"
      >
        EN
      </button>

      <!-- Selector de Tema Oscuro / Claro -->
      <button 
        id="theme-toggle" 
        class="btn-icon" 
        aria-label="Cambiar tema" 
        title="Cambiar tema"
      >
        <svg id="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg id="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Enlace canónico a llms.txt sin badges -->
      <a href="/llms.txt" class="nav-llm-link" title="Especificación llms.txt para Agentes de IA">
        llms.txt
      </a>
    </div>
  </div>
</header>

