---
import { config } from '../../portal.config';
import { translations } from '../lib/i18n';

const currentPath = Astro.url.pathname;
function isActive(path: string) {
  if (path === '/' && currentPath === '/') return true;
  if (path !== '/' && currentPath.startsWith(path)) return true;
  return false;
}
---

<header class="site-header">
  <div class="container nav-container">
    <a href="/" class="logo-area" aria-label={config.organization.name}>
      <img
        src="/logo.jpg"
        alt={config.organization.name}
        class="logo-image"
        width="32"
        height="32"
        loading="eager"
      />
      <span class="logo-title">{config.organization.name}</span>
    </a>

    <nav aria-label="Navegación principal">
      <ul class="nav-links" id="nav-links">
        {config.nav.map((item) => (
          <li>
            <a 
              href={item.path} 
              class={`nav-link ${isActive(item.path) ? 'active' : ''}`}
              data-i18n={item.key || `nav.${item.label.toLowerCase()}`}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav-actions">
      <!-- Selector de Idioma ES / EN -->
      <button 
        id="lang-toggle" 
        class="lang-btn" 
        aria-label="Cambiar idioma" 
        title="Cambiar idioma (ES / EN)"
      >
        EN
      </button>

      <!-- Selector de Tema Oscuro / Claro -->
      <button 
        id="theme-toggle" 
        class="btn-icon" 
        aria-label="Cambiar tema" 
        title="Cambiar tema"
      >
        <svg id="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="display: none;">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg id="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Enlace canónico a llms.txt sin badges -->
      <a href="/llms.txt" class="nav-llm-link" title="Especificación llms.txt para Agentes de IA">
        llms.txt
      </a>

      <!-- Botón Menú Móvil -->
      <button 
        id="nav-toggle" 
        class="nav-toggle btn-icon" 
        aria-label="Abrir menú de navegación" 
        aria-expanded="false" 
        aria-controls="nav-links"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<script id="i18n-data" type="application/json" set:html={JSON.stringify(translations)}></script>

<script is:inline>
  const i18nDict = JSON.parse(document.getElementById('i18n-data')?.textContent || '{}');
  // Función para aplicar idioma
  function applyLanguage(lang) {
    const dict = i18nDict[lang] || i18nDict.es;
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (key && dict[key]) {
        if (el.tagName === 'INPUT' && el.getAttribute('placeholder')) {
          el.setAttribute('placeholder', dict[key]);
        } else {
          el.textContent = dict[key];
        }
      }
    });

    document.querySelectorAll('[data-i18n-title]').forEach((el) => {
      const key = el.getAttribute('data-i18n-title');
      if (key && dict[key]) {
        el.setAttribute('title', dict[key]);
        el.setAttribute('aria-label', dict[key]);
      }
    });

    const langBtn = document.getElementById('lang-toggle');
    if (langBtn) {
      langBtn.textContent = lang === 'es' ? 'EN' : 'ES';
    }
    document.documentElement.setAttribute('lang', lang);
    localStorage.setItem('datamesh-lang', lang);
  }

  // Idioma inicial
  const savedLang = localStorage.getItem('datamesh-lang') || 'es';
  applyLanguage(savedLang);

  // Event listener para botón de idioma
  document.getElementById('lang-toggle')?.addEventListener('click', () => {
    const currentLang = document.documentElement.getAttribute('lang') || 'es';
    const nextLang = currentLang === 'es' ? 'en' : 'es';
    applyLanguage(nextLang);
  });

  // Manejador del Tema
  const themeToggle = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('theme-sun');
  const moonIcon = document.getElementById('theme-moon');

  function updateThemeIcons(theme) {
    if (theme === 'dark') {
      if (sunIcon) sunIcon.style.display = 'block';
      if (moonIcon) moonIcon.style.display = 'none';
    } else {
      if (sunIcon) sunIcon.style.display = 'none';
      if (moonIcon) moonIcon.style.display = 'block';
    }
  }

  const savedTheme = localStorage.getItem('datamesh-theme') || 
    (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

  document.documentElement.setAttribute('data-theme', savedTheme);
  updateThemeIcons(savedTheme);

  themeToggle?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('datamesh-theme', next);
    updateThemeIcons(next);
  });

  // Manejador del Menú Móvil
  const navToggle = document.getElementById('nav-toggle');
  const navLinks = document.getElementById('nav-links');
  navToggle?.addEventListener('click', () => {
    const isOpen = navLinks?.classList.toggle('mobile-open');
    navToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });
</script>
