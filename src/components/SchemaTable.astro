---
import type { DataResource } from '../lib/catalog';

interface Props {
  resource: DataResource;
  datasetSlug?: string;
}

const { resource, datasetSlug } = Astro.props;
const fields = resource.schema?.fields || [];
---

<div style="margin-bottom: 2rem;">
  <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
    {resource.policy && (
      <span style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--color-success);">
        policy: {resource.policy}
      </span>
    )}
  </div>

  {fields.length > 0 ? (
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th style="width: 25%;" data-i18n="schema.field">Campo (Columna)</th>
            <th style="width: 15%;" data-i18n="schema.type">Tipo</th>
            <th style="width: 60%;" data-i18n="schema.description">Descripción</th>
          </tr>
        </thead>
        <tbody>
          {fields.map((f) => (
            <tr>
              <td>
                <code style="font-weight: 600; color: var(--color-primary);">{f.name}</code>
              </td>
              <td>
                <code style="font-size: 0.75rem; color: var(--color-text-muted); background: transparent; padding: 0;">
                  {f.type || 'string'}
                </code>
              </td>
              <td style="color: var(--color-text-muted);">
                {f.description || '—'}
                {f.concept && (
                  <div style="margin-top: 0.25rem;">
                    <a href={datasetSlug ? `/datasets/${datasetSlug}#doc-${f.concept.replace(/\//g, '-').replace('.md', '')}` : `#doc-${f.concept.replace(/\//g, '-').replace('.md', '')}`} class="btn btn-secondary btn-sm" style="font-size: 0.7rem; padding: 0.1rem 0.4rem; display: inline-flex;">
                      Concepto: {f.concept}
                    </a>
                  </div>
                )}
                {f.valueLabels && Object.keys(f.valueLabels).length > 0 && (
                  <details style="margin-top: 0.35rem; font-size: 0.75rem;">
                    <summary style="cursor: pointer; color: var(--color-primary); font-family: var(--font-mono); font-size: 0.7rem;">
                      Categorías / Valores ({Object.keys(f.valueLabels).length})
                    </summary>
                    <div style="margin-top: 0.25rem; max-height: 150px; overflow-y: auto; background: var(--color-bg); padding: 0.4rem; border-radius: 4px; border: 1px solid var(--color-border);">
                      <table style="width: 100%; font-size: 0.7rem; border-collapse: collapse;">
                        <tbody>
                          {Object.entries(f.valueLabels).slice(0, 50).map(([k, lbl]) => {
                            const mappedConcept = f.value_mapping && f.value_mapping[k];
                            return (
                              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                                <td style="padding: 0.15rem 0.3rem; font-family: var(--font-mono); font-weight: 600; width: 25%; color: var(--color-text);"><code>{k}</code></td>
                                <td style="padding: 0.15rem 0.3rem; color: var(--color-text-muted);">{lbl}</td>
                                {mappedConcept && (
                                  <td style="padding: 0.15rem 0.3rem; text-align: right;">
                                    <a href={datasetSlug ? `/datasets/${datasetSlug}#doc-${mappedConcept.replace(/\//g, '-').replace('.md', '')}` : `#doc-${mappedConcept.replace(/\//g, '-').replace('.md', '')}`} style="color: var(--color-secondary); font-size: 0.65rem;">
                                      &rarr; {mappedConcept}
                                    </a>
                                  </td>
                                )}
                              </tr>
                            );
                          })}
                        </tbody>
                      </table>
                      {Object.keys(f.valueLabels).length > 50 && (
                        <p style="font-size: 0.65rem; color: var(--color-text-muted); margin: 0.2rem 0 0 0; font-style: italic;">
                          Mostrando primeras 50 de {Object.keys(f.valueLabels).length} categorías...
                        </p>
                      )}
                    </div>
                  </details>
                )}
                {f.value_mapping && !f.valueLabels && (
                  <div style="margin-top: 0.25rem; font-size: 0.7rem; font-family: var(--font-mono); color: var(--color-text-muted);">
                    Mapeo: {Object.keys(f.value_mapping).length} categorías asociadas a conceptos
                  </div>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <p style="font-size: 0.875rem; color: var(--color-text-muted); font-style: italic;" data-i18n="schema.no_fields">
      No hay campos detallados en el schema de este recurso.
    </p>
  )}
</div>
