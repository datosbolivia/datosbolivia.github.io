---
// Modal Global de Configuración del SDK (CORS Proxy, Servidor MCP / Backend y DuckDB)
---

<div id="sdk-settings-modal" class="sdk-modal-backdrop" style="display: none;" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="sdk-modal-title">
  <div class="sdk-modal-card card">
    <div class="sdk-modal-header">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
        <h2 id="sdk-modal-title" style="margin: 0; font-size: 1.15rem; font-family: var(--font-sans); font-weight: 700;">
          Configuración Global del SDK DataMesh
        </h2>
      </div>
      <button type="button" class="btn btn-secondary btn-sm sdk-modal-close" aria-label="Cerrar modal">
        &times;
      </button>
    </div>

    <div class="sdk-modal-body">
      <!-- 1. Sección Proxy CORS -->
      <section class="sdk-settings-section">
        <div class="sdk-section-header">
          <h3 style="margin: 0; font-size: 0.95rem; font-family: var(--font-sans); font-weight: 600;">
            1. Proxy CORS para Descarga de Datos
          </h3>
          <label class="sdk-checkbox-label">
            <input type="checkbox" id="modal-proxy-enable" />
            <span>Habilitar Proxy</span>
          </label>
        </div>
        <p class="sdk-section-desc">
          Resuelve problemas de acceso en orígenes restringidos (Kaggle, Google Drive, portales gubernamentales .gob.bo). Ejecuta la descarga a través del proxy seleccionado directamente.
        </p>

        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <label style="font-size: 0.775rem; font-family: var(--font-mono); font-weight: 600; color: var(--color-text-muted);">
              Proveedor de Proxy:
            </label>
            <span id="modal-proxy-status" class="sdk-badge-status">Comprobando...</span>
          </div>
          <div style="display: flex; gap: 0.5rem;">
            <select id="modal-proxy-provider" class="sdk-input" style="flex: 1;">
              <option value="direct">Fetch Directo (Sin proxy)</option>
              <option value="local">DataMesh Serve Local (http://localhost:8000/proxy?url=...)</option>
              <option value="allorigins">AllOrigins (https://api.allorigins.win/raw?url=...)</option>
              <option value="corsproxy">CORSProxy.io (https://corsproxy.io/?url=...)</option>
              <option value="custom">Personalizado (Plantilla URL)...</option>
            </select>
            <button type="button" id="modal-proxy-test-btn" class="btn btn-secondary btn-sm" style="white-space: nowrap;">
              Probar Ping
            </button>
          </div>

          <input 
            type="text" 
            id="modal-proxy-custom" 
            class="sdk-input" 
            placeholder="Ej: https://mi-proxy.local/?url={url}" 
            style="display: none;" 
          />
        </div>
      </section>

      <!-- 2. Sección Servidor Backend / MCP -->
      <section class="sdk-settings-section">
        <div class="sdk-section-header">
          <h3 style="margin: 0; font-size: 0.95rem; font-family: var(--font-sans); font-weight: 600;">
            2. Servidor MCP / Backend (DuckDB & Cómputo Pesado)
          </h3>
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <label class="sdk-checkbox-label">
              <input type="checkbox" id="modal-mcp-enable" checked />
              <span>Habilitar MCP</span>
            </label>
            <span id="modal-mcp-status" class="sdk-badge-status">Comprobando...</span>
          </div>
        </div>
        <p class="sdk-section-desc">
          Conexión JSON-RPC 2.0 al daemon `datamesh serve` o backend remoto para cálculo SQL pesado DuckDB y evasión de límites de memoria en navegador.
        </p>

        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
          <label style="font-size: 0.775rem; font-family: var(--font-mono); font-weight: 600; color: var(--color-text-muted);">
            URL del Servidor MCP / Backend:
          </label>
          <div style="display: flex; gap: 0.5rem;">
            <input 
              type="text" 
              id="modal-mcp-url" 
              class="sdk-input" 
              placeholder="http://localhost:8000/mcp" 
              style="flex: 1;" 
            />
            <button type="button" id="modal-mcp-test-btn" class="btn btn-secondary btn-sm" style="white-space: nowrap;">
              Probar Ping
            </button>
          </div>
        </div>
      </section>

      <!-- Mensaje de estado -->
      <div id="modal-status-msg" style="display: none; padding: 0.5rem 0.75rem; border-radius: var(--radius-sm); font-size: 0.775rem; font-family: var(--font-mono);">
      </div>
    </div>

    <div class="sdk-modal-footer">
      <button type="button" class="btn btn-secondary btn-sm sdk-modal-close">
        Cancelar
      </button>
      <button type="button" id="modal-save-btn" class="btn btn-primary btn-sm">
        Guardar Configuración
      </button>
    </div>
  </div>
</div>

<style>
  .sdk-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(3px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .sdk-modal-card {
    width: 100%;
    max-width: 540px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg, 0 10px 25px rgba(0,0,0,0.25));
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .sdk-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-surface-hover);
  }

  .sdk-modal-close {
    font-size: 1.25rem;
    line-height: 1;
    padding: 0.2rem 0.55rem;
    cursor: pointer;
  }

  .sdk-modal-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-height: calc(85vh - 120px);
    overflow-y: auto;
  }

  .sdk-settings-section {
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
  }

  .sdk-section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.35rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .sdk-checkbox-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.775rem;
    font-family: var(--font-mono);
    cursor: pointer;
    color: var(--color-text);
  }

  .sdk-section-desc {
    font-size: 0.775rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .sdk-input {
    padding: 0.45rem 0.7rem;
    font-size: 0.8rem;
    font-family: var(--font-mono);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-hover);
    color: var(--color-text);
    width: 100%;
  }

  .sdk-input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .sdk-badge-status {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-hover);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
  }

  .sdk-badge-status.online {
    background-color: rgba(22, 163, 74, 0.15);
    color: #16a34a;
    border-color: rgba(22, 163, 74, 0.3);
  }

  .sdk-badge-status.offline {
    background-color: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    border-color: rgba(239, 68, 68, 0.3);
  }

  .sdk-modal-footer {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.25rem;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-surface-hover);
  }
</style>

<script>
  import { setUserCustomProxy, getUserCustomProxy, getCorsProxyConfig, pingProxy } from '../lib/proxy';
  import { setCustomMcpUrl, getDefaultBackendUrl, isMcpEnabled, setMcpEnabled } from '../lib/mcp';

  function initSettingsModal() {
    const modal = document.getElementById('sdk-settings-modal');
    if (!modal || modal.dataset.ready) return;
    modal.dataset.ready = 'true';

    const openBtns = document.querySelectorAll('.open-sdk-settings-btn');
    const closeBtns = modal.querySelectorAll('.sdk-modal-close');
    const proxyEnableCheck = document.getElementById('modal-proxy-enable') as HTMLInputElement;
    const proxyProviderSel = document.getElementById('modal-proxy-provider') as HTMLSelectElement;
    const proxyCustomIn = document.getElementById('modal-proxy-custom') as HTMLInputElement;
    const proxyTestBtn = document.getElementById('modal-proxy-test-btn');
    const proxyStatusBadge = document.getElementById('modal-proxy-status');
    const mcpEnableCheck = document.getElementById('modal-mcp-enable') as HTMLInputElement;
    const mcpUrlIn = document.getElementById('modal-mcp-url') as HTMLInputElement;
    const mcpTestBtn = document.getElementById('modal-mcp-test-btn');
    const mcpStatusBadge = document.getElementById('modal-mcp-status');
    const saveBtn = document.getElementById('modal-save-btn');
    const statusMsg = document.getElementById('modal-status-msg');

    function loadValues() {
      // 1. Proxy
      const proxyCfg = getCorsProxyConfig();
      const customProxy = getUserCustomProxy();
      if (proxyEnableCheck) proxyEnableCheck.checked = proxyCfg.enabled;

      if (proxyProviderSel) {
        if (!proxyCfg.enabled) {
          proxyProviderSel.value = 'direct';
        } else if (customProxy) {
          if (customProxy.includes('localhost:8000')) {
            proxyProviderSel.value = 'local';
          } else if (customProxy.includes('allorigins')) {
            proxyProviderSel.value = 'allorigins';
          } else if (customProxy.includes('corsproxy')) {
            proxyProviderSel.value = 'corsproxy';
          } else {
            proxyProviderSel.value = 'custom';
            if (proxyCustomIn) {
              proxyCustomIn.value = customProxy;
              proxyCustomIn.style.display = 'block';
            }
          }
        } else {
          proxyProviderSel.value = proxyCfg.providers[0] || 'direct';
        }
      }

      // 2. MCP
      if (mcpEnableCheck) {
        mcpEnableCheck.checked = isMcpEnabled();
      }
      if (mcpUrlIn) {
        mcpUrlIn.value = getDefaultBackendUrl();
      }
      checkProxyOnline();
      checkMcpOnline();
    }

    async function checkProxyOnline() {
      if (!proxyStatusBadge) return;
      const prov = proxyProviderSel?.value || 'direct';
      if (prov === 'direct') {
        proxyStatusBadge.textContent = 'Modo Directo';
        proxyStatusBadge.className = 'sdk-badge-status';
        return;
      }

      proxyStatusBadge.textContent = 'Verificando...';
      proxyStatusBadge.className = 'sdk-badge-status';

      let target = prov;
      if (prov === 'custom' && proxyCustomIn) {
        target = proxyCustomIn.value.trim() || 'local';
      }

      const res = await pingProxy(target);
      if (res.ok) {
        proxyStatusBadge.textContent = 'En Línea (200 OK)';
        proxyStatusBadge.className = 'sdk-badge-status online';
      } else {
        proxyStatusBadge.textContent = 'Desconectado';
        proxyStatusBadge.className = 'sdk-badge-status offline';
      }
    }

    async function checkMcpOnline() {
      if (!mcpStatusBadge) return;
      if (mcpEnableCheck && !mcpEnableCheck.checked) {
        mcpStatusBadge.textContent = 'Deshabilitado';
        mcpStatusBadge.className = 'sdk-badge-status';
        return;
      }

      mcpStatusBadge.textContent = 'Verificando...';
      mcpStatusBadge.className = 'sdk-badge-status';

      const targetUrl = mcpUrlIn ? mcpUrlIn.value.trim() : getDefaultBackendUrl();
      const baseUrl = targetUrl.replace(/\/mcp\/?$/, '');

      try {
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), 2000);
        const resp = await fetch(`${baseUrl}/health`, { signal: controller.signal }).catch(() => null);
        clearTimeout(timer);
        if (resp && resp.ok) {
          mcpStatusBadge.textContent = 'En Línea (200 OK)';
          mcpStatusBadge.className = 'sdk-badge-status online';
          return;
        }

        // Test POST /mcp ping
        const rpcController = new AbortController();
        const rpcTimer = setTimeout(() => rpcController.abort(), 2000);
        const rpcResp = await fetch(targetUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'ping', params: {} }),
          signal: rpcController.signal,
        }).catch(() => null);
        clearTimeout(rpcTimer);

        if (rpcResp && rpcResp.ok) {
          mcpStatusBadge.textContent = 'En Línea (JSON-RPC)';
          mcpStatusBadge.className = 'sdk-badge-status online';
        } else {
          mcpStatusBadge.textContent = 'Desconectado';
          mcpStatusBadge.className = 'sdk-badge-status offline';
        }
      } catch {
        mcpStatusBadge.textContent = 'Desconectado';
        mcpStatusBadge.className = 'sdk-badge-status offline';
      }
    }

    openBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        loadValues();
        modal.style.display = 'flex';
      });
    });

    closeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        modal.style.display = 'none';
      });
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.style.display = 'none';
      }
    });

    proxyProviderSel?.addEventListener('change', () => {
      const val = proxyProviderSel.value;
      if (proxyCustomIn) {
        proxyCustomIn.style.display = val === 'custom' ? 'block' : 'none';
        if (val === 'custom') proxyCustomIn.focus();
      }
      if (proxyEnableCheck) {
        proxyEnableCheck.checked = val !== 'direct';
      }
      checkProxyOnline();
    });

    mcpEnableCheck?.addEventListener('change', () => {
      checkMcpOnline();
    });

    proxyTestBtn?.addEventListener('click', checkProxyOnline);
    mcpTestBtn?.addEventListener('click', checkMcpOnline);

    saveBtn?.addEventListener('click', () => {
      // 1. Guardar Proxy
      const selectedProv = proxyProviderSel?.value || 'direct';
      const isEnabled = proxyEnableCheck ? proxyEnableCheck.checked : selectedProv !== 'direct';
      let template = '';
      if (selectedProv === 'local') {
        template = 'http://localhost:8000/proxy?url={url}';
      } else if (selectedProv === 'allorigins') {
        template = 'https://api.allorigins.win/raw?url={url}';
      } else if (selectedProv === 'corsproxy') {
        template = 'https://corsproxy.io/?url={url}';
      } else if (selectedProv === 'custom') {
        template = proxyCustomIn?.value.trim() || '';
      }

      setUserCustomProxy(template, isEnabled);

      // 2. Guardar MCP
      if (mcpEnableCheck) {
        setMcpEnabled(mcpEnableCheck.checked);
      }
      if (mcpUrlIn) {
        const mcpVal = mcpUrlIn.value.trim();
        setCustomMcpUrl(mcpVal);
      }

      if (statusMsg) {
        statusMsg.style.display = 'block';
        statusMsg.style.backgroundColor = 'rgba(2, 132, 199, 0.1)';
        statusMsg.style.color = 'var(--color-primary)';
        statusMsg.style.border = '1px solid var(--color-primary)';
        statusMsg.textContent = 'Configuraciones del SDK guardadas con éxito en localStorage.';
        setTimeout(() => {
          modal.style.display = 'none';
          statusMsg.style.display = 'none';
        }, 1200);
      } else {
        modal.style.display = 'none';
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSettingsModal);
  } else {
    initSettingsModal();
  }
</script>
