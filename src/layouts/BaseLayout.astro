---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PwaPrompt from '../components/PwaPrompt.astro';
import SettingsModal from '../components/SettingsModal.astro';
import { config } from '../../portal.config';
import '../styles/theme.css';

interface Props {
  title?: string;
  description?: string;
  fullWidth?: boolean;
  noFooter?: boolean;
}

const { 
  title = config.site.title, 
  description = config.site.description,
  fullWidth = false,
  noFooter = false
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {config.organization.name}</title>
    <meta name="description" content={description} />

    <!-- Favicon e Identidad PWA -->
    <link rel="icon" href="/logo.jpg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content={config.pwa.themeColor} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={config.pwa.shortName} />

    <!-- Open Graph y Metadatos -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={config.site.url} />

    <!-- LLM Autodiscovery -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
  </head>

  <body class={fullWidth ? 'body-full-width' : ''}>
    <a href="#main-content" class="skip-link" data-i18n="action.skip_link">Saltar al contenido principal</a>
    <Header />

    <main id="main-content" class={fullWidth ? 'main-full-width' : 'container'} style={fullWidth ? 'padding: 0; margin: 0; max-width: 100%; width: 100%; display: flex; flex-direction: column; flex: 1; min-height: 0;' : 'padding-top: 1.5rem; padding-bottom: 3rem;'}>
      {!fullWidth && <PwaPrompt />}
      <slot />
    </main>

    {!noFooter && <Footer />}

    <SettingsModal />

    <script is:inline>
      // Portapapeles para bloques de código
      document.addEventListener('click', async (event) => {
        const target = event.target;
        const copyBtn = target && target.closest ? target.closest('.code-copy-btn') : null;
        if (!copyBtn) return;

        const wrapper = copyBtn.closest('.code-block-wrapper');
        const codeEl = wrapper ? wrapper.querySelector('pre code') : null;
        if (!codeEl) return;

        const textToCopy = codeEl.textContent || '';
        try {
          await navigator.clipboard.writeText(textToCopy);
          const label = copyBtn.querySelector('.copy-label');
          const originalText = label ? label.textContent : '';
          copyBtn.classList.add('copied');
          if (label) label.textContent = '¡Copiado!';

          setTimeout(() => {
            copyBtn.classList.remove('copied');
            if (label) label.textContent = originalText;
          }, 2000);
        } catch (err) {
          console.error('Error al copiar código:', err);
        }
      });
    </script>
  </body>
</html>
