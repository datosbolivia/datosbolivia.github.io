---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEditorialPage } from '../lib/catalog';
import { config } from '../../portal.config';
import { renderMarkdown } from '../lib/markdown';

const aboutPage = getEditorialPage('about');
const renderedHtml = renderMarkdown(aboutPage.body);
---

<BaseLayout title={aboutPage.title} description={aboutPage.description}>
  <div style="max-width: 800px; margin: 0 auto;">
    <!-- Contenido Editorial en Markdown -->
    <article class="prose" set:html={renderedHtml} />
  </div>
</BaseLayout>
