---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DatasetExplorerView from '../../components/DatasetExplorerView.astro';
import { getAllDatasets } from '../../lib/catalog';

export function getStaticPaths() {
  const datasets = getAllDatasets();
  return datasets.map((d) => ({
    params: { slug: d.slug },
    props: { dataset: d }
  }));
}

const { dataset } = Astro.props;
---

<BaseLayout title={dataset.title} description={dataset.description} fullWidth={true} noFooter={true}>
  <!-- Contenedor obsidian-layout delegado a vista de explorador -->
  <DatasetExplorerView dataset={dataset} activeTarget="tab-index" />
</BaseLayout>
