---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaTable from '../../components/SchemaTable.astro';
import DataExplorer from '../../components/DataExplorer.astro';
import { getAllDatasets } from '../../lib/catalog';
import { renderMarkdown } from '../../lib/markdown';

export function getStaticPaths() {
  const datasets = getAllDatasets();
  return datasets.map((d) => ({
    params: { slug: d.slug },
    props: { dataset: d }
  }));
}

const { dataset } = Astro.props;
const resources = dataset.allResources || [];
const referenceDocs = dataset.referenceDocs || [];
const contracts = dataset.contracts || [];

// Renderizar el contenido completo de index.md con enlaces reescritos
const renderedIndexHtml = renderMarkdown(dataset.bodyMarkdown, { datasetSlug: dataset.slug });

// Pre-renderizar subdocumentos de referencia
const renderedDocs = referenceDocs.map((doc) => ({
  ...doc,
  tabId: `doc-${doc.cleanPath.replace(/\//g, '-')}`,
  html: renderMarkdown(doc.bodyMarkdown, { datasetSlug: dataset.slug })
}));

// Separar conceptos y context
const conceptDocs = renderedDocs.filter(d => d.relativePath.startsWith('concepts/'));
const contextDocs = renderedDocs.filter(d => !d.relativePath.startsWith('concepts/'));

function getCleanResourceName(res: any): string {
  let name = res.name || 'recurso';
  if (name.startsWith('Fuente de Linaje (')) {
    name = name.replace(/^Fuente de Linaje \((.*?)\)$/, '$1');
  }
  const ext = res.format && res.format !== 'url' ? `.${res.format.toLowerCase()}` : '';
  if (ext && !name.endsWith(ext)) {
    name = `${name}${ext}`;
  }
  return name;
}
---

<BaseLayout title={dataset.title} description={dataset.description}>
  <!-- Breadcrumb compacto superior -->
  <nav style="display: flex; gap: 0.5rem; align-items: center; font-size: 0.8rem; color: var(--color-text-muted); margin-bottom: 0.75rem;">
    <a href="/" style="color: inherit; text-decoration: none;" data-i18n="nav.home">Inicio</a>
    <span>/</span>
    <a href="/datasets" style="color: inherit; text-decoration: none;" data-i18n="nav.datasets">Datasets</a>
    <span>/</span>
    <span style="color: var(--color-text); font-weight: 500;">{dataset.slug}</span>
  </nav>

  <!-- Explorador de Archivos Estilo Obsidian Condensado -->
  <div class="obsidian-layout" id="obsidian-explorer">
    <!-- Panel Izquierdo: Árbol de Archivos -->
    <aside class="obsidian-sidebar" aria-label="Explorador de Archivos">
      <div class="obsidian-tree-container">
        <!-- Grupo KNOWLEDGE (Contexto Principal Primero) -->
        <div class="obsidian-folder-group">
          <div class="obsidian-folder-header" role="button" tabindex="0" aria-expanded="true" title="Expandir/Colapsar Knowledge">
            <svg class="obsidian-folder-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
            <span data-i18n="explorer.knowledge">Knowledge</span>
          </div>

          <button 
            type="button"
            class="obsidian-file-item active" 
            data-target="tab-index"
            data-path={`${dataset.slug}/index.md`}
            data-raw={`/raw/nodes/${dataset.slug}/index.md`}
            title="index.md"
          >
            <svg class="file-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
            <span class="file-label">index.md</span>
          </button>

          {contextDocs.map((doc) => {
            const fileName = doc.relativePath.replace('knowledge/', '');
            return (
              <button 
                type="button"
                class="obsidian-file-item" 
                data-target={`tab-${doc.tabId}`}
                data-path={`${dataset.slug}/${doc.relativePath}`}
                data-raw={`/raw/nodes/${dataset.slug}/${doc.relativePath}`}
                title={fileName}
              >
                <svg class="file-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
                <span class="file-label">{fileName}</span>
              </button>
            );
          })}
        </div>

        <!-- Grupo CONCEPTS (si existen conceptos) -->
        {conceptDocs.length > 0 && (
          <div class="obsidian-folder-group">
            <div class="obsidian-folder-header" role="button" tabindex="0" aria-expanded="true" title="Expandir/Colapsar Concepts">
              <svg class="obsidian-folder-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
              <span data-i18n="explorer.concepts">Concepts</span>
            </div>
            {conceptDocs.map((doc) => {
              const fileName = doc.relativePath.replace('concepts/', '');
              return (
                <button 
                  type="button"
                  class="obsidian-file-item" 
                  data-target={`tab-${doc.tabId}`}
                  data-path={`${dataset.slug}/${doc.relativePath}`}
                  data-raw={`/raw/nodes/${dataset.slug}/${doc.relativePath}`}
                  title={fileName}
                >
                  <svg class="file-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                  </svg>
                  <span class="file-label">{fileName}</span>
                </button>
              );
            })}
          </div>
        )}

        <!-- Grupo RESOURCES (Tablas y Fuentes) -->
        {resources.length > 0 && (
          <div class="obsidian-folder-group">
            <div class="obsidian-folder-header" role="button" tabindex="0" aria-expanded="true" title="Expandir/Colapsar Resources">
              <svg class="obsidian-folder-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
              <span><span data-i18n="explorer.resources">Recursos</span> ({resources.length})</span>
            </div>
            {resources.map((res, i) => {
              const cleanName = getCleanResourceName(res);
              return (
                <button 
                  type="button"
                  class="obsidian-file-item" 
                  data-target={`tab-resource-${i}`}
                  data-path={`${dataset.slug}/resources/${res.name}`}
                  data-download={res.path || ''}
                  title={res.name}
                >
                  <svg class="file-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                    <line x1="3" y1="9" x2="21" y2="9"></line>
                    <line x1="9" y1="21" x2="9" y2="9"></line>
                  </svg>
                  <span class="file-label">{cleanName}</span>
                </button>
              );
            })}
          </div>
        )}
      </div>
    </aside>

    <!-- Panel Derecho: Visor de Documentos y Esquemas -->
    <section class="obsidian-content-pane" aria-label="Visor de contenido">
      <!-- Barra Superior de Navegación del Panel -->
      <div class="obsidian-pane-bar">
        <div class="obsidian-pane-breadcrumb" id="pane-breadcrumb">
          <span>{dataset.slug}</span>
          <span>/</span>
          <span id="active-filename" style="color: var(--color-text); font-weight: 600;">index.md</span>
        </div>

        <div class="obsidian-pane-actions">
          <a 
            id="pane-raw-link" 
            href={`/raw/nodes/${dataset.slug}/index.md`} 
            target="_blank" 
            class="btn btn-secondary btn-sm"
            style="font-family: var(--font-mono); font-size: 0.75rem;"
          >
            <span data-i18n="explorer.raw">Ver Raw</span> &rarr;
          </a>

          <a 
            id="pane-download-link" 
            href="#" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn btn-primary btn-sm"
            style="display: none; font-size: 0.75rem;"
          >
            <span data-i18n="explorer.download">Descargar</span> &darr;
          </a>
        </div>
      </div>

      <!-- Área de Contenido Escroleable Interna (Sin Duplicación, Contexto Primero) -->
      <div class="obsidian-doc-viewport" id="doc-viewport">
        <!-- 1. TAB CONTEXTO PRINCIPAL (index.md) - ACTIVO POR DEFECTO -->
        <div class="obsidian-file-tab active" id="tab-index">
          <article class="prose" set:html={renderedIndexHtml} />
        </div>

        <!-- 2. TABS PARA DOCUMENTOS DE REFERENCIA (Concepts & Context) -->
        {renderedDocs.map((doc) => (
          <div class="obsidian-file-tab" id={`tab-${doc.tabId}`}>
            <article class="prose" set:html={doc.html} />
          </div>
        ))}

        <!-- 3. TABS PARA RECURSOS DE DATOS -->
        {resources.map((res, i) => (
          <div class="obsidian-file-tab" id={`tab-resource-${i}`}>
            <div style="border-bottom: 1px solid var(--color-border); padding-bottom: 1rem; margin-bottom: 1.5rem;">
              <div style="font-size: 0.725rem; color: var(--color-primary); font-family: var(--font-mono); font-weight: 600; text-transform: uppercase; margin-bottom: 0.35rem;">
                <span data-i18n="explorer.resource_num">Recurso</span> #{i + 1} • {res.format ? res.format.toUpperCase() : 'CSV'}
              </div>
              <h1 style="font-size: 1.85rem; margin-bottom: 0.5rem;">
                {res.name}
              </h1>
              {res.description && (
                <p style="font-size: 0.95rem; color: var(--color-text-muted); margin-bottom: 0.75rem; line-height: 1.5;">
                  {res.description}
                </p>
              )}

              {res.path && (
                <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; margin-top: 0.75rem;">
                  <a href={res.path} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
                    <span data-i18n="explorer.download_resource">Descargar Recurso</span> &rarr;
                  </a>
                  <code style="font-size: 0.8rem; padding: 0.35rem 0.6rem; word-break: break-all;">{res.path}</code>
                </div>
              )}
            </div>

            <DataExplorer datasetSlug={dataset.slug} resource={res} resourceIndex={i} />
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  // Controlador de navegación instantánea tipo Obsidian
  (function initObsidianExplorer() {
    const fileItems = Array.from(document.querySelectorAll('.obsidian-file-item'));
    const fileTabs = Array.from(document.querySelectorAll('.obsidian-file-tab'));
    const breadcrumbFilename = document.getElementById('active-filename');
    const rawLink = document.getElementById('pane-raw-link');
    const downloadLink = document.getElementById('pane-download-link');
    const docViewport = document.getElementById('doc-viewport');

    function switchToFile(targetId, path, rawUrl, downloadUrl) {
      // 1. Alternar pestañas de contenido
      fileTabs.forEach((tab) => {
        if (tab.id === targetId) {
          tab.classList.add('active');
        } else {
          tab.classList.remove('active');
        }
      });

      // 2. Alternar estado activo en árbol lateral
      fileItems.forEach((item) => {
        if (item.getAttribute('data-target') === targetId) {
          item.classList.add('active');
        } else {
          item.classList.remove('active');
        }
      });

      // 3. Actualizar barra de breadcrumbs
      if (breadcrumbFilename && path) {
        const parts = path.split('/');
        breadcrumbFilename.textContent = parts[parts.length - 1];
      }

      // 4. Actualizar botones de acción
      if (rawLink) {
        if (rawUrl) {
          rawLink.style.display = 'inline-flex';
          rawLink.setAttribute('href', rawUrl);
        } else {
          rawLink.style.display = 'none';
        }
      }

      if (downloadLink) {
        if (downloadUrl) {
          downloadLink.style.display = 'inline-flex';
          downloadLink.setAttribute('href', downloadUrl);
        } else {
          downloadLink.style.display = 'none';
        }
      }

      // 5. Reset de scroll del viewport
      if (docViewport) {
        docViewport.scrollTop = 0;
      }
    }

    // Registrar clics en elementos del árbol
    fileItems.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-target') || 'tab-index';
        const path = btn.getAttribute('data-path') || '';
        const raw = btn.getAttribute('data-raw') || '';
        const dl = btn.getAttribute('data-download') || '';
        switchToFile(target, path, raw, dl);

        // Actualizar hash en URL sin recargar
        window.history.replaceState(null, '', `#${target}`);
      });
    });

    // Colapsar/expandir carpetas con clic y teclado
    document.querySelectorAll('.obsidian-folder-header').forEach((header) => {
      header.addEventListener('click', () => {
        const group = header.closest('.obsidian-folder-group');
        group?.classList.toggle('collapsed');
      });
      header.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          header.click();
        }
      });
    });

    // Interceptar enlaces internos dentro de markdown con data-doc-target
    document.addEventListener('click', (e) => {
      const link = e.target.closest('a[data-doc-target]');
      if (link) {
        e.preventDefault();
        const targetTab = link.getAttribute('data-doc-target');
        const matchedItem = fileItems.find((item) => item.getAttribute('data-target') === `tab-${targetTab}`);
        if (matchedItem) {
          matchedItem.click();
        }
      }
    });

    // Leer hash inicial si existe
    if (window.location.hash) {
      const hash = window.location.hash.substring(1);
      const matched = fileItems.find((item) => item.getAttribute('data-target') === hash);
      if (matched) {
        matched.click();
      }
    }

    // Alternar vistas de gráficos declarativos (Visualización vs SQL)
    document.querySelectorAll('.chart-card').forEach((card) => {
      const btns = card.querySelectorAll('.chart-toggle-btn');
      const visView = card.querySelector('[data-view="vis"]');
      const sqlView = card.querySelector('[data-view="sql"]');
      btns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-target');
          btns.forEach((b) => b.classList.toggle('active', b === btn));
          if (visView) visView.style.display = target === 'vis' ? 'block' : 'none';
          if (sqlView) sqlView.style.display = target === 'sql' ? 'block' : 'none';
        });
      });
    });
  })();
</script>
