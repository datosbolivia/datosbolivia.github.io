---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaTable from '../../components/SchemaTable.astro';
import DataExplorer from '../../components/DataExplorer.astro';
import { getAllDatasets } from '../../lib/catalog';
import { renderMarkdown } from '../../lib/markdown';

export function getStaticPaths() {
  const datasets = getAllDatasets();
  return datasets.map((d) => ({
    params: { slug: d.slug },
    props: { dataset: d }
  }));
}

const { dataset } = Astro.props;
const resources = dataset.allResources || [];
const referenceDocs = dataset.referenceDocs || [];
const contracts = dataset.contracts || [];
const rawIndexUrl = dataset.remoteUrl || `/raw/nodes/${dataset.slug}/index.md`;

// Renderizar el contenido completo de index.md con enlaces reescritos
const renderedIndexHtml = renderMarkdown(dataset.bodyMarkdown, { datasetSlug: dataset.slug });

// Pre-renderizar subdocumentos de referencia
const renderedDocs = referenceDocs.map((doc) => ({
  ...doc,
  tabId: `doc-${doc.cleanPath.replace(/\//g, '-')}`,
  html: renderMarkdown(doc.bodyMarkdown, { datasetSlug: dataset.slug })
}));

// Separar conceptos y context
const conceptDocs = renderedDocs.filter(d => d.relativePath.startsWith('concepts/'));
const contextDocs = renderedDocs.filter(d => !d.relativePath.startsWith('concepts/'));

function getCleanResourceName(res: any): string {
  let name = res.name || 'recurso';
  if (name.startsWith('Fuente de Linaje (')) {
    name = name.replace(/^Fuente de Linaje \((.*?)\)$/, '$1');
  }
  const ext = res.format && res.format !== 'url' ? `.${res.format.toLowerCase()}` : '';
  if (ext && !name.endsWith(ext)) {
    name = `${name}${ext}`;
  }
  return name;
}
---

<BaseLayout title={dataset.title} description={dataset.description} fullWidth={true} noFooter={true}>
  <!-- Explorador de Archivos Estilo Obsidian Condensado (Pantalla Completa) -->
  <div
    class="obsidian-layout"
    id="obsidian-explorer"
    data-dataset-slug={dataset.slug}
    data-resources={JSON.stringify(resources.map(r => ({ name: r.name, path: r.path })))}
  >
    <!-- Backdrop oscuro para drawer móvil -->
    <div class="obsidian-backdrop" id="obsidian-backdrop" aria-hidden="true"></div>

    <!-- Panel Izquierdo: Árbol de Archivos -->
    <aside class="obsidian-sidebar" id="obsidian-sidebar" aria-label="Explorador de Archivos">
      <div class="obsidian-sidebar-header">
        <div style="display: flex; align-items: center; gap: 0.5rem; overflow: hidden;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
          <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600;" data-i18n="explorer.files">Archivos</span>
        </div>
        <button 
          type="button" 
          id="obsidian-sidebar-close" 
          class="obsidian-mobile-close" 
          title="Cerrar explorador" 
          aria-label="Cerrar explorador"
          data-i18n-title="explorer.close_sidebar"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="obsidian-tree-container">
        <!-- Grupo KNOWLEDGE (Contexto Principal Primero) -->
        <div class="obsidian-folder-group">
          <div class="obsidian-folder-header" role="button" tabindex="0" aria-expanded="true" title="Expandir/Colapsar Knowledge">
            <svg class="obsidian-folder-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
            <span data-i18n="explorer.knowledge">Knowledge</span>
          </div>

          <button 
            type="button"
            class="obsidian-file-item active" 
            data-target="tab-index"
            data-path={`${dataset.slug}/index.md`}
            data-raw={rawIndexUrl}
            title="index.md"
          >
            <svg class="file-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
            <span class="file-label">index.md</span>
          </button>

          {contextDocs.map((doc) => {
            const fileName = doc.relativePath.replace('knowledge/', '');
            return (
              <button 
                type="button"
                class="obsidian-file-item" 
                data-target={`tab-${doc.tabId}`}
                data-path={`${dataset.slug}/${doc.relativePath}`}
                data-raw={`/raw/nodes/${dataset.slug}/${doc.relativePath}`}
                title={fileName}
              >
                <svg class="file-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
                <span class="file-label">{fileName}</span>
              </button>
            );
          })}
        </div>

        <!-- Grupo CONCEPTS (si existen conceptos) -->
        {conceptDocs.length > 0 && (
          <div class="obsidian-folder-group">
            <div class="obsidian-folder-header" role="button" tabindex="0" aria-expanded="true" title="Expandir/Colapsar Concepts">
              <svg class="obsidian-folder-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
              <span data-i18n="explorer.concepts">Concepts</span>
            </div>
            {conceptDocs.map((doc) => {
              const fileName = doc.relativePath.replace('concepts/', '');
              return (
                <button 
                  type="button"
                  class="obsidian-file-item" 
                  data-target={`tab-${doc.tabId}`}
                  data-path={`${dataset.slug}/${doc.relativePath}`}
                  data-raw={`/raw/nodes/${dataset.slug}/${doc.relativePath}`}
                  title={fileName}
                >
                  <svg class="file-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                  </svg>
                  <span class="file-label">{fileName}</span>
                </button>
              );
            })}
          </div>
        )}

        <!-- Grupo RESOURCES (Tablas y Fuentes) -->
        {resources.length > 0 && (
          <div class="obsidian-folder-group">
            <div class="obsidian-folder-header" role="button" tabindex="0" aria-expanded="true" title="Expandir/Colapsar Resources">
              <svg class="obsidian-folder-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
              <span><span data-i18n="explorer.resources">Recursos</span> ({resources.length})</span>
            </div>
            {resources.map((res, i) => {
              const cleanName = getCleanResourceName(res);
              return (
                <button 
                  type="button"
                  class="obsidian-file-item" 
                  data-target={`tab-resource-${i}`}
                  data-path={`${dataset.slug}/resources/${res.name}`}
                  data-download={res.path || ''}
                  title={res.name}
                >
                  <svg class="file-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                    <line x1="3" y1="9" x2="21" y2="9"></line>
                    <line x1="9" y1="21" x2="9" y2="9"></line>
                  </svg>
                  <span class="file-label">{cleanName}</span>
                </button>
              );
            })}
          </div>
        )}
      </div>

      <div class="obsidian-sidebar-footer" style="padding: 0.65rem 0.85rem; border-top: 1px solid var(--color-border); background-color: var(--color-surface); display: flex; align-items: center; justify-content: space-between;">
        <button 
          type="button" 
          class="open-sdk-settings-btn btn btn-secondary btn-sm"
          style="width: 100%; font-size: 0.75rem; justify-content: center; gap: 0.4rem;"
          title="Configuración global del SDK (Proxy CORS, Backend MCP)"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
          <span data-i18n="footer.settings">Configuración</span>
        </button>
      </div>
    </aside>

    <!-- Panel Derecho: Visor de Documentos y Esquemas -->
    <section class="obsidian-content-pane" aria-label="Visor de contenido">
      <!-- Barra Superior de Navegación del Panel -->
      <div class="obsidian-pane-bar">
        <div style="display: flex; align-items: center; gap: 0.5rem; min-width: 0; flex: 1;">
          <button 
            type="button" 
            id="obsidian-toggle-sidebar" 
            class="btn btn-secondary btn-sm" 
            style="padding: 0.25rem 0.45rem; display: inline-flex; align-items: center; flex-shrink: 0;"
            title="Alternar explorador"
            aria-label="Alternar explorador"
            data-i18n-title="explorer.toggle_sidebar"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/></svg>
            <span class="visually-hidden" data-i18n="explorer.toggle_sidebar">Alternar explorador</span>
          </button>

          <nav class="obsidian-pane-breadcrumb" id="pane-breadcrumb" aria-label="Ruta de navegación">
            <a href="/" class="obsidian-crumb-link obsidian-crumb-root" data-i18n="nav.home">Inicio</a>
            <span class="obsidian-crumb-sep obsidian-crumb-root">/</span>
            <a href="/datasets" class="obsidian-crumb-link obsidian-crumb-root" data-i18n="nav.datasets">Datasets</a>
            <span class="obsidian-crumb-sep obsidian-crumb-root">/</span>
            <span class="obsidian-crumb-slug" title={`Dataset: ${dataset.slug}`}>{dataset.slug}</span>
            <span class="obsidian-crumb-sep">/</span>
            <span id="active-filename" class="obsidian-crumb-file">index.md</span>
          </nav>
        </div>

        <div class="obsidian-pane-actions" style="flex-shrink: 0;">
          <a 
            id="pane-raw-link" 
            href={rawIndexUrl} 
            target="_blank" 
            class="btn btn-secondary btn-sm"
            style="font-family: var(--font-mono); font-size: 0.75rem; white-space: nowrap;"
          >
            <span data-i18n="explorer.raw">Ver Raw</span> &rarr;
          </a>
        </div>
      </div>

      <!-- Área de Contenido Escroleable Interna (Sin Duplicación, Contexto Primero) -->
      <div class="obsidian-doc-viewport" id="doc-viewport">
        <!-- 1. TAB CONTEXTO PRINCIPAL (index.md) - ACTIVO POR DEFECTO -->
        <div class="obsidian-file-tab active" id="tab-index">
          {(dataset.spatial || dataset.temporal || dataset.quality) && (
            <div style="background-color: var(--color-surface); border: 1px solid var(--color-border); border-radius: 6px; padding: 0.75rem 1rem; margin-bottom: 1.5rem; font-size: 0.8rem; display: flex; flex-wrap: wrap; gap: 1.25rem;">
              {dataset.spatial && (
                <div style="display: flex; align-items: center; gap: 0.4rem;">
                  <span style="font-weight: 600; color: var(--color-text-muted); text-transform: uppercase; font-size: 0.7rem;">Espacial:</span>
                  <span>{dataset.spatial.country || ''} {dataset.spatial.regions ? `(${dataset.spatial.regions.join(', ')})` : ''} {dataset.spatial.granularity ? `[${dataset.spatial.granularity}]` : ''}</span>
                </div>
              )}
              {dataset.temporal && (
                <div style="display: flex; align-items: center; gap: 0.4rem;">
                  <span style="font-weight: 600; color: var(--color-text-muted); text-transform: uppercase; font-size: 0.7rem;">Temporal:</span>
                  <span>{dataset.temporal.start || '?'} &rarr; {dataset.temporal.end || '?'} {dataset.temporal.frequency ? `(${dataset.temporal.frequency})` : ''}</span>
                </div>
              )}
              {dataset.quality && (
                <div style="display: flex; align-items: center; gap: 0.4rem;">
                  <span style="font-weight: 600; color: var(--color-text-muted); text-transform: uppercase; font-size: 0.7rem;">Calidad:</span>
                  <span style="text-transform: capitalize;">{dataset.quality.status || 'Curated'} {dataset.quality.completeness ? `• ${Math.round(dataset.quality.completeness * 100)}% completitud` : ''}</span>
                </div>
              )}
            </div>
          )}
          <article class="prose" set:html={renderedIndexHtml} />
        </div>

        <!-- 2. TABS PARA DOCUMENTOS DE REFERENCIA (Concepts & Context) -->
        {renderedDocs.map((doc) => (
          <div class="obsidian-file-tab" id={`tab-${doc.tabId}`}>
            <article class="prose" set:html={doc.html} />
          </div>
        ))}

        <!-- 3. TABS PARA RECURSOS DE DATOS -->
        {resources.map((res, i) => (
          <div class="obsidian-file-tab" id={`tab-resource-${i}`}>
            <div style="border-bottom: 1px solid var(--color-border); padding-bottom: 1rem; margin-bottom: 1.5rem;">
              <div style="font-size: 0.725rem; color: var(--color-primary); font-family: var(--font-mono); font-weight: 600; text-transform: uppercase; margin-bottom: 0.35rem;">
                <span data-i18n="explorer.resource_num">Recurso</span> #{i + 1} • {res.format ? res.format.toUpperCase() : 'CSV'}
              </div>
              <h1 style="font-size: 1.85rem; margin-bottom: 0.5rem;">
                {res.name}
              </h1>
              {res.description && (
                <p style="font-size: 0.95rem; color: var(--color-text-muted); margin-bottom: 0.75rem; line-height: 1.5;">
                  {res.description}
                </p>
              )}

              {res.path && (
                <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; margin-top: 0.75rem;">
                  <a href={res.path} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
                    <span data-i18n="explorer.download_resource">Descargar Recurso</span> &rarr;
                  </a>
                  <code style="font-size: 0.8rem; padding: 0.35rem 0.6rem; word-break: break-all;">{res.path}</code>
                </div>
              )}
            </div>

            <DataExplorer datasetSlug={dataset.slug} resource={res} resourceIndex={i} />
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  // Controlador de navegación instantánea tipo Obsidian
  (function initObsidianExplorer() {
    const layout = document.getElementById('obsidian-explorer');
    const sidebar = document.querySelector('.obsidian-sidebar');
    const toggleSidebarBtn = document.getElementById('obsidian-toggle-sidebar');
    const closeSidebarBtn = document.getElementById('obsidian-sidebar-close');
    const backdrop = document.getElementById('obsidian-backdrop');

    const fileItems = Array.from(document.querySelectorAll('.obsidian-file-item'));
    const fileTabs = Array.from(document.querySelectorAll('.obsidian-file-tab'));
    const breadcrumbFilename = document.getElementById('active-filename');
    const rawLink = document.getElementById('pane-raw-link');
    const downloadLink = document.getElementById('pane-download-link');
    const docViewport = document.getElementById('doc-viewport');

    function isMobile() {
      return window.innerWidth <= 768;
    }

    // Alternar visibilidad de la barra lateral (Colapsar en desktop, Drawer en móvil)
    function toggleSidebar() {
      if (isMobile()) {
        const isOpen = sidebar?.classList.toggle('mobile-open');
        backdrop?.classList.toggle('visible', !!isOpen);
        toggleSidebarBtn?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      } else {
        sidebar?.classList.toggle('collapsed');
        const isCollapsed = sidebar?.classList.contains('collapsed');
        toggleSidebarBtn?.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
      }
    }

    function closeMobileSidebar() {
      if (sidebar?.classList.contains('mobile-open')) {
        sidebar.classList.remove('mobile-open');
        backdrop?.classList.remove('visible');
        toggleSidebarBtn?.setAttribute('aria-expanded', 'false');
      }
    }

    toggleSidebarBtn?.addEventListener('click', toggleSidebar);
    closeSidebarBtn?.addEventListener('click', closeMobileSidebar);
    backdrop?.addEventListener('click', closeMobileSidebar);

    window.addEventListener('resize', () => {
      if (!isMobile()) {
        sidebar?.classList.remove('mobile-open');
        backdrop?.classList.remove('visible');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isMobile() && sidebar?.classList.contains('mobile-open')) {
        closeMobileSidebar();
      }
    });

    function switchToFile(targetId, path, rawUrl, downloadUrl) {
      // 1. Alternar pestañas de contenido
      fileTabs.forEach((tab) => {
        if (tab.id === targetId) {
          tab.classList.add('active');
        } else {
          tab.classList.remove('active');
        }
      });

      // 2. Alternar estado activo en árbol lateral
      fileItems.forEach((item) => {
        if (item.getAttribute('data-target') === targetId) {
          item.classList.add('active');
        } else {
          item.classList.remove('active');
        }
      });

      // 3. Actualizar barra de breadcrumbs
      if (breadcrumbFilename && path) {
        const parts = path.split('/');
        breadcrumbFilename.textContent = parts[parts.length - 1];
      }

      // 4. Actualizar botones de acción
      if (rawLink) {
        if (rawUrl) {
          rawLink.style.display = 'inline-flex';
          rawLink.setAttribute('href', rawUrl);
        } else {
          rawLink.style.display = 'none';
        }
      }

      if (downloadLink) {
        if (downloadUrl) {
          downloadLink.style.display = 'inline-flex';
          downloadLink.setAttribute('href', downloadUrl);
        } else {
          downloadLink.style.display = 'none';
        }
      }

      // 5. Reset de scroll del viewport
      if (docViewport) {
        docViewport.scrollTop = 0;
      }

      // 6. Cerrar drawer en móvil si está abierto
      if (isMobile()) {
        closeMobileSidebar();
      }
    }

    // Registrar clics en elementos del árbol
    fileItems.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-target') || 'tab-index';
        const path = btn.getAttribute('data-path') || '';
        const raw = btn.getAttribute('data-raw') || '';
        const dl = btn.getAttribute('data-download') || '';
        switchToFile(target, path, raw, dl);

        // Actualizar hash en URL sin recargar
        window.history.replaceState(null, '', `#${target}`);
      });
    });

    // Colapsar/expandir carpetas con clic y teclado
    document.querySelectorAll('.obsidian-folder-header').forEach((header) => {
      header.addEventListener('click', () => {
        const group = header.closest('.obsidian-folder-group');
        group?.classList.toggle('collapsed');
      });
      header.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          header.click();
        }
      });
    });

    // Interceptar enlaces internos dentro de markdown con data-doc-target
    document.addEventListener('click', (e) => {
      const link = e.target.closest('a[data-doc-target]');
      if (link) {
        e.preventDefault();
        const targetTab = link.getAttribute('data-doc-target');
        const matchedItem = fileItems.find((item) => item.getAttribute('data-target') === `tab-${targetTab}`);
        if (matchedItem) {
          matchedItem.click();
        }
      }
    });

    // Leer hash inicial si existe
    if (window.location.hash) {
      const hash = window.location.hash.substring(1);
      const matched = fileItems.find((item) => item.getAttribute('data-target') === hash);
      if (matched) {
        matched.click();
      }
    }

  })();
</script>

<script>
  import * as Plot from '@observablehq/plot';
  import { DataMeshClient, datamesh, normalizeResourceUrl, parseCsv } from '@datosbolivia/datamesh-client';
  import { getActiveProxyTemplate } from '../../lib/proxy';

  function initOjsCells() {
    // Sincronizar proxy activo global en la instancia datamesh
    const activeProxy = getActiveProxyTemplate();
    if (activeProxy) {
      datamesh.setProxy(activeProxy);
    }
    const cells = document.querySelectorAll<HTMLElement>('[data-ojs-cell="true"]');
    if (cells.length === 0) return;

    const explorerEl = document.getElementById('obsidian-explorer');
    let datasetContext: any = null;
    try {
      const resources = JSON.parse(explorerEl?.getAttribute('data-resources') || '[]');
      const slug = explorerEl?.getAttribute('data-dataset-slug') || '';
      datasetContext = { slug, resources };
    } catch (_) {}

    cells.forEach(async (cell) => {
      if (cell.dataset.initialized === 'true') return;
      cell.dataset.initialized = 'true';

      const rawB64 = cell.getAttribute('data-ojs-code');
      if (!rawB64) return;
      const outputEl = cell.querySelector<HTMLElement>('.ojs-output');
      const sourceEl = cell.querySelector<HTMLElement>('.ojs-source');
      const toggleBtn = cell.querySelector<HTMLButtonElement>('.ojs-toggle-code');

      toggleBtn?.addEventListener('click', () => {
        const isVisible = sourceEl?.style.display !== 'none';
        if (sourceEl) sourceEl.style.display = isVisible ? 'none' : 'block';
        toggleBtn.textContent = isVisible ? 'Ver Código OJS' : 'Ocultar Código OJS';
      });

      try {
        let code = '';
        try {
          code = decodeURIComponent(escape(atob(rawB64)));
        } catch (_) {
          code = atob(rawB64);
        }

        let runCode = code.trim();

        // Si no tiene return explícito, envolver la última expresión
        if (!/\breturn\b/.test(runCode)) {
          const lines = runCode.split('\n');
          const lastIdx = lines.findLastIndex((l) => l.trim() && !l.trim().startsWith('//'));
          if (lastIdx !== -1) {
            lines[lastIdx] = 'return ' + lines[lastIdx];
            runCode = lines.join('\n');
          }
        }

        const AsyncFunction = Object.getPrototypeOf(async function(){}).constructor;
        const runner = new AsyncFunction(
          'Plot',
          'datamesh',
          'DataMeshClient',
          'dataset',
          'normalizeResourceUrl',
          'parseCsv',
          'container',
          runCode
        );

        const scopedDatamesh = new Proxy(datamesh, {
          get(target, prop, receiver) {
            if (prop === 'query') {
              return (req: any, ctx?: any) => {
                const activeCtx = ctx || datasetContext;
                const resourceUri = req?.resource_uri;
                if (resourceUri && activeCtx?.resources && Array.isArray(activeCtx.resources)) {
                  const clean = String(resourceUri).trim().toLowerCase();
                  const targetResName = clean.includes(':') ? clean.split(':').pop()! : (clean.includes('/') ? clean.split('/').pop()! : clean);
                  const found = activeCtx.resources.find((r: any) => {
                    const rName = String(r.name || '').toLowerCase();
                    const rPath = String(r.path || '').toLowerCase();
                    return (
                      rName === clean ||
                      rName === targetResName ||
                      rPath === clean ||
                      rPath === targetResName ||
                      rPath.endsWith('/' + targetResName) ||
                      rPath.endsWith('\\' + targetResName)
                    );
                  });
                  if (found && found.path) {
                    return target.query({ ...req, resource_uri: found.path });
                  }
                }
                return (target as any).query(req, activeCtx);
              };
            }
            if (prop === 'resolveResource') {
              return (uriOrTriad: string, ctx?: any) => {
                const activeCtx = ctx || datasetContext;
                if (uriOrTriad && activeCtx?.resources && Array.isArray(activeCtx.resources)) {
                  const clean = String(uriOrTriad).trim().toLowerCase();
                  const targetResName = clean.includes(':') ? clean.split(':').pop()! : (clean.includes('/') ? clean.split('/').pop()! : clean);
                  const found = activeCtx.resources.find((r: any) => {
                    const rName = String(r.name || '').toLowerCase();
                    const rPath = String(r.path || '').toLowerCase();
                    return (
                      rName === clean ||
                      rName === targetResName ||
                      rPath === clean ||
                      rPath === targetResName ||
                      rPath.endsWith('/' + targetResName) ||
                      rPath.endsWith('\\' + targetResName)
                    );
                  });
                  if (found && found.path) {
                    return normalizeResourceUrl(found.path);
                  }
                }
                return (target as any).resolveResource(uriOrTriad, activeCtx);
              };
            }
            return Reflect.get(target, prop, receiver);
          }
        });

        const result = await runner(
          Plot,
          scopedDatamesh,
          DataMeshClient,
          datasetContext,
          normalizeResourceUrl,
          parseCsv,
          outputEl
        );

        if (outputEl) {
          outputEl.innerHTML = '';
          if (result instanceof HTMLElement || result instanceof SVGElement) {
            outputEl.appendChild(result);
          } else if (result !== undefined && result !== null) {
            const pre = document.createElement('pre');
            pre.className = 'code-pre';
            pre.textContent = typeof result === 'object' ? JSON.stringify(result, null, 2) : String(result);
            outputEl.appendChild(pre);
          }
        }
      } catch (err: any) {
        if (outputEl) {
          outputEl.innerHTML = `
            <div style="padding: 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface-hover); color: var(--color-text-muted); font-size: 0.8rem; font-family: var(--font-mono);">
              <div style="font-weight: 600; color: #dc2626; margin-bottom: 0.35rem;">Error en celda OJS:</div>
              <div>${err?.message || String(err)}</div>
            </div>
          `;
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initOjsCells);
  } else {
    initOjsCells();
  }

  // Si el usuario cambia la configuración global (proxy o mcp), re-ejecutar celdas OJS
  if (typeof window !== 'undefined') {
    window.addEventListener('datamesh:settings-changed', () => {
      const cells = document.querySelectorAll<HTMLElement>('[data-ojs-cell="true"]');
      cells.forEach((cell) => {
        delete cell.dataset.initialized;
      });
      initOjsCells();
    });
  }
</script>
