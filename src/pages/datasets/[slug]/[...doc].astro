---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DatasetExplorerView from '../../../components/DatasetExplorerView.astro';
import { getAllDatasets, getAllDatasetReferenceDocs, cleanResourceIdentifier } from '../../../lib/catalog';

export function getStaticPaths() {
  const allDocs = getAllDatasetReferenceDocs();
  const docPaths = allDocs.map((item) => ({
    params: {
      slug: item.datasetSlug,
      doc: item.subpath
    },
    props: {
      kind: 'doc' as const,
      doc: item.doc,
      dataset: item.dataset,
      activeTarget: `tab-doc-${item.doc.cleanPath.replace(/\//g, '-')}`
    }
  }));

  const allDatasets = getAllDatasets();
  const resourcePaths: any[] = [];
  for (const ds of allDatasets) {
    const resources = ds.allResources || [];
    resources.forEach((res, i) => {
      const cleanId = cleanResourceIdentifier(res.name);
      resourcePaths.push({
        params: {
          slug: ds.slug,
          doc: cleanId
        },
        props: {
          kind: 'resource' as const,
          dataset: ds,
          resource: res,
          resourceIndex: i,
          activeTarget: `tab-resource-${i}`
        }
      });
    });
  }

  return [...docPaths, ...resourcePaths];
}

const { kind, dataset, activeTarget } = Astro.props;
const resource = (Astro.props as any).resource;
const doc = (Astro.props as any).doc;

const pageTitle = kind === 'resource' 
  ? `${resource?.title || resource?.name || 'Recurso'} — ${dataset.title}` 
  : `${doc?.title || 'Documento'} — ${dataset.title}`;
---

<BaseLayout title={pageTitle} description={dataset.description} fullWidth={true} noFooter={true}>
  <DatasetExplorerView dataset={dataset} activeTarget={activeTarget} />
</BaseLayout>
