---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DatasetCard from '../../components/DatasetCard.astro';
import { getAllDatasets, getDatasetsByCategory } from '../../lib/catalog';

const datasets = getAllDatasets();
const categories = getDatasetsByCategory();
---

<BaseLayout title="Catálogo de Datasets">
  <div style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem;">
      <h1 style="margin: 0; font-size: 2rem;" data-i18n="datasets.title">Catálogo de Datasets</h1>
    </div>
    <p style="color: var(--color-text-muted); font-size: 0.95rem; margin: 0;" data-i18n="datasets.subtitle">
      Explora recursos, esquemas y conceptos federados.
    </p>
  </div>

  <!-- Buscador en tiempo real -->
  <div class="search-input-wrapper">
    <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    <input 
      type="text" 
      id="dataset-search" 
      class="search-box" 
      placeholder="Buscar por nombre, entidad, columna o dominio..." 
      aria-label="Buscar datasets"
      data-i18n="search.placeholder"
    />
  </div>

  <!-- Barra de Herramientas: Filtros Multiselección de Dominios a la izquierda, Modo de Vista a la derecha -->
  <div class="datasets-toolbar">
    <!-- Filtros de Dominio (Multiselección a la izquierda) -->
    <div class="datasets-filters-left">
      <span class="filters-domain-label" data-i18n="datasets.filter_by_domain">Dominios:</span>
      <div class="domain-filters" id="category-filters" role="group" aria-label="Filtro de dominios">
        <button 
          type="button" 
          class="filter-btn active" 
          data-category="all" 
          aria-pressed="true"
        >
          <span data-i18n="search.all">Todos</span>
        </button>
        {categories.map((cat) => (
          <button 
            type="button" 
            class="filter-btn" 
            data-category={cat.name} 
            aria-pressed="false"
          >
            <span>{cat.name}</span>
            <span class="filter-count">({cat.datasets.length})</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Selector de Modo de Visualización (a la derecha) -->
    <div class="datasets-view-right">
      <div class="view-toggle-group" role="group" aria-label="Modo de visualización">
        <button 
          type="button" 
          id="view-grid-btn" 
          class="view-toggle-btn active" 
          aria-pressed="true" 
          title="Vista en cuadrícula" 
          aria-label="Vista en cuadrícula"
          data-i18n-title="view.grid"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="7" height="7" x="3" y="3" rx="1"/>
            <rect width="7" height="7" x="14" y="3" rx="1"/>
            <rect width="7" height="7" x="14" y="14" rx="1"/>
            <rect width="7" height="7" x="3" y="14" rx="1"/>
          </svg>
        </button>
        <button 
          type="button" 
          id="view-list-btn" 
          class="view-toggle-btn" 
          aria-pressed="false" 
          title="Vista en lista" 
          aria-label="Vista en lista"
          data-i18n-title="view.list"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="8" x2="21" y1="6" y2="6"/>
            <line x1="8" x2="21" y1="12" y2="12"/>
            <line x1="8" x2="21" y1="18" y2="18"/>
            <line x1="3" x2="3.01" y1="6" y2="6"/>
            <line x1="3" x2="3.01" y1="12" y2="12"/>
            <line x1="3" x2="3.01" y1="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Contenedor de Datasets (Cuadrícula o Lista) -->
  <div class="dataset-container dataset-grid" id="dataset-container">
    {datasets.map((dataset) => (
      <div 
        class="dataset-item" 
        data-title={dataset.title.toLowerCase()}
        data-desc={dataset.description.toLowerCase()}
        data-category={dataset.category}
        data-slug={dataset.slug}
      >
        <DatasetCard dataset={dataset} />
      </div>
    ))}
  </div>

  <div id="no-results" style="display: none; text-align: center; padding: 3rem 0; color: var(--color-text-muted);">
    <p style="font-size: 1.1rem; margin-bottom: 0.5rem;" data-i18n="search.no_results">No se encontraron datasets para esta búsqueda.</p>
    <button id="reset-search" class="btn btn-secondary btn-sm" data-i18n="search.reset">Limpiar filtros</button>
  </div>
</BaseLayout>

<script is:inline>
  const searchInput = document.getElementById('dataset-search');
  const items = Array.from(document.querySelectorAll('.dataset-item'));
  const filterBtns = Array.from(document.querySelectorAll('.filter-btn'));
  const noResults = document.getElementById('no-results');
  const resetBtn = document.getElementById('reset-search');
  const datasetContainer = document.getElementById('dataset-container');
  const viewGridBtn = document.getElementById('view-grid-btn');
  const viewListBtn = document.getElementById('view-list-btn');

  // Estado de multi-selección de categorías
  const selectedCategories = new Set();
  const allBtn = filterBtns.find((b) => b.getAttribute('data-category') === 'all');

  function updateCategoryUI() {
    if (selectedCategories.size === 0) {
      filterBtns.forEach((b) => {
        const isAll = b.getAttribute('data-category') === 'all';
        b.classList.toggle('active', isAll);
        b.setAttribute('aria-pressed', isAll ? 'true' : 'false');
      });
    } else {
      filterBtns.forEach((b) => {
        const cat = b.getAttribute('data-category');
        const isActive = cat !== 'all' && selectedCategories.has(cat);
        b.classList.toggle('active', isActive);
        b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
      if (allBtn) {
        allBtn.classList.remove('active');
        allBtn.setAttribute('aria-pressed', 'false');
      }
    }
  }

  // Manejo de Modo de Visualización (Cuadrícula / Lista)
  function setViewMode(mode) {
    if (mode === 'list') {
      datasetContainer?.classList.add('view-list');
      datasetContainer?.classList.remove('dataset-grid');
      viewListBtn?.classList.add('active');
      viewListBtn?.setAttribute('aria-pressed', 'true');
      viewGridBtn?.classList.remove('active');
      viewGridBtn?.setAttribute('aria-pressed', 'false');
      localStorage.setItem('datamesh_dataset_view', 'list');
    } else {
      datasetContainer?.classList.remove('view-list');
      datasetContainer?.classList.add('dataset-grid');
      viewGridBtn?.classList.add('active');
      viewGridBtn?.setAttribute('aria-pressed', 'true');
      viewListBtn?.classList.remove('active');
      viewListBtn?.setAttribute('aria-pressed', 'false');
      localStorage.setItem('datamesh_dataset_view', 'grid');
    }
  }

  viewGridBtn?.addEventListener('click', () => setViewMode('grid'));
  viewListBtn?.addEventListener('click', () => setViewMode('list'));

  function filterDatasets() {
    const query = (searchInput?.value || '').toLowerCase().trim();
    let visibleCount = 0;

    items.forEach((item) => {
      const title = item.getAttribute('data-title') || '';
      const desc = item.getAttribute('data-desc') || '';
      const cat = item.getAttribute('data-category') || '';
      const slug = item.getAttribute('data-slug') || '';

      const matchesQuery = !query || 
        title.includes(query) || 
        desc.includes(query) || 
        slug.includes(query);

      const matchesCat = selectedCategories.size === 0 || selectedCategories.has(cat);

      if (matchesQuery && matchesCat) {
        item.style.display = '';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  searchInput?.addEventListener('input', filterDatasets);

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-category');
      if (!cat || cat === 'all') {
        selectedCategories.clear();
      } else {
        if (selectedCategories.has(cat)) {
          selectedCategories.delete(cat);
        } else {
          selectedCategories.add(cat);
        }
      }
      updateCategoryUI();
      filterDatasets();
    });
  });

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    selectedCategories.clear();
    updateCategoryUI();
    filterDatasets();
  });

  // Leer parámetros de URL y preferencias
  const urlParams = new URLSearchParams(window.location.search);
  const initialQuery = urlParams.get('q') || urlParams.get('search');
  const initialCats = urlParams.getAll('cat').flatMap((c) => c.split(',')).map((c) => c.trim()).filter(Boolean);
  const initialView = urlParams.get('view') || localStorage.getItem('datamesh_dataset_view') || 'grid';

  if (initialQuery && searchInput) {
    searchInput.value = initialQuery;
  }

  if (initialCats.length > 0) {
    initialCats.forEach((catName) => {
      const matchedBtn = filterBtns.find(
        (b) => (b.getAttribute('data-category') || '').toLowerCase() === catName.toLowerCase()
      );
      if (matchedBtn) {
        const cat = matchedBtn.getAttribute('data-category');
        if (cat && cat !== 'all') selectedCategories.add(cat);
      }
    });
    updateCategoryUI();
  }

  // Inicializar vista y filtrado
  setViewMode(initialView);
  filterDatasets();
</script>
