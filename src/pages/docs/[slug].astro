---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllDocs } from '../../lib/catalog';

export function getStaticPaths() {
  const docs = getAllDocs();
  return docs.map((d) => ({
    params: { slug: d.slug },
    props: { doc: d }
  }));
}

const { doc } = Astro.props;

import { renderMarkdown } from '../../lib/markdown';

const renderedHtml = renderMarkdown(doc.bodyMarkdown);

let rawFilePath = `docs/${doc.slug}.md`;
if (doc.category === 'decision') {
  rawFilePath = `docs/decisiones/${doc.slug.replace('decisiones-', '')}.md`;
} else if (doc.category === 'blog') {
  rawFilePath = `docs/blog/${doc.slug.replace('blog-', '')}.md`;
}
---

<BaseLayout title={doc.title}>
  <nav style="display: flex; gap: 0.5rem; align-items: center; font-size: 0.8rem; color: var(--color-text-muted); margin-bottom: 1.5rem;">
    <a href="/" style="color: inherit; text-decoration: none;" data-i18n="nav.home">Inicio</a>
    <span>/</span>
    <a href="/docs" style="color: inherit; text-decoration: none;" data-i18n="nav.docs">Docs</a>
    <span>/</span>
    <span style="color: var(--color-text);">{doc.title}</span>
  </nav>

  <div style="max-width: 800px; margin: 0 auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); padding-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
      <div style="display: flex; gap: 0.5rem; align-items: center; font-size: 0.8rem; font-family: var(--font-mono); color: var(--color-text-muted);">
        <span style="color: var(--color-primary); font-weight: 600; text-transform: uppercase;">{doc.category}</span>
        <span>•</span>
        <span>{doc.type}</span>
        {doc.status && (
          <>
            <span>•</span>
            <span style="color: var(--color-success);">{doc.status}</span>
          </>
        )}
      </div>

      <a href={`/raw/${rawFilePath}`} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" style="font-size: 0.75rem; display: inline-flex; align-items: center; gap: 0.35rem;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <span data-i18n="docs.view_raw">Ver Raw (.md)</span>
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </a>
    </div>

    <article class="prose" set:html={renderedHtml} />
  </div>
</BaseLayout>
