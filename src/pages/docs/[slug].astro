---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllDocs } from '../../lib/catalog';

export function getStaticPaths() {
  const docs = getAllDocs();
  return docs.map((d) => ({
    params: { slug: d.slug },
    props: { doc: d }
  }));
}

const { doc } = Astro.props;

function renderDocMarkdown(md: string): string {
  let html = md
    .replace(/^### (.*$)/gim, '<h3>$1</h3>')
    .replace(/^## (.*$)/gim, '<h2>$1</h2>')
    .replace(/^# (.*$)/gim, '<h1>$1</h1>')
    .replace(/^\> (.*$)/gim, '<blockquote>$1</blockquote>')
    .replace(/^\s*\-\s+(.*$)/gim, '<li>$1</li>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/gim, '<a href="$2">$1</a>')
    .replace(/\*\*([^*]+)\*\*/gim, '<strong>$1</strong>')
    .replace(/\*([^*]+)\*/gim, '<em>$1</em>')
    .replace(/`([^`]+)`/gim, '<code>$1</code>')
    .replace(/^\-\-\-$/gim, '<hr style="border: none; border-top: 1px solid var(--color-border); margin: 2rem 0;" />')
    .split('\n\n')
    .map(p => {
      const trimmed = p.trim();
      if (!trimmed) return '';
      if (trimmed.startsWith('<h') || trimmed.startsWith('<ul') || trimmed.startsWith('<li') || trimmed.startsWith('<hr') || trimmed.startsWith('<blockquote')) {
        return trimmed;
      }
      return `<p>${trimmed.replace(/\n/g, '<br />')}</p>`;
    })
    .join('\n');

  return html;
}

const renderedHtml = renderDocMarkdown(doc.bodyMarkdown);
---

<BaseLayout title={doc.title}>
  <nav style="display: flex; gap: 0.5rem; align-items: center; font-size: 0.825rem; color: var(--color-text-muted); margin-bottom: 1.5rem;">
    <a href="/" style="color: inherit; text-decoration: none;">Inicio</a>
    <span>/</span>
    <a href="/docs" style="color: inherit; text-decoration: none;">Documentación</a>
    <span>/</span>
    <span style="color: var(--color-text);">{doc.title}</span>
  </nav>

  <div style="max-width: 800px; margin: 0 auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); padding-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
      <div style="display: flex; gap: 0.5rem; align-items: center;">
        <span class="badge badge-info">{doc.category}</span>
        <span class="badge">{doc.type}</span>
        {doc.status && <span class="badge badge-success">{doc.status}</span>}
      </div>

      <a href={`/raw/${doc.category === 'decision' ? `docs/decisiones/${doc.slug.replace('decisiones-', '')}.md` : `docs/${doc.slug}.md`}`} target="_blank" class="btn btn-secondary btn-sm">
        Ver Markdown Raw &rarr;
      </a>
    </div>

    <article class="prose" set:html={renderedHtml} />
  </div>
</BaseLayout>
