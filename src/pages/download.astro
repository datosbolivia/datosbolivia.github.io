---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEditorialPage } from '../lib/catalog';
import { config } from '../../portal.config';
import { renderMarkdown } from '../lib/markdown';

const downloadPage = getEditorialPage('download');
const renderedHtml = renderMarkdown(downloadPage.body);
---

<BaseLayout title={downloadPage.title} description={downloadPage.description}>
  <div style="max-width: 860px; margin: 0 auto;">
    <div style="margin-bottom: 2rem; border-bottom: 1px solid var(--color-border); padding-bottom: 1rem;">
      <h1 style="font-size: 2rem; margin-bottom: 0.5rem;" data-i18n="download.title">Descargas e Instalación</h1>
      <p style="color: var(--color-text-muted); margin: 0;" data-i18n="download.subtitle">
        Accede al catálogo de forma offline y desbloquea procesamiento local con PWA y Desktop.
      </p>
    </div>

    <!-- Opciones en Tarjetas Destacadas sin badges -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem;">
      <!-- Tarjeta PWA -->
      <div class="card" style="border-top: 3px solid var(--color-primary);">
        <div style="margin-bottom: 0.5rem;">
          <div style="display: flex; align-items: center; gap: 0.4rem; color: var(--color-primary); font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
            <span data-i18n="download.browser">Navegador</span>
          </div>
          <h2 style="font-size: 1.25rem; margin: 0.35rem 0 0;" data-i18n="download.pwa_title">Progressive Web App (PWA)</h2>
        </div>
        <p style="font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: 1rem; flex: 1; line-height: 1.45;" data-i18n="download.pwa_desc">
          Instala la aplicación directamente en tu navegador móvil o de escritorio. Navega el catálogo completo sin conexión.
        </p>
        <button id="download-pwa-btn" class="btn btn-primary" style="justify-content: center; display: inline-flex; align-items: center; gap: 0.4rem;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span data-i18n="download.pwa_btn">Instalar PWA</span>
        </button>
      </div>

      <!-- Tarjeta Desktop Electron -->
      <div class="card" style="border-top: 3px solid var(--color-secondary);">
        <div style="margin-bottom: 0.5rem;">
          <div style="display: flex; align-items: center; gap: 0.4rem; color: var(--color-primary); font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
            <span data-i18n="download.desktop_native">Desktop Native</span>
          </div>
          <h2 style="font-size: 1.25rem; margin: 0.35rem 0 0;" data-i18n="download.desktop_title">Aplicación Desktop (Electron)</h2>
        </div>
        <p style="font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: 1rem; flex: 1; line-height: 1.45;" data-i18n="download.desktop_desc">
          Aplicación de escritorio con ranura para el binario compilado en Go del SDK, consultas analíticas y validación de nodos en vivo.
        </p>
        <a href={config.desktopApp.downloadUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary" style="justify-content: center; display: inline-flex; align-items: center; gap: 0.4rem;">
          <span data-i18n="download.desktop_btn">Ver Releases</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      </div>

      <!-- Tarjeta Python SDK -->
      <div class="card" style="border-top: 3px solid var(--color-success, #059669);">
        <div style="margin-bottom: 0.5rem;">
          <div style="display: flex; align-items: center; gap: 0.4rem; color: var(--color-success, #059669); font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            <span>Python &amp; DuckDB</span>
          </div>
          <h2 style="font-size: 1.25rem; margin: 0.35rem 0 0;">SDK DataMesh Python</h2>
        </div>
        <p style="font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: 1rem; flex: 1; line-height: 1.45;">
          Consultas SQL en 1 línea sobre DuckDB, federación de catálogos y conversión directa a DataFrames de Pandas o Polars.
        </p>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
          <a href="/docs/guia-sdk-datamesh" class="btn btn-secondary btn-sm" style="flex: 1; justify-content: center; display: inline-flex; align-items: center; gap: 0.35rem;">
            <span>Guía y Ejemplos</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Tarjeta TypeScript SDK & CLI -->
      <div class="card" style="border-top: 3px solid #d97706;">
        <div style="margin-bottom: 0.5rem;">
          <div style="display: flex; align-items: center; gap: 0.4rem; color: #d97706; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><polyline points="8 12 12 16 16 12"/></svg>
            <span>TypeScript &amp; CLI</span>
          </div>
          <h2 style="font-size: 1.25rem; margin: 0.35rem 0 0;">Cliente TS / CLI Go</h2>
        </div>
        <p style="font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: 1rem; flex: 1; line-height: 1.45;">
          Paquete NPM <code>@datosbolivia/datamesh-client</code> y binario CLI en Go para terminal y servidores MCP para agentes IA.
        </p>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
          <a href="/docs/guia-sdk-datamesh" class="btn btn-secondary btn-sm" style="flex: 1; justify-content: center; display: inline-flex; align-items: center; gap: 0.35rem;">
            <span>Documentación SDK</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Estado del Runtime Desktop si está dentro de Electron -->
    <div id="desktop-engine-status" class="card" style="display: none; margin-bottom: 2.5rem; background-color: var(--color-surface); border: 1px solid var(--color-primary);">
      <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--color-primary);" data-i18n="download.engine_active">
        Entorno Desktop Activo
      </h3>
      <p style="font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: 0.5rem;">
        <span data-i18n="download.engine_type">Motor de Cómputo:</span> <strong id="engine-type" data-i18n="download.detecting">Detectando...</strong>
      </p>
      <div id="engine-capabilities" style="display: flex; gap: 0.5rem; flex-wrap: wrap; font-family: var(--font-mono); font-size: 0.75rem;"></div>
    </div>

    <!-- Contenido Detallado en Markdown -->
    <article class="prose" set:html={renderedHtml} />
  </div>
</BaseLayout>

<script is:inline>
  // Detección de entorno Electron
  if (window.datameshDesktop) {
    const banner = document.getElementById('desktop-engine-status');
    const typeLabel = document.getElementById('engine-type');
    const capContainer = document.getElementById('engine-capabilities');

    if (banner) banner.style.display = 'block';

    window.datameshDesktop.getEngineStatus().then((status) => {
      if (typeLabel) typeLabel.textContent = `${status.activeEngine} (${status.status})`;
      if (capContainer && status.capabilities) {
        capContainer.innerHTML = status.capabilities
          .map((c) => `<span style="padding: 0.2rem 0.4rem; background: var(--color-surface-hover); border: 1px solid var(--color-border); border-radius: var(--radius-sm);">${c}</span>`)
          .join('');
      }
    });
  }

  // Trigger para PWA Install
  const pwaBtn = document.getElementById('download-pwa-btn');
  pwaBtn?.addEventListener('click', () => {
    const installBtn = document.getElementById('pwa-install-btn');
    if (installBtn) {
      installBtn.click();
    } else {
      alert('Para instalar la PWA, utiliza el menú de tu navegador: "Instalar aplicación" o "Agregar a la pantalla de inicio".');
    }
  });
</script>
