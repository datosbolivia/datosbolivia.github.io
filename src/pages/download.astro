---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEditorialPage } from '../lib/catalog';
import { config } from '../../portal.config';

const downloadPage = getEditorialPage('download');

function renderMarkdown(md: string): string {
  let html = md
    .replace(/^### (.*$)/gim, '<h3>$1</h3>')
    .replace(/^## (.*$)/gim, '<h2>$1</h2>')
    .replace(/^# (.*$)/gim, '<h1>$1</h1>')
    .replace(/^\> (.*$)/gim, '<blockquote>$1</blockquote>')
    .replace(/^\s*\-\s+(.*$)/gim, '<li>$1</li>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/gim, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>')
    .replace(/\*\*([^*]+)\*\*/gim, '<strong>$1</strong>')
    .replace(/\*([^*]+)\*/gim, '<em>$1</em>')
    .replace(/`([^`]+)`/gim, '<code>$1</code>')
    .replace(/^\-\-\-$/gim, '<hr style="border: none; border-top: 1px solid var(--color-border); margin: 2rem 0;" />')
    .split('\n\n')
    .map(p => {
      const trimmed = p.trim();
      if (!trimmed) return '';
      if (trimmed.startsWith('<h') || trimmed.startsWith('<ul') || trimmed.startsWith('<li') || trimmed.startsWith('<hr') || trimmed.startsWith('<blockquote') || trimmed.startsWith('<pre')) {
        return trimmed;
      }
      return `<p>${trimmed.replace(/\n/g, '<br />')}</p>`;
    })
    .join('\n');

  return html;
}

const renderedHtml = renderMarkdown(downloadPage.body);
---

<BaseLayout title={downloadPage.title} description={downloadPage.description}>
  <div style="max-width: 860px; margin: 0 auto;">
    <div style="margin-bottom: 2rem; border-bottom: 1px solid var(--color-border); padding-bottom: 1rem;">
      <h1 style="font-size: 2rem; margin-bottom: 0.5rem;">Descargas e Instalación</h1>
      <p style="color: var(--color-text-muted); margin: 0;">
        Accede al catálogo de forma offline y desbloquea procesamiento local con PWA y Desktop.
      </p>
    </div>

    <!-- Opciones en Tarjetas Destacadas -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem;">
      <!-- Tarjeta PWA -->
      <div class="card" style="border-top: 4px solid var(--color-primary);">
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem;">
          <h2 style="font-size: 1.25rem; margin: 0;">PWA Web</h2>
          <span class="badge badge-success">Sin Instalación</span>
        </div>
        <p style="font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: 1rem; flex: 1;">
          Instala la aplicación directamente en tu navegador móvil o de escritorio. Navega el catálogo completo sin conexión.
        </p>
        <button id="download-pwa-btn" class="btn btn-primary" style="justify-content: center;">
          Instalar en este Dispositivo
        </button>
      </div>

      <!-- Tarjeta Desktop Electron -->
      <div class="card" style="border-top: 4px solid var(--color-secondary);">
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem;">
          <h2 style="font-size: 1.25rem; margin: 0;">Desktop App</h2>
          <span class="badge badge-info">Cómputo Local</span>
        </div>
        <p style="font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: 1rem; flex: 1;">
          Aplicación de escritorio con ranura para el binario compilado en Go del SDK, consultas analíticas y validación de nodos en vivo.
        </p>
        <a href={config.desktopApp.downloadUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary" style="justify-content: center;">
          Ver Releases en GitHub &rarr;
        </a>
      </div>
    </div>

    <!-- Estado del Runtime Desktop si está dentro de Electron -->
    <div id="desktop-engine-status" class="card" style="display: none; margin-bottom: 2.5rem; background-color: var(--color-surface); border: 1px solid var(--color-primary);">
      <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--color-primary);">
        Entorno Desktop Activo
      </h3>
      <p style="font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: 0.5rem;">
        Motor de Cómputo: <strong id="engine-type">Detectando...</strong>
      </p>
      <div id="engine-capabilities" style="display: flex; gap: 0.35rem; flex-wrap: wrap;"></div>
    </div>

    <!-- Contenido Detallado en Markdown -->
    <article class="prose" set:html={renderedHtml} />
  </div>
</BaseLayout>

<script is:inline>
  // Detección de entorno Electron
  if (window.datameshDesktop) {
    const banner = document.getElementById('desktop-engine-status');
    const typeLabel = document.getElementById('engine-type');
    const capContainer = document.getElementById('engine-capabilities');

    if (banner) banner.style.display = 'block';

    window.datameshDesktop.getEngineStatus().then((status) => {
      if (typeLabel) typeLabel.textContent = `${status.activeEngine} (${status.status})`;
      if (capContainer && status.capabilities) {
        capContainer.innerHTML = status.capabilities
          .map((c) => `<span class="badge badge-info" style="font-size: 0.7rem;">${c}</span>`)
          .join('');
      }
    });
  }

  // Trigger para PWA Install
  const pwaBtn = document.getElementById('download-pwa-btn');
  pwaBtn?.addEventListener('click', () => {
    const installBtn = document.getElementById('pwa-install-btn');
    if (installBtn) {
      installBtn.click();
    } else {
      alert('Para instalar la PWA, utiliza el menú de tu navegador: "Instalar aplicación" o "Agregar a la pantalla de inicio".');
    }
  });
</script>
