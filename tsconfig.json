{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@datosbolivia/datamesh-client": [
        "../datamesh-sdk/bindings/typescript/src/index.ts",
        "node_modules/@datosbolivia/datamesh-client/bindings/typescript/dist/index.d.ts"
      ]
    }
  },
  "include": ["src/**/*", "portal.config.ts", "scripts/**/*"]
}
